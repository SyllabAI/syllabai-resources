{"pdf_page": 79, "item_index": 12, "bbox": [66.0, 349.0, 149.8, 338.8], "text": "wA + xB ⇌ yC + zD"}
{"pdf_page": 79, "item_index": 14, "bbox": [67.5, 318.7, 121.1, 291.9], "text": "Qc = [C]ʸ[D]ᶻ / [A]ʷ[B]ˣ"}
{"pdf_page": 79, "item_index": 19, "bbox": [82.3, 215.0, 163.8, 203.1], "text": "H₂(g) + I₂(g) ⇌ 2HI(g)"}
{"pdf_page": 79, "item_index": 21, "bbox": [84.2, 177.5, 233.7, 144.4], "text": "Kc = [HI(g)]²_eq / [H₂(g)]_eq[I₂(g)]_eq"}
{"pdf_page": 80, "item_index": 4, "bbox": [196.4, 641.6, 295.0, 629.8], "text": "N₂(g) + 3H₂(g) ⇌ 2NH₃(g)"}
{"pdf_page": 80, "item_index": 8, "bbox": [217.7, 574.2, 246.1, 562.0], "text": ""}
{"pdf_page": 80, "item_index": 9, "bbox": [197.2, 565.1, 262.8, 532.0], "text": "Qc = [NH₃]² / [N₂][H₂]³"}
{"pdf_page": 80, "item_index": 10, "bbox": [214.6, 530.4, 270.9, 517.0], "text": "= (n_NH₃/V)² / (n_N₂/V)(n_H₂/V)³"}
{"pdf_page": 80, "item_index": 13, "bbox": [171.9, 479.6, 329.1, 439.7], "text": "Kc = [(0.204)²/1²] / [(0.510)/1 × (0.197)³/1³] = 10.7"}
{"pdf_page": 80, "item_index": 18, "bbox": [214.2, 341.2, 265.1, 329.3], "text": "n₁/V₁ = n₂/V₂"}
{"pdf_page": 80, "item_index": 22, "bbox": [199.9, 278.5, 373.8, 252.8], "text": "Qc = [(0.204)²/(1.154)²] / [(0.650)/1.154 × (0.197)³/(1.154)³] = 11.15"}
{"pdf_page": 80, "item_index": 24, "bbox": [198.7, 231.9, 316.3, 218.5], "text": "11.15 > 10.7, therefore Qc > Kc."}
