  },
  {
   "type": "callout",
   "variant": "exam-tip",
   "label": "Exam Hint",
   "md": "- Most calculators used at A-Level can work with complex numbers and you can use these to check your working.\n- You should still show your full working though to ensure you get all marks though."
  }
 ]
