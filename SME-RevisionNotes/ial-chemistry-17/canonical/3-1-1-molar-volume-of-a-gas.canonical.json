    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Molar gas volume $=\\frac{\\mathrm{volume}}{\\mathrm{moles}}=\\frac{0.079}{0.0033}=$23.93 dm<sup>3</sup>",
