    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "$\\frac{79.0\\mathrm{cm}^{3}}{1000}$= 0.079 dm<sup>3</sup>",
    "reading_order" : 34,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
