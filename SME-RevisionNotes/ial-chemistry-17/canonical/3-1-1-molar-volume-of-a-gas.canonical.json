    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Calculate the molar volume of gas produced:",
    "reading_order" : 35,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
