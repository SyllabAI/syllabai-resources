  }, {
    "element_id" : "e000022",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**Answer**",
    "reading_order" : 22,
    "confidence" : 1.0,
    "role" : "paragraph",
