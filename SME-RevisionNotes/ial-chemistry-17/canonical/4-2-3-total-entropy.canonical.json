    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "",
    "reading_order" : 23,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000024",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Δ*S* <sup>Θ</sup><sub>total</sub> = Δ*S*<sub> </sub><sup>Θ</sup><sub>sys</sub> + Δ*S* <sup>Θ</sup><sub>surr</sub>",
    "reading_order" : 24,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000025",
