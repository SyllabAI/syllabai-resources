    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000026",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Δ*S*<sup>Θ</sup> <sub>total</sub> = -90.1 + 1379 = **1289 J K**<sup>**-1 **</sup>**mol**<sup>**-1**</sup>",
    "reading_order" : 26,
