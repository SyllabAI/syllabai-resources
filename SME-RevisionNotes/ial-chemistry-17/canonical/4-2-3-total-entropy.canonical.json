    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**Spec point** — `spcpt_DfqdzwnBzGqcHzvQ`",
    "reading_order" : 2,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000003",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Total Entropy Calculations",
    "reading_order" : 3,
    "confidence" : 1.0,
