  }, {
    "element_id" : "e000016",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "- Calculate the total entropy change in the formation of 1 mole of sodium chloride from its elements in their standard state",
    "reading_order" : 16,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
