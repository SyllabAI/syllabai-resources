    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Δ*S*<sup>Θ</sup><sub>surr </sub>= +1379 J K<sup>-1 </sup>mol<sup>-1</sup>",
