    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The Mn<sup>2+ </sup>ion contains Mn with oxidation state +2",
    "reading_order" : 41,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
