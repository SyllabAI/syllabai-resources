  }, {
    "element_id" : "e000052",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The hydrogen ion concentration of a buffer solution of a weak acid and its conjugate base is calculated using the formula:",
    "reading_order" : 52,
