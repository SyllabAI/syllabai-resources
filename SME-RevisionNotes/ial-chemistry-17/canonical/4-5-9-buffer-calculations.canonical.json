  }, {
    "element_id" : "e000054",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "We will use ethanoic acid as our weak acid of choice, with a *K*<sub>a</sub> value of 1.74 x 10<sup>-5</sup> mol dm<sup>-3</sup>",
    "reading_order" : 54,
    "confidence" : 1.0,
