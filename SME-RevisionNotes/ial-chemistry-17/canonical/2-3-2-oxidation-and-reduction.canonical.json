  }, {
    "element_id" : "e000006",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**2NH**<sub>**3**</sub>** + 3Br**<sub>**2**</sub>** → N**<sub>**2**</sub>** + 6HBr**",
    "reading_order" : 6,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000007",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The oxidation number of N in NH<sub>3</sub> has changed from -3 to 0",
    "reading_order" : 7,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000008",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "As the oxidation number has increased, nitrogen has been oxidised",
    "reading_order" : 8,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
