  }, {
    "element_id" : "e000009",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The oxidation number of Br has changed from 0 to -1",
    "reading_order" : 9,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000010",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "As the oxidation number has decreased, bromine has been reduced",
    "reading_order" : 10,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000011",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Overall, nitrogen has reduced bromine by donating electrons",
