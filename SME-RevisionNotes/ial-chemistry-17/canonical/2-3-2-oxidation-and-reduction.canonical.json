  }, {
    "element_id" : "e000017",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "An oxidising agent itself gets **reduced – gains electrons**",
    "reading_order" : 17,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000018",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Therefore, the **ox. no. **of the oxidising agent **decreases**",
    "reading_order" : 18,
    "confidence" : 1.0,
