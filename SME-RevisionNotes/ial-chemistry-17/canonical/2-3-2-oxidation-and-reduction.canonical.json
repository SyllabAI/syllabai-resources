    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**An oxidising agent** is a substance that **oxidises** another atom or ion by causing it to lose electrons",
    "reading_order" : 16,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
