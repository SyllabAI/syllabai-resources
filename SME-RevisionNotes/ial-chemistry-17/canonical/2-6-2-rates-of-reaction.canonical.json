    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "When drawing the tangent to a curve make the triangle large and try to intersect with gridlines if you can. This minimises errors of precision and reduces the chance you will accidently misread the graph values",
    "reading_order" : 34,
    "confidence" : 1.0,
