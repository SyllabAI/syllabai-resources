    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000032",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "It is important to specify the physical states of each species in an equation when dealing with enthalpy changes as any changes in state can cause very large changes of enthalpy. For example:",
    "reading_order" : 32,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
