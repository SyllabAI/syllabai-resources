  }, {
    "element_id" : "e000056",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Endothermic reaction profiles",
    "reading_order" : 56,
    "confidence" : 1.0,
    "role" : "heading",
    "heading_level" : 4,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000057",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "In an endothermic reaction, the reactants are lower in energy than the products",
    "reading_order" : 57,
