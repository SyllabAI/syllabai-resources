  }, {
    "element_id" : "e000060",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "As the number of protons in the nucleus of the ion increases, the electrons get pulled in more closely to the nucleus",
    "reading_order" : 60,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
