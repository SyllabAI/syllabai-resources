  }, {
    "element_id" : "e000009",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "*Melting points of the period 3 elements*",
    "reading_order" : 9,
    "confidence" : 1.0,
    "role" : "paragraph",
