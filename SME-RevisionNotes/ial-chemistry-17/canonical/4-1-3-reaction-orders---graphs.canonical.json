  }, {
    "element_id" : "e000055",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The rate of the reaction increases more as the concentration of the reactant increases",
    "reading_order" : 55,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000056",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "This means that the rate of the reaction decreases more as the concentration of the reactant decreases when it gets used up during the reaction",
    "reading_order" : 56,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
