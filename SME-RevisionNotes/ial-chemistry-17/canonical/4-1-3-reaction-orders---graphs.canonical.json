  }, {
    "element_id" : "e000054",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "In a **second-order** reaction, the rate is directly proportional to the square of concentration of a reactant",
    "reading_order" : 54,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
