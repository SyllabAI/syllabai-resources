    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Some distillate may be given off below this temperature - this needs to be discarded and a clean vessel used to collect the desired product",
    "reading_order" : 43,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000044",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Stop collecting the distillate if the temperature rises above +/- 2<sup>o</sup>C of the boiling point of the desired product",
    "reading_order" : 44,
