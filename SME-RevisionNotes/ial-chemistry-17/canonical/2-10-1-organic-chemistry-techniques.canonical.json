  }, {
    "element_id" : "e000054",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Boiling point is determined by **distillation**",
    "reading_order" : 54,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000055",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The sample is gently heated until it boils and this temperature is recorded",
    "reading_order" : 55,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000056",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "This boiling point can then be compared against literature / database values",
    "reading_order" : 56,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000057",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "If the sample contains impurities:",
    "reading_order" : 57,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000058",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The boiling point may appear higher than the literature / database values",
    "reading_order" : 58,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000059",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The sample may boil over a range of temperatures instead of at a single temperature",
