  }, {
    "element_id" : "e000053",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The boiling point of a liquid is indicative of its purity and identity",
    "reading_order" : 53,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
