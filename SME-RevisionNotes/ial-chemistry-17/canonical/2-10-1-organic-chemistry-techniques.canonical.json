    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000045",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The **aldehyde** product has a lower boiling point than the **alcohol** (since it has lost the **H-bonding**) so it can be **distilled off **as soon as it forms",
    "reading_order" : 45,
    "confidence" : 1.0,
