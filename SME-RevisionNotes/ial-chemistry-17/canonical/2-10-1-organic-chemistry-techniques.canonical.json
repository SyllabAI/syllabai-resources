  }, {
    "element_id" : "e000063",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "There are different methods to purify organic compounds, including:",
    "reading_order" : 63,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
