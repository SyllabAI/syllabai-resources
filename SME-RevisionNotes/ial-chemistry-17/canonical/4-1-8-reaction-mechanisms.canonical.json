    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000052",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The second step in this reaction mechanism is the **rate-determining step**",
    "reading_order" : 52,
