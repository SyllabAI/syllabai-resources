    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000012",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "It is important that the elementary steps for a proposed mechanism agree with the overall stoichiometric equation",
