    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000051",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**   N**<sub>**2**</sub>**O (g) + H**<sub>**2**</sub>** (g) → N**<sub>**2**</sub>** (g) + H**<sub>**2**</sub>**O (l)           fast**",
    "reading_order" : 51,
