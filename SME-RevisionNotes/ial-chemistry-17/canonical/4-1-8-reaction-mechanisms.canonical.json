    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "For example, the reaction of nitrogen oxide (NO) with hydrogen (H<sub>2</sub>) to form nitrogen (N<sub>2</sub>) and water",
