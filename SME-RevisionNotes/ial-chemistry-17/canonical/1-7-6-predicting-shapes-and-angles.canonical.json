    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Beryllium is in group 2, so has 2 valence electrons; Cl is in group 17, so has 7 valence electrons",
    "reading_order" : 17,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
