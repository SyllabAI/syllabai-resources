    "text" : "Both electrons are used to form covalent bonds with Cl and there are no lone pairs",
    "reading_order" : 18,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
