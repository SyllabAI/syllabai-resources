  }, {
    "element_id" : "e000005",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "A homologous series is a group of organic compounds that have the same functional group, but each successive member differs by CH<sub>2</sub>",
    "reading_order" : 5,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000007",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "***Ethanol and propanol belong to the same homologous series***",
    "reading_order" : 7,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
