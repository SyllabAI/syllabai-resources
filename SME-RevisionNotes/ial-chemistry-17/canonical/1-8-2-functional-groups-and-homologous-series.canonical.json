  }, {
    "element_id" : "e000010",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Things we can say about a** homologous series:**",
    "reading_order" : 10,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
