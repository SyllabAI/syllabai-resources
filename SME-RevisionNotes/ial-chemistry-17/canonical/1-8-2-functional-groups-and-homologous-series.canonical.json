    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Each member has the same **functional group**",
    "reading_order" : 11,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
