  }, {
    "element_id" : "e000003",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Carboxylic Acids - Physical Properties",
    "reading_order" : 3,
    "confidence" : 1.0,
    "role" : "heading",
