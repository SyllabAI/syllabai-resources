  }, {
    "element_id" : "e000005",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The halogens react with some metals to form** ionic compounds** which are **metal halide** **salts**",
    "reading_order" : 5,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000006",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "In all reactions where halogens are reacting with metals, the metals are being oxidised",
    "reading_order" : 6,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000007",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Reaction of sodium and chlorine",
    "reading_order" : 7,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000008",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "2Na (s) + Cl<sub>2</sub> (g) → 2NaCl (s)",
    "reading_order" : 8,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
