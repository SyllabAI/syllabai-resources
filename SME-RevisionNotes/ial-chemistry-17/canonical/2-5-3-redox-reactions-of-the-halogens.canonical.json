    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Cl<sub>2</sub> (g) + 2Fe<sup>2+</sup> (aq) → 2Cl<sup>-</sup> (aq) + 2Fe<sup>3+</sup> (aq)",
