    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000019",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The **thermal stability **of the hydrogen halides decreases down the group",
    "reading_order" : 19,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
