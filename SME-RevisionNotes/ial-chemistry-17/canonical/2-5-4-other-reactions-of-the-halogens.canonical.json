    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "HI is such a strong reducing agent that it can reduce sulfur dioxide, SO<sub>2</sub>, further to hydrogen sulfide, H<sub>2</sub>S",
