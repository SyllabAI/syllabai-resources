    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000042",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Sulfur is reduced from +4 in SO₂ to –2 in H<sub>2</sub>S, a gain of 6 electrons:",
    "reading_order" : 42,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
