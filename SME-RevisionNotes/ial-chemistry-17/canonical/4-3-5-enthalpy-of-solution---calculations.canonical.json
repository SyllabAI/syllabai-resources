    "text" : "**Spec point** — `spcpt_P7QgKWY9rvNMY454`",
    "reading_order" : 2,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
