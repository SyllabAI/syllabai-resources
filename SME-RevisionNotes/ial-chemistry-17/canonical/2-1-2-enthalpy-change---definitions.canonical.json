  }, {
    "element_id" : "e000005",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "These standard conditions are:",
    "reading_order" : 5,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
