    "element_id" : "e000006",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "A **pressure** of 100 kPa (you may see some older exam questions that use a figure of 101 kPa; the exact figure is 101 325 Pa, but it has been simplified in the current syllabus for problem-solving purposes)",
    "reading_order" : 6,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
