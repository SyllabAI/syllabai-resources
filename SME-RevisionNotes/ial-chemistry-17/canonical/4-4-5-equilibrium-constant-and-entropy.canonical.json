    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000038",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "N<sub>2</sub>O<sub>4</sub> (g) ⇌ 2NO<sub>2</sub> (g)",
