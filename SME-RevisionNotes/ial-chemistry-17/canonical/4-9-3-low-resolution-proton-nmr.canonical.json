  }, {
    "element_id" : "e000013",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Produces one strong, sharp absorption peak on the spectrum.",
    "reading_order" : 13,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000014",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Sample peaks are then plotted as a ‘shift’ away from this reference peak",
    "reading_order" : 14,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
