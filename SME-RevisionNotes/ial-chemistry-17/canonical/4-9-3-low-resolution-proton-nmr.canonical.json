  }, {
    "element_id" : "e000027",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "<sup>1</sup>H nuclei that have different neighboring atoms (said to have different **chemical environments**) absorb at slightly different field strengths",
