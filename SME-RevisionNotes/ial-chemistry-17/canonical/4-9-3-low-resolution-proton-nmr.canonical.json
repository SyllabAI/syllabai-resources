    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**Nuclear Magnetic Resonance (NMR)** spectroscopy is used for analysing organic compounds",
    "reading_order" : 4,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000005",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "All samples are measured against a reference compound – **Tetramethylsilane (TMS)**",
    "reading_order" : 5,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000007",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "***Tetramethylsilane is the common reference compound for NMR spectroscopy***",
    "reading_order" : 7,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000008",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "TMS shows a single sharp peak on NMR spectra, at a value of zero",
    "reading_order" : 8,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000009",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "TMS is also used because it is:",
    "reading_order" : 9,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000010",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Non toxic.",
    "reading_order" : 10,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000011",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Does not react with the sample.",
    "reading_order" : 11,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000012",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Easily separated from the sample molecule due to its low boiling point.",
    "reading_order" : 12,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
