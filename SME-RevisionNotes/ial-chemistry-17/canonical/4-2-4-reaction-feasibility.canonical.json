    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Methane (CH<sub>4</sub>) will not spontaneously form CO<sub>2</sub> and H<sub>2</sub>O unless ignited (*E*ₐ is high)",
    "reading_order" : 103,
    "confidence" : 1.0,
    "role" : "list_item",
