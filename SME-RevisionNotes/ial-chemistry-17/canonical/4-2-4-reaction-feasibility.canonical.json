    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Thermodynamically feasible but** **kinetically stable",
    "reading_order" : 102,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
