    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000054",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "However, when magnesium is **heated** **in steam**, it reacts **vigorously **with steam to make magnesium oxide and hydrogen gas:",
    "reading_order" : 54,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
