    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000051",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Magnesium reacts **extremely slowly **with cold water:",
    "reading_order" : 51,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000052",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**Mg (s) + 2H**<sub>**2**</sub>**O (l) → Mg(OH)**<sub>**2 **</sub>**(aq) + H**<sub>**2 **</sub>**(g)**",
    "reading_order" : 52,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000053",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The solution formed is **weakly** **alkaline** (pH 9-10) as **magnesium hydroxide **is only **slightly soluble**",
    "reading_order" : 53,
