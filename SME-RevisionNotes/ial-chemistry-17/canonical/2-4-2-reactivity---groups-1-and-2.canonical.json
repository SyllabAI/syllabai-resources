    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Group 2 Metals Reacting with Water and Oxygen - Equations",
    "reading_order" : 49,
    "confidence" : 1.0,
    "role" : "heading",
