    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "For a reaction that is exothermic in the forward direction, increasing the temperature pushes the equilibrium from right to left",
    "reading_order" : 8,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
