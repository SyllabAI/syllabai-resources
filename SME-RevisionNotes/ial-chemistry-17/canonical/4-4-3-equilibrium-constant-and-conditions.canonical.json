    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Therefore, the value of *K*<sub>*c *</sub>will decrease as the ratio of [ products ] to [ reactants ] decreases",
    "reading_order" : 9,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
