  }, {
    "element_id" : "e000019",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Calculate the initial rate of reaction for the reaction of calcium carbonate with 2.0 mol dm<sup>-3</sup> hydrochloric acid",
    "reading_order" : 19,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000020",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
