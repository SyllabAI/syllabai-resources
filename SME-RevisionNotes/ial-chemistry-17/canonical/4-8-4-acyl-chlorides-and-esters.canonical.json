  }, {
    "element_id" : "e000048",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "What happens to the HCl?",
    "reading_order" : 48,
    "confidence" : 1.0,
    "role" : "heading",
    "heading_level" : 4,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000049",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The **HCl formed** does not remain unreacted.",
    "reading_order" : 49,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000050",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "It is **immediately neutralised** by a **second molecule** of ammonia or amine present in excess.",
    "reading_order" : 50,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
