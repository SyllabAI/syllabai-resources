    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000019",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "**Na**<sup>**+**</sup>**(g) + Cl**<sup>**-**</sup>**(g) → NaCl (s)  Δ**<sub>***latt***</sub>***H***<sup>**ꝋ **</sup>**= -776 kJ mol**<sup>** -1**</sup>",
    "reading_order" : 19,
