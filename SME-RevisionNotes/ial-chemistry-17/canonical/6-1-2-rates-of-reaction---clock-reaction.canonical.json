    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "The time of reaction is converted to rate of reaction by calculating the reciprocal value",
    "reading_order" : 34,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
