    "text" : "**Spec point** — `spcpt_6ssW6rHywj4BzCrP`",
    "reading_order" : 2,
    "confidence" : 1.0,
    "role" : "paragraph",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
