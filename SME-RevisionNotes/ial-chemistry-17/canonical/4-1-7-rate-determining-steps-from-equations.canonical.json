    "role" : "list_item",
    "heading_level" : null,
    "source_engine" : "sme-revision-note",
    "source_engine_version" : "1.0.0"
  }, {
    "element_id" : "e000031",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "For example, propane (CH<sub>3</sub>CH<sub>2</sub>CH<sub>3</sub>) undergoes bromination under alkaline solutions",
    "reading_order" : 31,
