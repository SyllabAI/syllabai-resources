  }, {
    "element_id" : "e000006",
    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "Other reactions take place simultaneously",
    "reading_order" : 6,
    "confidence" : 1.0,
    "role" : "list_item",
