    "element_type" : "text_block",
    "page_number" : 1,
    "bounding_box" : null,
    "text" : "In a lot of reactions, not all reactants react to form products which can be due to several factors:",
    "reading_order" : 5,
    "confidence" : 1.0,
    "role" : "list_item",
    "heading_level" : null,
