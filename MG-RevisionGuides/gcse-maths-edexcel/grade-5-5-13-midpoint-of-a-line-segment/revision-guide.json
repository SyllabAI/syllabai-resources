    {
     "id": "b3a96500-ccd1-4544-8599-c4ebbcb128b7",
     "prompt": "Find the midpoint of the line segment joining $(2,4)$ and $(8,10)$.",
     "options": [
      {
       "text": "$(3,3)$",
       "correct": false
      },
      {
       "text": "$(5,7)$",
       "correct": true
      },
      {
       "text": "$(6,6)$",
       "correct": false
      },
      {
       "text": "$(10,14)$",
       "correct": false
      }
     ],
     "explanation": "Average the $x$-coordinates and the $y$-coordinates: $\\left(\\frac{2+8}{2},\\frac{4+10}{2}\\right)=(5,7)$."
    },
    {
     "id": "ee70ee91-ec34-4011-b467-9b2853d3d141",
     "prompt": "What is the midpoint of the line segment joining $(-6,3)$ and $(4,11)$?",
     "options": [
      {
       "text": "$(-2,8)$",
       "correct": false
      },
      {
       "text": "$(1,7)$",
       "correct": false
      },
      {
       "text": "$(-5,4)$",
       "correct": false
      },
      {
       "text": "$(-1,7)$",
       "correct": true
      }
     ],
     "explanation": "The midpoint is $\\left(\\frac{-6+4}{2},\\frac{3+11}{2}\\right)=\\left(\\frac{-2}{2},\\frac{14}{2}\\right)=(-1,7)$."
    },
    {
     "id": "5d41db8e-7171-4233-8540-4c39bd66df6a",
     "prompt": "Find the midpoint of the line segment joining $(1.5,-2)$ and $(4.5,6)$.",
     "options": [
      {
       "text": "$(3,2)$",
       "correct": true
      },
      {
       "text": "$(3,4)$",
       "correct": false
      },
      {
       "text": "$(2,3)$",
       "correct": false
      },
      {
       "text": "$(6,4)$",
       "correct": false
      }
     ],
     "explanation": "Average each pair of coordinates: $\\frac{1.5+4.5}{2}=3$ and $\\frac{-2+6}{2}=2$, so the midpoint is $(3,2)$."
    },
    {
     "id": "570230b5-675a-4f07-b30a-f0f264bb0a21",
     "prompt": "One endpoint of a line segment is $(1,-3)$ and its midpoint is $(4,1)$. What is the other endpoint?",
     "options": [
      {
       "text": "$(2,-1)$",
       "correct": false
      },
      {
       "text": "$(5,4)$",
       "correct": false
      },
      {
       "text": "$(7,5)$",
       "correct": true
      },
      {
       "text": "$(8,2)$",
       "correct": false
      }
     ],
     "explanation": "From $(1,-3)$ to the midpoint $(4,1)$, the change is $(+3,+4)$. Make the same change again to get the other endpoint: $(4+3,1+4)=(7,5)$."
    },
    {
     "id": "0beef27c-4ea3-42c3-afd6-04b6fa6811bc",
     "prompt": "The midpoint of the line segment joining $(2,y)$ and $(8,12)$ is $(5,9)$. Find $y$.",
     "options": [
      {
       "text": "$3$",
       "correct": false
      },
      {
       "text": "$6$",
       "correct": true
      },
      {
       "text": "$7$",
       "correct": false
      },
      {
       "text": "$10$",
       "correct": false
      }
     ],
     "explanation": "The midpoint's $y$-coordinate is the average, so $\\frac{y+12}{2}=9$. Therefore $y+12=18$, giving $y=6$."
