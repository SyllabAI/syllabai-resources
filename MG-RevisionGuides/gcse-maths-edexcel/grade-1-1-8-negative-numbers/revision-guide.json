  {
   "kind": "worked-example",
   "title": "Example 3: \\-4 + -5",
   "steps": [
    {
     "heading": null,
     "body": "The first number is the starting point. We start at -4.  \nWe are adding so we are moving to the right.  \nWe move -5 spaces to the right (this means we move 5 spaces to the left)  \n**\\-4 + -5 = -9**",
     "figure_refs": []
    }
   ]
  },
  {
   "kind": "worked-example",
   "title": "Example 4: 2 - -5",
   "steps": [
    {
     "heading": null,
     "body": "The first number is the starting point. We start at 2.  \nWe are subtracting so we are moving to the left.  \nWe move -5 spaces to the left (this means we move 5 spaces to the right)  \n**2 - -5 = 7**",
     "figure_refs": []
    }
   ]
