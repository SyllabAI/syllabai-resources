    {
     "id": "fad8bfe5-f770-450b-a23f-d84a98a30a88",
     "prompt": "What is the exact value of $\\sin(60^\\circ)$?",
     "options": [
      {
       "text": "$\\frac{1}{2}$",
       "correct": false
      },
      {
       "text": "$\\sqrt{3}$",
       "correct": false
