    {
     "id": "c498c8a2-e93d-4206-8dbc-67e4295b08d3",
     "prompt": "A translation moves a point $7$ units to the right and $3$ units upwards. What is the column vector for this translation?",
     "options": [
      {
       "text": "$\\begin{pmatrix}-7\\\\3\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}7\\\\3\\end{pmatrix}$",
       "correct": true
      },
      {
       "text": "$\\begin{pmatrix}3\\\\7\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}7\\\\-3\\end{pmatrix}$",
       "correct": false
      }
     ],
     "explanation": "The top number gives the horizontal movement and the bottom number gives the vertical movement. Right and up are positive, so the vector is $\\begin{pmatrix}7\\\\3\\end{pmatrix}$."
    },
    {
     "id": "82a1b59c-b548-49e6-9516-828a10263b3d",
     "prompt": "Calculate $\\begin{pmatrix}3\\\\-2\\end{pmatrix}+\\begin{pmatrix}-5\\\\7\\end{pmatrix}$.",
     "options": [
      {
       "text": "$\\begin{pmatrix}8\\\\-9\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}-2\\\\-5\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}2\\\\5\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}-2\\\\5\\end{pmatrix}$",
       "correct": true
      }
     ],
     "explanation": "Add corresponding components: $3+(-5)=-2$ and $-2+7=5$. Therefore the answer is $\\begin{pmatrix}-2\\\\5\\end{pmatrix}$."
    },
    {
     "id": "f9c9887b-f5d9-4235-a9a8-d0e3a7d4e141",
     "prompt": "Given $\\mathbf{a}=\\begin{pmatrix}4\\\\1\\end{pmatrix}$ and $\\mathbf{b}=\\begin{pmatrix}-2\\\\3\\end{pmatrix}$, find $2\\mathbf{a}-\\mathbf{b}$.",
     "options": [
      {
       "text": "$\\begin{pmatrix}10\\\\-1\\end{pmatrix}$",
       "correct": true
      },
      {
       "text": "$\\begin{pmatrix}6\\\\5\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}6\\\\-1\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}10\\\\5\\end{pmatrix}$",
       "correct": false
      }
     ],
     "explanation": "First, $2\\mathbf{a}=\\begin{pmatrix}8\\\\2\\end{pmatrix}$. Then subtract $\\mathbf{b}$: $\\begin{pmatrix}8-(-2)\\\\2-3\\end{pmatrix}=\\begin{pmatrix}10\\\\-1\\end{pmatrix}$."
    },
    {
     "id": "bb719846-c1fc-4344-8626-d4d84a38021c",
     "prompt": "The points $A$ and $B$ have coordinates $A(2,-1)$ and $B(-3,5)$. Find the vector $\\overrightarrow{AB}$.",
     "options": [
      {
       "text": "$\\begin{pmatrix}5\\\\-6\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}-1\\\\4\\end{pmatrix}$",
       "correct": false
      },
      {
       "text": "$\\begin{pmatrix}-5\\\\6\\end{pmatrix}$",
       "correct": true
      },
      {
       "text": "$\\begin{pmatrix}-5\\\\4\\end{pmatrix}$",
       "correct": false
      }
     ],
     "explanation": "To find $\\overrightarrow{AB}$, subtract the coordinates of $A$ from those of $B$: $\\begin{pmatrix}-3-2\\\\5-(-1)\\end{pmatrix}=\\begin{pmatrix}-5\\\\6\\end{pmatrix}$."
    },
    {
     "id": "bee49e76-2c59-4ca0-b084-b5d3cfa2a8d4",
     "prompt": "Points $A$ and $B$ have position vectors $\\mathbf{a}$ and $\\mathbf{b}$. Point $P$ lies on $AB$ so that $AP:PB=2:1$. What is the position vector of $P$?",
     "options": [
      {
       "text": "$\\frac{2}{3}\\mathbf{a}+\\frac{1}{3}\\mathbf{b}$",
       "correct": false
      },
      {
       "text": "$2\\mathbf{a}+\\mathbf{b}$",
       "correct": false
      },
      {
       "text": "$\\frac{1}{2}\\mathbf{a}+\\frac{1}{2}\\mathbf{b}$",
       "correct": false
      },
      {
       "text": "$\\frac{1}{3}\\mathbf{a}+\\frac{2}{3}\\mathbf{b}$",
       "correct": true
      }
     ],
     "explanation": "Since $AP:PB=2:1$, point $P$ is two-thirds of the way from $A$ to $B$. Thus $\\overrightarrow{OP}=\\mathbf{a}+\\frac{2}{3}(\\mathbf{b}-\\mathbf{a})=\\frac{1}{3}\\mathbf{a}+\\frac{2}{3}\\mathbf{b}$."
    }
   ]
  }
