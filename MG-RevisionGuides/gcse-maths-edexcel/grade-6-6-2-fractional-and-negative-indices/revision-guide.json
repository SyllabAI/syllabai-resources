   "items": [
    {
     "id": "6f16ca43-e237-48b8-8c80-1fc6670f8262",
     "prompt": "Work out $125^{\\frac{1}{3}}$.",
     "options": [
      {
       "text": "15",
       "correct": false
      },
      {
       "text": "25",
       "correct": false
      },
      {
       "text": "5",
       "correct": true
      },
      {
       "text": "$\\frac{1}{5}$",
       "correct": false
      }
     ],
     "explanation": "The denominator 3 means take the cube root. Since $5^3=125$, $125^{\\frac{1}{3}}=5$."
    },
    {
     "id": "ce6555ed-00d7-431c-9302-ae0c327d5d4c",
     "prompt": "Work out $64^{\\frac{2}{3}}$.",
     "options": [
      {
       "text": "8",
       "correct": false
      },
      {
       "text": "16",
       "correct": true
      },
      {
       "text": "32",
       "correct": false
      },
      {
       "text": "$\\frac{1}{16}$",
       "correct": false
      }
     ],
     "explanation": "First take the cube root: $\\sqrt[3]{64}=4$. Then square the result: $4^2=16$."
    },
    {
     "id": "b5ba397a-9bbc-4961-97db-794d0e1ea0dd",
     "prompt": "Work out $8^{-1}$.",
     "options": [
      {
       "text": "$-\\frac{1}{8}$",
       "correct": false
      },
      {
       "text": "-8",
       "correct": false
      },
      {
       "text": "8",
       "correct": false
      },
      {
       "text": "$\\frac{1}{8}$",
       "correct": true
      }
     ],
     "explanation": "A negative index means take the reciprocal, not make the value negative. Therefore $8^{-1}=\\frac{1}{8}$."
    },
    {
     "id": "95af957c-9ef9-499f-9540-b6a1045dfc20",
     "prompt": "Work out $\\left(\\frac{8}{27}\\right)^{-\\frac{2}{3}}$.",
     "options": [
      {
       "text": "$\\frac{9}{4}$",
       "correct": true
      },
      {
       "text": "$\\frac{4}{9}$",
       "correct": false
      },
      {
       "text": "$-\\frac{9}{4}$",
       "correct": false
      },
      {
       "text": "$\\frac{3}{2}$",
       "correct": false
      }
     ],
     "explanation": "The cube root of $\\frac{8}{27}$ is $\\frac{2}{3}$, and squaring gives $\\frac{4}{9}$. The negative index then gives the reciprocal, $\\frac{9}{4}$."
    },
    {
     "id": "bc140190-b63d-40aa-8138-48df29f7db49",
     "prompt": "Given that $3\\sqrt{27}=3^n$, find $n$.",
     "options": [
      {
       "text": "$\\frac{3}{2}$",
       "correct": false
      },
      {
       "text": "5",
       "correct": false
      },
      {
       "text": "$\\frac{5}{2}$",
       "correct": true
      },
      {
       "text": "$\\frac{7}{2}$",
       "correct": false
      }
     ],
     "explanation": "Since $27=3^3$, $\\sqrt{27}=3^{\\frac{3}{2}}$. Therefore $3\\sqrt{27}=3^1\\times3^{\\frac{3}{2}}=3^{\\frac{5}{2}}$, so $n=\\frac{5}{2}$."
    }
