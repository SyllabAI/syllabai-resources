 "title": "Sector Areas and Arc Lengths",
 "summary": "Learn how slices of circles connect angles, areas and curved lengths in GCSE sector questions.",
 "blocks": [
  {
   "kind": "mcq-set",
   "items": [
    {
     "id": "81030d26-c752-4e12-8c65-b14099b816b3",
     "prompt": "A sector has a central angle of $90°$. What fraction of a full circle is the sector?",
     "options": [
      {
       "text": "$\\frac{1}{2}$",
       "correct": false
      },
      {
       "text": "$\\frac{1}{4}$",
       "correct": true
      },
      {
       "text": "$\\frac{1}{3}$",
       "correct": false
      },
      {
       "text": "$\\frac{3}{4}$",
       "correct": false
      }
     ],
     "explanation": "A full circle is $360°$, so the fraction is $\\frac{90}{360}=\\frac{1}{4}$."
    },
    {
     "id": "3a2cc726-e64d-4114-a687-76e6e0cb013f",
     "prompt": "A sector has radius $10$ cm and central angle $72°$. What is its arc length in terms of $π$?",
     "options": [
      {
       "text": "$20π$ cm",
       "correct": false
      },
      {
       "text": "$10π$ cm",
       "correct": false
      },
      {
       "text": "$4π$ cm",
       "correct": true
      },
      {
       "text": "$2π$ cm",
       "correct": false
      }
     ],
     "explanation": "The sector is $\\frac{72}{360}=\\frac{1}{5}$ of a circle. Its arc length is $\\frac{1}{5}\\times 2π\\times 10=4π$ cm."
    },
    {
     "id": "1c9210a9-36e3-4a41-b7ff-0dda0315877c",
     "prompt": "A major sector has radius $6$ cm and central angle $240°$. What is its area in terms of $π$?",
     "options": [
      {
       "text": "$12π$ cm²",
       "correct": false
      },
      {
       "text": "$18π$ cm²",
       "correct": false
      },
      {
       "text": "$36π$ cm²",
       "correct": false
      },
      {
       "text": "$24π$ cm²",
       "correct": true
      }
     ],
     "explanation": "The area is $\\frac{240}{360}\\times π\\times 6^2=\\frac{2}{3}\\times 36π=24π$ cm²."
    },
    {
     "id": "3b039dbe-9c26-40b8-a585-dca731125c0f",
     "prompt": "A sector has radius $5$ cm and central angle $144°$. What is its perimeter in terms of $π$?",
     "options": [
      {
       "text": "$10+4π$ cm",
       "correct": true
      },
      {
       "text": "$4π$ cm",
       "correct": false
      },
      {
       "text": "$5+4π$ cm",
       "correct": false
      },
      {
       "text": "$10π$ cm",
       "correct": false
      }
     ],
     "explanation": "The arc length is $\\frac{144}{360}\\times 2π\\times 5=4π$ cm. Adding the two radii gives a perimeter of $4π+5+5=10+4π$ cm."
    },
    {
     "id": "0866efe9-30c9-4e70-88cc-0586be745574",
     "prompt": "A rectangle has area $200$ cm². A sector inside it has radius $8$ cm and arc length $5π$ cm. If the sector is unshaded, what is the shaded area?",
     "options": [
      {
       "text": "$200-40π$ cm²",
       "correct": false
      },
      {
       "text": "$200-20π$ cm²",
       "correct": true
      },
      {
       "text": "$20π$ cm²",
       "correct": false
      },
      {
       "text": "$200-5π$ cm²",
       "correct": false
      }
     ],
     "explanation": "Using sector area $=\\frac{1}{2}rl$, the unshaded area is $\\frac{1}{2}\\times 8\\times 5π=20π$ cm². Therefore, the shaded area is $200-20π$ cm²."
    }
