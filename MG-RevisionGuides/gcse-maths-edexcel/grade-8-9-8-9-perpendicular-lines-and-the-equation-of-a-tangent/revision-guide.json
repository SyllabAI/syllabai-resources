   "items": [
    {
     "id": "9cb1ed8c-2312-42d2-adb7-9e3de33c6963",
     "prompt": "A line has equation $y=-4x+7$. What is the gradient of a line perpendicular to it?",
     "options": [
      {
       "text": "$-4$",
       "correct": false
      },
      {
       "text": "$\\frac{1}{4}$",
       "correct": true
      },
      {
       "text": "$-\\frac{1}{4}$",
       "correct": false
      },
      {
       "text": "$4$",
       "correct": false
      }
     ],
     "explanation": "Perpendicular gradients have a product of $-1$. The negative reciprocal of $-4$ is $\\frac{1}{4}$."
    },
    {
     "id": "06231afd-abc0-417b-ac38-e7a28038d4ec",
     "prompt": "A line passes through $(2,5)$ and is perpendicular to $y=\\frac{1}{3}x-2$. What is its equation?",
     "options": [
      {
       "text": "$y=3x-1$",
       "correct": false
      },
      {
       "text": "$y=-\\frac{1}{3}x+\\frac{17}{3}$",
       "correct": false
      },
      {
       "text": "$y=\\frac{1}{3}x+\\frac{13}{3}$",
       "correct": false
      },
      {
       "text": "$y=-3x+11$",
       "correct": true
      }
     ],
     "explanation": "The perpendicular gradient is $-3$. Substituting $(2,5)$ into $y=-3x+c$ gives $5=-6+c$, so $c=11$."
    },
    {
     "id": "353edb9e-7c0b-4f20-b951-2f577bb6b18a",
     "prompt": "Which line is perpendicular to $4x-2y=7$?",
     "options": [
      {
       "text": "$y=-\\frac{1}{2}x+3$",
       "correct": true
      },
      {
       "text": "$y=\\frac{1}{2}x-3$",
       "correct": false
      },
      {
       "text": "$y=-2x+3$",
       "correct": false
      },
      {
       "text": "$y=2x-3$",
       "correct": false
      }
     ],
     "explanation": "Rearranging gives $y=2x-\\frac{7}{2}$, so its gradient is $2$. A perpendicular line must therefore have gradient $-\\frac{1}{2}$."
    },
    {
     "id": "98d841b4-cd36-4d97-a940-3989339da360",
     "prompt": "The endpoints of a line segment are $A(2,1)$ and $B(6,9)$. What is the equation of its perpendicular bisector?",
     "options": [
      {
       "text": "$y=2x-3$",
       "correct": false
      },
      {
       "text": "$y=-\\frac{1}{2}x+2$",
       "correct": false
      },
      {
       "text": "$y=-\\frac{1}{2}x+7$",
       "correct": true
      },
      {
       "text": "$y=\\frac{1}{2}x+3$",
       "correct": false
      }
     ],
     "explanation": "The midpoint is $(4,5)$ and the gradient of $AB$ is $2$, so the perpendicular gradient is $-\\frac{1}{2}$. Using $(4,5)$ gives $5=-2+c$, hence $c=7$."
    },
    {
     "id": "171a9d03-a970-4f32-a573-ccdb8e1475c4",
     "prompt": "The circle $x^2+y^2=100$ has a point $P(6,8)$ on its circumference. What is the equation of the tangent at $P$?",
     "options": [
      {
       "text": "$y=\\frac{4}{3}x$",
       "correct": false
      },
      {
       "text": "$y=-\\frac{3}{4}x+\\frac{25}{2}$",
       "correct": true
      },
      {
       "text": "$y=-\\frac{4}{3}x+16$",
       "correct": false
      },
      {
       "text": "$y=\\frac{3}{4}x+\\frac{7}{2}$",
       "correct": false
      }
     ],
     "explanation": "The radius from $(0,0)$ to $(6,8)$ has gradient $\\frac{4}{3}$, so the tangent has gradient $-\\frac{3}{4}$. Substituting $(6,8)$ gives $8=-\\frac{3}{4}(6)+c$, so $c=\\frac{25}{2}$."
    }
