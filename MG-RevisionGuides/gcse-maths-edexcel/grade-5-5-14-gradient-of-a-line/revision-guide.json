 "title": "Gradient of a Line",
 "summary": "Learn how to measure the steepness of a straight line using grids, coordinates, and missing values.",
 "blocks": [
  {
   "kind": "mcq-set",
   "items": [
    {
     "id": "013f7014-48a3-4808-9f86-ccde4327b78f",
     "prompt": "From left to right, a line goes 5 squares across and 10 squares down. What is its gradient?",
     "options": [
      {
       "text": "2",
       "correct": false
      },
      {
       "text": "$\\frac{1}{2}$",
       "correct": false
      },
      {
       "text": "$-2$",
       "correct": true
      },
      {
       "text": "$-\\frac{1}{2}$",
       "correct": false
      }
     ],
     "explanation": "Gradient is rise divided by run. Going down gives a change in $y$ of $-10$, so the gradient is $\\frac{-10}{5}=-2$."
    },
    {
     "id": "2600320d-0ee6-45a2-9666-64587681f92f",
     "prompt": "Find the gradient of the line through $(-3,5)$ and $(5,1)$.",
     "options": [
      {
       "text": "$\\frac{1}{2}$",
       "correct": false
      },
      {
       "text": "$-\\frac{1}{2}$",
       "correct": true
      },
      {
       "text": "$-2$",
       "correct": false
      },
      {
       "text": "2",
       "correct": false
      }
     ],
     "explanation": "Using $m=\\frac{y_2-y_1}{x_2-x_1}$ gives $m=\\frac{1-5}{5-(-3)}=\\frac{-4}{8}=-\\frac{1}{2}$."
    },
    {
     "id": "ca69dfcf-e5e9-4f17-b74c-07a537df67f6",
     "prompt": "Between two points, a line goes 4 squares to the right and 12 squares up. What is its gradient?",
     "options": [
      {
       "text": "3",
       "correct": true
      },
      {
       "text": "4",
       "correct": false
      },
      {
       "text": "$\\frac{1}{3}$",
       "correct": false
      },
      {
       "text": "12",
       "correct": false
      }
     ],
     "explanation": "Gradient is rise over run, so $m=\\frac{12}{4}=3$. The fraction $\\frac{1}{3}$ comes from incorrectly swapping the rise and run."
    },
    {
     "id": "26d9fd83-640a-4a48-9a9f-99835a446abd",
     "prompt": "A line passes through $(1,-3)$ and $(k,9)$. Its gradient is 4. What is $k$?",
     "options": [
      {
       "text": "3",
       "correct": false
      },
      {
       "text": "5",
       "correct": false
      },
      {
       "text": "12",
       "correct": false
      },
      {
       "text": "4",
       "correct": true
      }
     ],
     "explanation": "Set up $4=\\frac{9-(-3)}{k-1}=\\frac{12}{k-1}$. Therefore $k-1=3$, so $k=4$."
    },
    {
     "id": "cc26dace-9f4d-4925-9f28-e8b605cfb9f7",
     "prompt": "A line passes through $(4,-2)$ and $(4,6)$. What is its gradient?",
     "options": [
      {
       "text": "0",
       "correct": false
      },
      {
       "text": "8",
       "correct": false
      },
      {
       "text": "undefined",
       "correct": true
      },
      {
       "text": "$\\frac{1}{8}$",
       "correct": false
      }
     ],
     "explanation": "The change in $x$ is $4-4=0$, so calculating the gradient would require division by zero. Therefore, the vertical line has an undefined gradient."
    }
   ]
  }
