  },
  {
   "kind": "worked-example",
   "title": "Example 1: Write down the value of the 4 in the number 9487.",
   "steps": [
    {
     "heading": null,
     "body": "9487 = 9000 + 400 + 80 + 7  \nThe 4 is worth 400.",
     "figure_refs": []
    }
   ]
  },
  {
   "kind": "worked-example",
   "title": "Example 2: Write down the value of the 8 in the number 180950.",
   "steps": [
    {
     "heading": null,
     "body": "180950 = 100000 + 80000 + 900 + 50  \nThe 8 is worth 80000.",
     "figure_refs": []
    }
