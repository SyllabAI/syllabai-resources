    {
     "id": "39c74686-2e3b-4c37-a946-97bf18848c90",
     "prompt": "Expand and simplify $(4-\\sqrt{7})^2$.",
     "options": [
      {
       "text": "$9$",
       "correct": false
      },
      {
       "text": "$23$",
