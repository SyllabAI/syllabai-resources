    {
     "id": "a35c55bc-d677-47e5-823d-58a76686345a",
     "prompt": "Simplify $3\\sqrt{48}$ fully.",
     "options": [
      {
       "text": "$4\\sqrt{3}$",
       "correct": false
      },
      {
       "text": "$6\\sqrt{12}$",
       "correct": false
      },
