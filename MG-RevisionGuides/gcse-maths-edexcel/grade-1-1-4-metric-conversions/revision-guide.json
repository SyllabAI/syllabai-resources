 "title": "Metric Conversions",
 "summary": "Learn quick multiply-and-divide rules for changing between common metric units used in everyday GCSE questions.",
 "blocks": [
  {
   "kind": "paragraph",
   "text": "When we have the prefix (before a word) kilo it means 1000"
  },
  {
   "kind": "paragraph",
   "text": "1 kilogram = 1000 grams"
  },
  {
   "kind": "paragraph",
   "text": "1 kilometre = 1000 metres"
  },
  {
   "kind": "paragraph",
   "text": "When we have the prefix (before a word) milli it means 1⁄1000"
  },
  {
   "kind": "paragraph",
   "text": "1000 millimetres = 1 metre"
  },
  {
   "kind": "paragraph",
   "text": "1000 millilitres = 1 litre"
  },
  {
   "kind": "paragraph",
   "text": "When we have the prefix centi it means 1⁄100"
  },
  {
   "kind": "paragraph",
   "text": "100 centimetres = 1 metre"
  },
  {
   "kind": "mcq-set",
   "items": [
    {
     "id": "6dce8fba-e94a-432f-b5b6-3a847500663f",
     "prompt": "A piece of string is 4 m long. What is this length in centimetres?",
     "options": [
      {
       "text": "400 cm",
       "correct": true
      },
      {
       "text": "40 cm",
       "correct": false
      },
      {
       "text": "0.04 cm",
       "correct": false
      },
      {
       "text": "4000 cm",
       "correct": false
      }
     ],
     "explanation": "Metres are converted to smaller centimetres by multiplying by 100: $4 \\times 100 = 400$ cm."
    },
    {
     "id": "69f13f1a-7fa6-4562-8cda-38e3b0f12266",
     "prompt": "A screw is 28 mm long. What is its length in centimetres?",
     "options": [
      {
       "text": "280 cm",
       "correct": false
      },
      {
       "text": "28.0 cm",
       "correct": false
      },
      {
       "text": "0.28 cm",
       "correct": false
      },
      {
       "text": "2.8 cm",
       "correct": true
      }
     ],
     "explanation": "There are 10 millimetres in 1 centimetre, so divide by 10: $28 \\div 10 = 2.8$ cm."
    },
    {
     "id": "e835bde2-cbda-443a-b34e-24a6cd8d72cb",
     "prompt": "A road sign says one park is 1.2 km away, and another is 950 m away. Which distance is longer?",
     "options": [
      {
       "text": "1.2 km, because it is 1200 m",
       "correct": true
      },
      {
       "text": "950 m, because it is 9500 m",
       "correct": false
      },
      {
       "text": "They are the same distance",
       "correct": false
      },
      {
       "text": "950 m, because 1.2 km is 120 m",
       "correct": false
      }
     ],
     "explanation": "Convert kilometres to metres using $1\\text{ km}=1000\\text{ m}$. Thus $1.2\\text{ km}=1200\\text{ m}$, which is longer than 950 m."
    }
   ]
  },
