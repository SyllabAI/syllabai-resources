    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L2::Q8",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L2",
      "stem": "Explain why systematic names are preferable to trivial names for organic compounds.",
      "misconceptionClass": "systematic advantage",
      "kind": "explain-why",
      "modelAnswer": "Millions of organic structures exist, far beyond memory; a constructive naming system lets any chemist decode the structure from the name - and build the name from any structure - without a lookup table of trivia.",
      "keywords": [
        "structures",
        "constructive",
        "decode",
        "chemist"
      ],
      "options": []
    },
    {
