        {
          "key": "C",
          "text": "names are arbitrary labels",
          "correct": false,
          "explanation": "Systematic names are constructive.",
          "misconception": "claim inverted"
        },
        {
          "key": "D",
          "text": "only chemists memorise every molecule",
          "correct": false,
          "explanation": "The system replaces memorisation.",
          "misconception": "claim inverted"
        }
      ]
    },
    {
