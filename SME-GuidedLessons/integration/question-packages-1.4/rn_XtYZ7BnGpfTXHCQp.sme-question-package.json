    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L3::Q1",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L3",
      "stem": "Which reaction type forms a single product from two or more molecules?",
      "misconceptionClass": "addition definition",
      "options": [
        {
          "key": "A",
          "text": "Elimination",
          "correct": false,
          "explanation": "Elimination removes a small molecule.",
          "misconception": "type mismatched"
        },
        {
          "key": "B",
          "text": "Hydrolysis",
          "correct": false,
          "explanation": "Hydrolysis splits with water.",
          "misconception": "type mismatched"
        },
        {
          "key": "C",
          "text": "Addition",
          "correct": true,
          "explanation": "Everything combines into one product.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Substitution",
          "correct": false,
          "explanation": "Substitution replaces, not combines.",
          "misconception": "type mismatched"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L3::Q2",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L3",
      "stem": "Swapping one atom or atom-group out for another defines which reaction type?",
