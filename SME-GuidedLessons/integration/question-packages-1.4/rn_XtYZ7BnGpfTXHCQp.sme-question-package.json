      "options": [
        {
          "key": "A",
          "text": "Addition",
          "correct": false,
          "explanation": "Addition adds rather than swaps.",
          "misconception": "type mismatched"
        },
        {
          "key": "B",
          "text": "Condensation",
          "correct": false,
          "explanation": "Condensation joins and eliminates.",
          "misconception": "type mismatched"
        },
        {
          "key": "C",
          "text": "Polymerisation",
          "correct": false,
          "explanation": "That chains many monomers.",
          "misconception": "type mismatched"
        },
        {
          "key": "D",
          "text": "Substitution",
          "correct": true,
          "explanation": "One group swaps out for another.",
          "misconception": null
        }
      ]
    },
    {
