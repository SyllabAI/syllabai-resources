  "questions": [
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q1",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "In systematic nomenclature, what does the stem of an IUPAC name encode?",
      "misconceptionClass": "stem meaning",
      "options": [
        {
          "key": "A",
          "text": "The number of carbon atoms in the longest chain",
          "correct": true,
          "explanation": "Meth- through dec- count one to ten.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The number of side-chains",
          "correct": false,
          "explanation": "Prefixes like di- count those.",
          "misconception": "role confused"
        },
        {
          "key": "C",
          "text": "The functional group present",
          "correct": false,
          "explanation": "Suffixes and infixes carry the functional group.",
          "misconception": "role confused"
        },
        {
          "key": "D",
          "text": "The molecule's mass",
          "correct": false,
          "explanation": "Mass is not encoded in the stem.",
          "misconception": "role confused"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q2",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "Which stem corresponds to a four-carbon longest chain?",
      "misconceptionClass": "but stem",
      "options": [
        {
          "key": "A",
          "text": "hept-",
          "correct": false,
          "explanation": "Hept- counts seven.",
          "misconception": "count wrong"
        },
        {
          "key": "B",
          "text": "but-",
          "correct": true,
          "explanation": "Butane carries four carbons.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "prop-",
          "correct": false,
          "explanation": "Prop- counts three.",
          "misconception": "count wrong"
        },
        {
          "key": "D",
          "text": "pent-",
          "correct": false,
          "explanation": "Pent- counts five.",
          "misconception": "count wrong"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q3",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "How are the carbon atoms of the longest chain numbered when naming?",
      "misconceptionClass": "numbering direction rule",
      "options": [
        {
          "key": "A",
          "text": "From the end nearest the functional group only",
          "correct": false,
          "explanation": "The general rule is lowest numbers overall.",
          "misconception": "rule incomplete"
        },
        {
          "key": "B",
          "text": "From either end - both give valid names",
          "correct": false,
          "explanation": "Only the lowest-locant name is correct.",
          "misconception": "uniqueness denied"
        },
        {
          "key": "C",
          "text": "From whichever chain end keeps the side-chain numbers lowest",
          "correct": true,
          "explanation": "Locants are minimised.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Always from the left as drawn",
          "correct": false,
          "explanation": "Drawing orientation is arbitrary; the rule is about lowest locants.",
          "misconception": "rule misstated"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q4",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "How is a hydrocarbon side-chain named?",
      "misconceptionClass": "alkyl naming rule",
      "options": [
        {
          "key": "A",
          "text": "By adding -ide to the stem",
          "correct": false,
          "explanation": "-ide endings belong to ions.",
          "misconception": "ending wrong"
        },
        {
          "key": "B",
          "text": "By counting it as a separate molecule",
          "correct": false,
          "explanation": "Side-chains are part of the one molecule.",
          "misconception": "structure misstated"
        },
        {
          "key": "C",
          "text": "By capitalising the stem",
          "correct": false,
          "explanation": "No capitalisation convention exists.",
          "misconception": "convention invented"
        },
        {
          "key": "D",
          "text": "Take the alkane stem, append -yl, and bracket it in the formula",
          "correct": true,
          "explanation": "Methane contributes a methyl group.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q5",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "Two methyl groups appear on the same chain. How is this encoded in the name?",
      "misconceptionClass": "multiplicity prefix",
      "options": [
        {
          "key": "A",
          "text": "As dimethyl, with a comma between adjacent position numbers",
          "correct": true,
          "explanation": "di- marks two, commas join the numbers.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "As methyl methyl with a space",
          "correct": false,
          "explanation": "The multiplicity prefix is required.",
          "misconception": "convention wrong"
        },
        {
          "key": "C",
          "text": "As bismethyl",
          "correct": false,
          "explanation": "bi- is not the organic prefix.",
          "misconception": "prefix wrong"
        },
        {
          "key": "D",
          "text": "The second methyl is ignored",
          "correct": false,
          "explanation": "Every substituent is named.",
          "misconception": "omission wrong"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q6",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "State the alkane stems for chains of one to five carbons.",
      "misconceptionClass": "stems recall",
      "kind": "recall",
      "modelAnswer": "Meth-, eth-, prop-, but-, pent- count one through five carbons.",
      "keywords": [
        "meth-",
        "eth-",
        "prop-",
        "but-",
        "pent-"
      ],
      "options": []
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q7",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "State the punctuation rules connecting numbers and words in organic names.",
      "misconceptionClass": "punctuation recall",
      "kind": "recall",
      "modelAnswer": "Adjacent numbers take a comma between them; numbers separate from words by a hyphen.",
      "keywords": [
        "comma",
        "hyphen",
        "numbers",
        "words"
      ],
      "options": []
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q8",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "Explain why the lowest-number rule exists in systematic nomenclature.",
      "misconceptionClass": "uniqueness rationale",
      "kind": "explain-why",
      "modelAnswer": "A branched chain can be numbered from either end, giving different locants for the same molecule; fixing on the lowest set makes the name unique, which is the entire purpose of systematic nomenclature.",
      "keywords": [
        "either end",
        "locants",
        "unique",
        "purpose"
      ],
      "options": []
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L1::Q9",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L1",
      "stem": "Name CH3CH(CH3)CH2CH3 systematically, showing the stem and locant reasoning.",
      "misconceptionClass": "naming application",
      "kind": "application",
      "modelAnswer": "The longest chain carries four carbons (but-); numbering from the nearer end puts the methyl branch on carbon 2; the name is 2-methylbutane.",
      "keywords": [
        "four",
        "but-",
        "carbon 2",
        "2-methylbutane"
      ],
      "options": []
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L2::Q1",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L2",
      "stem": "What does the functional-group nomenclature table provide?",
      "misconceptionClass": "table contents",
      "options": [
        {
          "key": "A",
          "text": "Reaction mechanisms",
          "correct": false,
          "explanation": "Mechanisms are not in the naming table.",
          "misconception": "content misstated"
        },
        {
          "key": "B",
          "text": "Examples, nomenclature and names for each functional-group family",
          "correct": true,
          "explanation": "Three columns decode every family.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Boiling points of each family",
          "correct": false,
          "explanation": "Physical data is not the table's job.",
          "misconception": "content misstated"
        },
        {
          "key": "D",
          "text": "Hazard symbols for each family",
          "correct": false,
          "explanation": "Safety data lives elsewhere.",
          "misconception": "content misstated"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L2::Q2",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L2",
      "stem": "Which set of families appears in the nomenclature table?",
      "misconceptionClass": "family list",
      "options": [
        {
          "key": "A",
          "text": "Metals and non-metals",
          "correct": false,
          "explanation": "Those are element classes.",
          "misconception": "list wrong"
        },
        {
          "key": "B",
          "text": "Acids and alkalis only",
          "correct": false,
          "explanation": "The table covers organic families.",
          "misconception": "list truncated"
        },
        {
          "key": "C",
          "text": "From alkenes through alcohols, aldehydes and ketones to acids, esters, amines and nitriles",
          "correct": true,
          "explanation": "The eight families of the table of record.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Alkanes, alkenes, alkynes only",
          "correct": false,
          "explanation": "The table reaches far beyond hydrocarbons.",
          "misconception": "list truncated"
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L2::Q3",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L2",
      "stem": "What must a systematic name combine to be complete?",
      "misconceptionClass": "complete name ingredients",
      "options": [
        {
          "key": "A",
          "text": "The stem only",
          "correct": false,
          "explanation": "That omits position and function.",
          "misconception": "incomplete"
        },
        {
          "key": "B",
          "text": "The functional group only",
          "correct": false,
          "explanation": "That omits skeleton and position.",
          "misconception": "incomplete"
        },
        {
          "key": "C",
          "text": "The molecular mass",
          "correct": false,
          "explanation": "Mass is not part of the name.",
          "misconception": "ingredient wrong"
        },
        {
          "key": "D",
          "text": "The alkane stem, the locants and the functional group's naming signal",
          "correct": true,
          "explanation": "All three encode the structure fully.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_XtYZ7BnGpfTXHCQp::L2::Q4",
      "moduleId": "rn_XtYZ7BnGpfTXHCQp::L2",
      "stem": "A name ending announced by the table tells you",
