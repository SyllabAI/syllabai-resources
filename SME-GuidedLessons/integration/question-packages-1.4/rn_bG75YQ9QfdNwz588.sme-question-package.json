    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q1",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "The sodium-chlorine reaction decreases the system's entropy because",
      "misconceptionClass": "NaCl system entropy",
      "options": [
        {
          "key": "A",
          "text": "A solid forms from a solid and a gas, ordering the products",
          "correct": true,
          "explanation": "Losing a gas descends the state ladder.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The reaction is endothermic",
          "correct": false,
          "explanation": "It is strongly exothermic.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "Sodium melts",
          "correct": false,
          "explanation": "No melting occurs in the change.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Chlorine is a liquid",
          "correct": false,
          "explanation": "Chlorine is a gas.",
          "misconception": "fact slip"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q2",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "The surroundings' entropy rises when a reaction releases heat because",
      "misconceptionClass": "surroundings gain",
      "options": [
        {
          "key": "A",
          "text": "The system gains order",
          "correct": false,
          "explanation": "System order is the opposite of surroundings spreading.",
          "misconception": "confusion"
        },
        {
          "key": "B",
          "text": "The released energy spreads among the surroundings' particles, multiplying their energy arrangements",
          "correct": true,
          "explanation": "Distributed heat is the surroundings' entropy currency.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The surroundings lose particles",
          "correct": false,
          "explanation": "No particles move over.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "The surroundings cool",
          "correct": false,
          "explanation": "Receiving heat warms them.",
          "misconception": "inversion slip"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q3",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "The total entropy change is defined as",
      "misconceptionClass": "total definition",
      "options": [
        {
          "key": "A",
          "text": "Delta S total = delta S system x delta S surroundings",
          "correct": false,
          "explanation": "The relation is additive.",
          "misconception": "operation slip"
        },
        {
          "key": "B",
          "text": "Delta S total = delta H / T",
          "correct": false,
          "explanation": "That is the surroundings' term alone.",
          "misconception": "partial formula"
        },
        {
          "key": "C",
          "text": "Delta S total = delta S system + delta S surroundings",
          "correct": true,
          "explanation": "Both books are added.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Delta S total = delta S system - delta S surroundings",
          "correct": false,
          "explanation": "The surroundings' term enters positively.",
          "misconception": "sign slip"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q4",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "For sodium and chlorine, spontaneity holds because",
      "misconceptionClass": "NaCl verdict",
      "options": [
        {
          "key": "A",
          "text": "The system's entropy is positive",
          "correct": false,
          "explanation": "It is negative here.",
          "misconception": "fact slip"
        },
        {
          "key": "B",
          "text": "The reaction is endothermic",
          "correct": false,
          "explanation": "It is exothermic.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "Entropy never decreases anywhere",
          "correct": false,
          "explanation": "The system's entropy clearly decreases.",
          "misconception": "contradiction"
        },
        {
          "key": "D",
          "text": "The strongly positive delta S surroundings outweighs the negative delta S system",
          "correct": true,
          "explanation": "The surroundings' gain dominates the ledger.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q5",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "A flame is needed to start the sodium-chlorine reaction, which shows that",
      "misconceptionClass": "activation aside",
      "options": [
        {
          "key": "A",
          "text": "Feasibility and rate are separate questions - the change is feasible but needs activation energy",
          "correct": true,
          "explanation": "Thermodynamic permission is not kinetic speed.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The reaction is not feasible",
          "correct": false,
          "explanation": "It proceeds vigorously once started.",
          "misconception": "contradiction"
        },
        {
          "key": "C",
          "text": "Entropy is negative overall",
          "correct": false,
          "explanation": "The total entropy change is positive.",
          "misconception": "fact slip"
        },
        {
          "key": "D",
          "text": "Catalysts are required",
          "correct": false,
          "explanation": "No catalyst is involved.",
          "misconception": "false claim"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q6",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "State the equation for the total entropy change of a reaction.",
      "misconceptionClass": "total recall",
      "kind": "recall",
      "modelAnswer": "Delta S total = delta S system + delta S surroundings.",
      "keywords": [
        "system",
        "surroundings",
        "total"
      ],
      "options": []
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q7",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "State the system and surroundings entropy signs for sodium burning in chlorine.",
      "misconceptionClass": "NaCl signs recall",
      "kind": "recall",
      "modelAnswer": "Delta S system is negative and delta S surroundings is strongly positive.",
      "keywords": [
        "negative",
        "positive",
        "surroundings"
      ],
      "options": []
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q8",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "Explain why the surroundings' entropy gain can outweigh the system's loss.",
      "misconceptionClass": "outweigh why",
      "kind": "explain-why",
      "modelAnswer": "Released energy is distributed among vastly more particles in the surroundings, so the number of energy arrangements outside rises far more than the ordering inside costs; the sum lands positive.",
      "keywords": [
        "surroundings",
        "energy",
        "arrangements"
      ],
      "options": []
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L1::Q9",
      "moduleId": "rn_bG75YQ9QfdNwz588::L1",
      "stem": "A reaction has delta S system = -50 J K^-1 mol^-1 and is strongly exothermic. Predict the sign of delta S total and the feasibility.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "The exothermic change makes delta S surroundings large and positive, so delta S total is positive and the reaction is feasible despite the system's loss.",
      "keywords": [
        "surroundings",
        "feasible",
        "exothermic"
      ],
      "options": []
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q1",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "The equation below gives the standard entropy change of a system",
      "misconceptionClass": "system equation",
      "options": [
        {
          "key": "A",
          "text": "Delta H divided by T",
          "correct": false,
          "explanation": "That is the surroundings' formula.",
          "misconception": "formula mix"
        },
        {
          "key": "B",
          "text": "Sum of standard entropies of products minus sum for reactants",
          "correct": true,
          "explanation": "Products minus reactants, with coefficients respected.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Reactants minus products",
          "correct": false,
          "explanation": "The subtraction runs the wrong way.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "Products plus reactants",
          "correct": false,
          "explanation": "No addition of the two sides occurs.",
          "misconception": "operation slip"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q2",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "The standard entropy of an element in its reference state is",
      "misconceptionClass": "element entropy",
      "options": [
        {
          "key": "A",
          "text": "Always 100 J K^-1 mol^-1",
          "correct": false,
          "explanation": "No such fixed value exists.",
          "misconception": "invented value"
        },
        {
          "key": "B",
          "text": "Negative",
          "correct": false,
          "explanation": "Standard entropies are positive.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "Not zero; data books list real values for elements",
          "correct": true,
          "explanation": "Entropy differs from enthalpy of formation here.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Zero by definition",
          "correct": false,
          "explanation": "That rule belongs to formation enthalpies.",
          "misconception": "rule mix"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q3",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "For N2 plus 3H2 giving 2NH3, delta S system equals",
      "misconceptionClass": "ammonia setup",
      "options": [
        {
          "key": "A",
          "text": "S(NH3) minus (S(N2) plus S(H2))",
          "correct": false,
          "explanation": "Coefficients 2 and 3 are missing.",
          "misconception": "coefficient slip"
        },
        {
          "key": "B",
          "text": "2 x S(NH3) minus S(N2)",
          "correct": false,
          "explanation": "The hydrogen term is dropped.",
          "misconception": "term loss"
        },
        {
          "key": "C",
          "text": "S(N2) plus 3 x S(H2) minus 2 x S(NH3)",
          "correct": false,
          "explanation": "That computes the negative of the answer.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "2 x S(NH3) minus (S(N2) plus 3 x S(H2))",
          "correct": true,
          "explanation": "Every coefficient multiplies its species.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q4",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "Entropy values are quoted in joules rather than kilojoules because",
      "misconceptionClass": "joule scale",
      "options": [
        {
          "key": "A",
          "text": "Entropy changes run roughly an order of magnitude below enthalpy changes",
          "correct": true,
          "explanation": "The smaller quantity keeps its natural unit.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Entropy cannot exceed one kilojoule",
          "correct": false,
          "explanation": "No such ceiling exists.",
          "misconception": "invented rule"
        },
        {
          "key": "C",
          "text": "Data books print only joules for all quantities",
          "correct": false,
          "explanation": "Enthalpies are printed in kilojoules.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Kelvin divides the joule",
          "correct": false,
          "explanation": "The unit pair is J K^-1 mol^-1 by definition.",
          "misconception": "half truth"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q5",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "For 2Mg plus O2 forming 2MgO with S values 32.60, 205.0 and 38.20 J K^-1 mol^-1, delta S system equals",
      "misconceptionClass": "MgO arithmetic",
      "options": [
        {
          "key": "A",
          "text": "+270.8 J K^-1 mol^-1",
          "correct": false,
          "explanation": "That adds instead of subtracts.",
          "misconception": "operation slip"
        },
        {
          "key": "B",
          "text": "-193.8 J K^-1 mol^-1, since 2(38.20) - [2(32.60) + 205.0]",
          "correct": true,
          "explanation": "Products minus reactants with coefficients.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "+193.8 J K^-1 mol^-1, subtracting in the wrong order",
          "correct": false,
          "explanation": "Reactants exceed products here.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "-134.2 J K^-1 mol^-1, dropping one Mg term",
          "correct": false,
          "explanation": "Both Mg values enter.",
          "misconception": "coefficient slip"
        }
      ]
    },
    {
