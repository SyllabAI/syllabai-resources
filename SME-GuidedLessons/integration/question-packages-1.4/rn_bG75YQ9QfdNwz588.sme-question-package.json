    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q8",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "Explain why elements have nonzero standard entropies even though their formation enthalpies are zero.",
      "misconceptionClass": "element why",
      "kind": "explain-why",
      "modelAnswer": "Formation enthalpy measures making a compound from elements, so the reference sits at zero by definition; entropy counts the disorder already present in every substance, and an element's particles still hold countable arrangements.",
      "keywords": [
        "element",
        "entropy",
        "formation"
      ],
      "options": []
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L2::Q9",
      "moduleId": "rn_bG75YQ9QfdNwz588::L2",
      "stem": "A gaseous reaction gives fewer gas moles than it consumes. Without numbers, predict the sign of delta S system and justify.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "Fewer gas moles after the change means fewer positional arrangements, so delta S system is negative; the magnitude depends on the data-book values.",
      "keywords": [
        "gas",
        "negative",
        "system"
      ],
      "options": []
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L3::Q1",
      "moduleId": "rn_bG75YQ9QfdNwz588::L3",
      "stem": "The equation for the entropy change of the surroundings is",
      "misconceptionClass": "surroundings equation",
      "options": [
        {
          "key": "A",
          "text": "Delta S surroundings = -T / delta H",
          "correct": false,
          "explanation": "The quotient is inverted.",
          "misconception": "inversion slip"
        },
        {
          "key": "B",
          "text": "Delta S surroundings = delta H x T",
          "correct": false,
          "explanation": "No multiplication rule applies.",
          "misconception": "operation slip"
        },
        {
          "key": "C",
          "text": "Delta S surroundings = -delta H / T",
          "correct": true,
          "explanation": "Transferred enthalpy divided by temperature, with a direction sign.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Delta S surroundings = delta H / T",
          "correct": false,
          "explanation": "The minus sign encodes the direction of heat flow.",
          "misconception": "sign slip"
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L3::Q2",
      "moduleId": "rn_bG75YQ9QfdNwz588::L3",
      "stem": "An exothermic reaction's delta S surroundings is",
      "misconceptionClass": "exothermic surroundings",
      "options": [
        {
          "key": "A",
          "text": "Negative, because the system lost energy",
          "correct": false,
          "explanation": "The system's loss is the surroundings' gain.",
          "misconception": "inversion slip"
        },
        {
          "key": "B",
          "text": "Zero",
          "correct": false,
          "explanation": "The transfer is substantial.",
          "misconception": "false claim"
        },
        {
          "key": "C",
          "text": "Undefined",
          "correct": false,
          "explanation": "The equation defines it cleanly.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Positive, because the released heat spreads and disorders the surroundings",
          "correct": true,
          "explanation": "Heat in means more arrangements outside.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_bG75YQ9QfdNwz588::L3::Q3",
      "moduleId": "rn_bG75YQ9QfdNwz588::L3",
      "stem": "The same enthalpy change produces a larger delta S surroundings at low temperature because",
      "misconceptionClass": "temperature sensitivity",
      "options": [
        {
          "key": "A",
          "text": "Cold surroundings have scarcer energy quanta, so delivered heat rearranges them more",
          "correct": true,
          "explanation": "Entropy per joule grows as T falls.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Cold surroundings absorb more energy",
          "correct": false,
          "explanation": "The energy transferred is the same.",
          "misconception": "false cause"
        },
        {
          "key": "C",
          "text": "Cold substances have no entropy",
          "correct": false,
          "explanation": "They have lower but real entropy.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Kelvin scales invert the sign",
          "correct": false,
          "explanation": "The sign comes from the minus, not the temperature.",
          "misconception": "mechanism slip"
        }
      ]
    },
