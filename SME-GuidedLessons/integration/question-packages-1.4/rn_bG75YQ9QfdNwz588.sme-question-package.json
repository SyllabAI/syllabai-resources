    {
      "id": "rn_bG75YQ9QfdNwz588::L3::Q8",
      "moduleId": "rn_bG75YQ9QfdNwz588::L3",
      "stem": "Explain why the minus sign appears in delta S surroundings = -delta H / T.",
      "misconceptionClass": "minus why",
      "kind": "explain-why",
      "modelAnswer": "The equation must record where the heat went: an exothermic system (negative delta H) gives heat to the surroundings, raising their entropy, so the negative of a negative delta H lands positive; the sign flips the system's perspective to the surroundings'.",
      "keywords": [
        "surroundings",
        "exothermic",
        "delta"
      ],
      "options": []
    },
