        {
          "key": "C",
          "text": "has no effect on either",
          "correct": false,
          "explanation": "The exposure chance genuinely drops.",
          "misconception": "effect denied"
        },
        {
          "key": "D",
          "text": "decreases the risk but does not change the hazard",
          "correct": true,
          "explanation": "The acid's properties are untouched; exposure likelihood falls.",
          "misconception": null
        }
      ]
    },
