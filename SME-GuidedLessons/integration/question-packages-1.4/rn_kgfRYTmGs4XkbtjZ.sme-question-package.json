          "key": "A",
          "text": "Because it is expensive",
          "correct": false,
          "explanation": "Cost is irrelevant.",
          "misconception": "irrelevant attribute"
        },
        {
          "key": "B",
          "text": "Only when it is heated",
          "correct": false,
          "explanation": "The hazard exists independent of heating.",
          "misconception": "condition misstated"
        },
        {
          "key": "C",
          "text": "It is corrosive",
          "correct": true,
          "explanation": "Corrosiveness is the inherent property.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Because goggles are sometimes forgotten",
          "correct": false,
          "explanation": "Goggles affect risk, not hazard.",
          "misconception": "term swapped"
        }
      ]
    },
    {
