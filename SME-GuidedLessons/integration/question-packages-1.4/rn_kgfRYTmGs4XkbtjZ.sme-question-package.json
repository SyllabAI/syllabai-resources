    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q6",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "State the difference between a hazard and a risk.",
      "misconceptionClass": "hazard vs risk recall",
      "kind": "recall",
      "modelAnswer": "A hazard is baked into what the substance is - its inherent properties; a risk is the harm chance that comes with the way you plan to use it.",
      "keywords": [
        "inherent properties",
        "plan to use",
        "chance",
        "harm"
      ],
      "options": []
    },
    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q7",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "State what eye protection changes and what it does not change when handling corrosive acid.",
      "misconceptionClass": "protection effect recall",
      "kind": "recall",
      "modelAnswer": "Eye protection decreases the risk but does not affect the hazard.",
      "keywords": [
