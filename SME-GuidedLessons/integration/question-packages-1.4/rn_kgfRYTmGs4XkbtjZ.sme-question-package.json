    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q1",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "What does the hazard of a substance relate to?",
      "misconceptionClass": "hazard definition",
      "options": [
        {
          "key": "A",
          "text": "The inherent properties of the substance itself",
          "correct": true,
          "explanation": "Hazard travels with the chemical, not the procedure.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The way the substance is used",
          "correct": false,
          "explanation": "That describes the risk.",
          "misconception": "term swapped"
        },
        {
          "key": "C",
          "text": "The cost of the substance",
          "correct": false,
          "explanation": "Price plays no part.",
          "misconception": "irrelevant attribute"
        },
        {
          "key": "D",
          "text": "The colour of its container",
          "correct": false,
          "explanation": "Packaging is not the hazard.",
          "misconception": "irrelevant attribute"
        }
      ]
    },
    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q2",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "A beaker of water is being boiled on a tripod and gauze. Which statement is correct?",
      "misconceptionClass": "boiling water example",
      "options": [
        {
          "key": "A",
          "text": "The hazard increases as it boils",
          "correct": false,
          "explanation": "The inherent properties do not change.",
          "misconception": "hazard drift"
        },
        {
          "key": "B",
          "text": "Water has little inherent hazard, but the boiling setup carries real risks from steam and hot liquid",
          "correct": true,
          "explanation": "Usage creates the exposure and the harm chance.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Boiling water becomes hazardous by definition",
          "correct": false,
          "explanation": "The hazard stays with inherent properties; the risk rises.",
          "misconception": "term swapped"
        },
        {
          "key": "D",
          "text": "There is no risk because water is harmless",
          "correct": false,
          "explanation": "The procedure creates scald risks.",
          "misconception": "risk denied"
        }
      ]
    },
    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q3",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "Why does hydrochloric acid carry a hazard?",
      "misconceptionClass": "HCl hazard reason",
      "options": [
