      "options": []
    },
    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q8",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "Explain why the same chemical can be safe in one procedure and dangerous in another.",
      "misconceptionClass": "procedure dependence logic",
      "kind": "explain-why",
      "modelAnswer": "The hazard - the substance's inherent properties - never changes between procedures, but the risk tracks the usage plan: heating, contact chances and exposure routes differ, so the chance of harm differs even at constant hazard.",
      "keywords": [
        "inherent",
        "usage plan",
        "chance",
        "exposure"
      ],
      "options": []
    },
    {
      "id": "rn_kgfRYTmGs4XkbtjZ::L1::Q9",
      "moduleId": "rn_kgfRYTmGs4XkbtjZ::L1",
      "stem": "A class heats ethanol in an open dish. Separate the hazard from two distinct risks of this procedure.",
      "misconceptionClass": "separation application",
      "kind": "application",
      "modelAnswer": "Hazard: ethanol is flammable. Risks: the open flame can ignite the vapour, and heating increases the chance the vapour meets the flame - the plan raises the exposure chance while the flammability stays constant.",
      "keywords": [
        "flammable",
        "vapour",
        "ignite",
        "chance"
      ],
      "options": []
    },
    {
