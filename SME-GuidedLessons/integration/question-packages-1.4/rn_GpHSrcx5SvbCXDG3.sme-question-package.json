    {
      "id": "rn_GpHSrcx5SvbCXDG3::L1::Q1",
      "moduleId": "rn_GpHSrcx5SvbCXDG3::L1",
      "stem": "What energy change accompanies bond breaking?",
      "misconceptionClass": "direction drill",
      "options": [
        {
          "key": "A",
          "text": "Energy is absorbed - breaking is endothermic",
          "correct": true,
          "explanation": "Pulling atoms apart resists their attraction.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Energy is released - breaking is exothermic",
          "correct": false,
          "explanation": "Formation releases; breaking absorbs.",
          "misconception": "direction inverted"
        },
        {
          "key": "C",
          "text": "No energy changes",
          "correct": false,
          "explanation": "The bond holds stored energy.",
          "misconception": "claim false"
        },
        {
          "key": "D",
          "text": "It depends on the bond's colour",
          "correct": false,
          "explanation": "Colour is irrelevant.",
          "misconception": "nonsense option"
        }
      ]
    },
    {
      "id": "rn_GpHSrcx5SvbCXDG3::L1::Q2",
      "moduleId": "rn_GpHSrcx5SvbCXDG3::L1",
      "stem": "The overall enthalpy change in bond-enthalpy terms equals:",
      "misconceptionClass": "master equation",
      "options": [
        {
          "key": "A",
          "text": "The average of broken and formed",
          "correct": false,
          "explanation": "No averaging exists.",
          "misconception": "convention invented"
        },
        {
          "key": "B",
          "text": "Total energy to break bonds minus total energy released forming bonds",
          "correct": true,
          "explanation": "Costs minus earnings.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Total formed minus total broken",
          "correct": false,
          "explanation": "That inverts every sign.",
          "misconception": "direction inverted"
        },
        {
          "key": "D",
          "text": "Total broken plus total formed",
          "correct": false,
          "explanation": "Addition ignores the opposing directions.",
          "misconception": "algebra wrong"
        }
      ]
    },
    {
      "id": "rn_GpHSrcx5SvbCXDG3::L1::Q3",
      "moduleId": "rn_GpHSrcx5SvbCXDG3::L1",
      "stem": "Why must all species be gaseous for bond-enthalpy calculations?",
      "misconceptionClass": "gas restriction",
      "options": [
        {
          "key": "A",
          "text": "Liquids cannot react",
          "correct": false,
          "explanation": "They react; their enthalpy includes extra terms.",
          "misconception": "claim false"
        },
        {
          "key": "B",
          "text": "Solids have no bonds",
          "correct": false,
          "explanation": "Solids are full of bonds.",
          "misconception": "claim false"
        },
        {
          "key": "C",
          "text": "Tabulated values measure isolated gas-phase molecules",
          "correct": true,
          "explanation": "Extra intermolecular terms would corrupt the ledger.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Gases are hotter",
          "correct": false,
          "explanation": "Temperature is not the reason.",
          "misconception": "reason invented"
        }
      ]
    },
    {
      "id": "rn_GpHSrcx5SvbCXDG3::L1::Q4",
      "moduleId": "rn_GpHSrcx5SvbCXDG3::L1",
      "stem": "A bond-enthalpy calculation returns -184 kJ mol^-1. What does the sign report?",
      "misconceptionClass": "sign reading",
      "options": [
        {
          "key": "A",
          "text": "Breaking cost more than forming earned",
          "correct": false,
          "explanation": "That would read positive.",
          "misconception": "sign inverted"
        },
        {
          "key": "B",
          "text": "The reaction is endothermic",
          "correct": false,
          "explanation": "Negative means exothermic.",
          "misconception": "sign inverted"
        },
        {
          "key": "C",
          "text": "The bonds were aqueous",
          "correct": false,
          "explanation": "The sign is independent of phase notation.",
          "misconception": "inference crossed"
        },
        {
          "key": "D",
          "text": "Formation released more energy than breaking consumed",
          "correct": true,
          "explanation": "The earnings beat the costs.",
          "misconception": null
        }
      ]
    },
    {
