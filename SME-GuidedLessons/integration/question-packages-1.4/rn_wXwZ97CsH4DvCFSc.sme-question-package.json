    {
      "id": "rn_wXwZ97CsH4DvCFSc::L1::Q7",
      "moduleId": "rn_wXwZ97CsH4DvCFSc::L1",
      "stem": "State why the flame test identifies metal ions.",
      "misconceptionClass": "basis recall",
      "kind": "recall",
      "modelAnswer": "Metal ions produce characteristic colours in a flame, and different metals produce different colours, so the colour identifies the ion.",
      "keywords": [
        "characteristic colours",
        "different",
        "identifies"
      ],
      "options": []
    },
    {
      "id": "rn_wXwZ97CsH4DvCFSc::L1::Q8",
      "moduleId": "rn_wXwZ97CsH4DvCFSc::L1",
      "stem": "Explain why contamination is fatal to a flame test.",
      "misconceptionClass": "purity reasoning",
      "kind": "explain-why",
      "modelAnswer": "Each ion emits its own wavelengths; a second ion's emission overlaps the first, so the observed colour is a mixture that matches no single ion and misleads the identification.",
      "keywords": [
        "emission",
        "overlap",
        "mixture"
      ],
      "options": []
    },
    {
      "id": "rn_wXwZ97CsH4DvCFSc::L1::Q9",
      "moduleId": "rn_wXwZ97CsH4DvCFSc::L1",
      "stem": "A sodium-contaminated loop reads lilac-plus-yellow for a potassium sample. Which ion's signal is masked, and by which colour?",
      "misconceptionClass": "masking application",
      "kind": "application",
      "modelAnswer": "Potassium's lilac is masked by sodium's yellow, the classic contamination overlap.",
      "keywords": [
        "potassium",
        "lilac",
        "yellow"
      ],
      "options": []
    },
    {
