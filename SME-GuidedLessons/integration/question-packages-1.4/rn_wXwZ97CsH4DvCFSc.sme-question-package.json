  "questions": [
    {
      "id": "rn_wXwZ97CsH4DvCFSc::L1::Q1",
      "moduleId": "rn_wXwZ97CsH4DvCFSc::L1",
      "stem": "Why is the loop cleaned in concentrated acid before use?",
      "misconceptionClass": "cleaning purpose",
      "options": [
        {
          "key": "A",
          "text": "To remove residue so only one type of ion is present",
          "correct": true,
          "explanation": "Single-ion purity is the reading's foundation.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "To sterilise the loop",
          "correct": false,
          "explanation": "Sterility is irrelevant to the chemistry.",
          "misconception": "purpose wrong"
        },
        {
          "key": "C",
          "text": "To make the loop conductive",
          "correct": false,
          "explanation": "Conductivity plays no role.",
          "misconception": "purpose wrong"
        },
        {
          "key": "D",
          "text": "To colour the flame as a control",
          "correct": false,
          "explanation": "A blank, not a colour, is the control.",
          "misconception": "control confused"
        }
      ]
    },
    {
      "id": "rn_wXwZ97CsH4DvCFSc::L1::Q2",
      "moduleId": "rn_wXwZ97CsH4DvCFSc::L1",
      "stem": "What happens when two different ions share the loop at once?",
      "misconceptionClass": "mixed ions",
      "options": [
        {
          "key": "A",
          "text": "The flame goes out",
          "correct": false,
          "explanation": "The flame keeps burning.",
          "misconception": "nonsense"
        },
        {
          "key": "B",
          "text": "Their colours mix, making identification erroneous",
          "correct": true,
          "explanation": "Overlapping emissions corrupt the reading.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Only the heavier ion shows",
          "correct": false,
          "explanation": "Both emissions appear.",
          "misconception": "selection myth"
        },
        {
          "key": "D",
          "text": "No colour appears at all",
          "correct": false,
          "explanation": "A mixed but visible colour results.",
          "misconception": "silence myth"
        }
      ]
    },
    {
      "id": "rn_wXwZ97CsH4DvCFSc::L1::Q3",
      "moduleId": "rn_wXwZ97CsH4DvCFSc::L1",
      "stem": "Where in the Bunsen flame is the sample placed?",
