        },
        {
          "key": "C",
          "text": "The loop's metal",
          "correct": false,
          "explanation": "The wire carries the sample, not the energy source.",
          "misconception": "agent confusion"
        },
        {
          "key": "D",
          "text": "Light from the room",
          "correct": false,
          "explanation": "Ambient light is irrelevant.",
          "misconception": "driver wrong"
        }
      ]
    },
    {
