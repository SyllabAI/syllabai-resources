          "misconception": "nonsense"
        }
      ]
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q6",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "State the three ion tests in the toolkit.",
      "misconceptionClass": "toolkit recall",
      "kind": "recall",
      "modelAnswer": "Ammonium ions with sodium hydroxide and warming, carbonate ions with aqueous acid, and sulfate ions with acidified barium chloride.",
      "keywords": [
        "ammonium",
        "carbonate",
        "sulfate"
      ],
      "options": []
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q7",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "Write the ionic equation for carbonate meeting acid.",
      "misconceptionClass": "ionic recall",
      "kind": "recall",
      "modelAnswer": "2H+ (aq) + CO3 2- (aq) -> CO2 (g) + H2O (l).",
      "keywords": [
