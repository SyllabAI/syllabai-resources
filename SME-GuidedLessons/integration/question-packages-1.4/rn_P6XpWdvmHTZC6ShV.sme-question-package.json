        "CO2"
      ],
      "options": []
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q8",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "Explain why deionised water is specified for dissolving samples.",
      "misconceptionClass": "purity reasoning",
      "kind": "explain-why",
      "modelAnswer": "Tap water carries its own ions, including carbonate and sulfate, which would trigger false positives; deionised water adds no interfering ions.",
      "keywords": [
        "deionised",
        "ions",
        "false positives"
      ],
      "options": []
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q9",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "A solution gives no ammonia, no fizz, but a white precipitate with acidified barium chloride. Which ion is present, and which two are absent?",
      "misconceptionClass": "diagnosis application",
      "kind": "application",
      "modelAnswer": "Sulfate is present; ammonium and carbonate are absent by their negative tests.",
      "keywords": [
        "sulfate",
        "absent",
        "white precipitate"
      ],
      "options": []
    },
    {
