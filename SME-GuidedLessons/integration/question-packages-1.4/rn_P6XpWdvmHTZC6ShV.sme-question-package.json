        },
        {
          "key": "C",
          "text": "Oxygen",
          "correct": false,
          "explanation": "No oxygen forms in this test.",
          "misconception": "gas confused"
        },
        {
          "key": "D",
          "text": "Carbon dioxide",
          "correct": true,
          "explanation": "Acid plus carbonate fizzes CO2.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q5",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "Which reagent identifies sulfate ions?",
