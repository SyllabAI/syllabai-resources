  "questions": [
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q1",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "Which ions can simple test tube reactions identify?",
      "misconceptionClass": "toolkit scope",
      "options": [
        {
          "key": "A",
          "text": "Ammonium, carbonate, hydrogencarbonate and sulfate",
          "correct": true,
          "explanation": "The three-test toolkit covers all four.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Chloride and bromide",
          "correct": false,
          "explanation": "Halide testing needs silver nitrate, not this toolkit.",
          "misconception": "scope wrong"
        },
        {
          "key": "C",
          "text": "Sodium and potassium",
          "correct": false,
          "explanation": "Those need flame tests.",
          "misconception": "method wrong"
        },
        {
          "key": "D",
          "text": "All ions equally",
          "correct": false,
          "explanation": "The toolkit is three tests, not universal.",
          "misconception": "scope inflated"
        }
      ]
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q2",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "What must happen to a solid sample before testing?",
      "misconceptionClass": "sample prep",
      "options": [
        {
          "key": "A",
          "text": "It can be tested dry",
          "correct": false,
          "explanation": "The reactions need aqueous ions.",
          "misconception": "state wrong"
        },
        {
          "key": "B",
          "text": "It must dissolve in deionised water to make an aqueous solution",
          "correct": true,
          "explanation": "The tests run on solutions.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "It must be heated to melting",
          "correct": false,
          "explanation": "No melting step exists.",
          "misconception": "prep wrong"
        },
        {
          "key": "D",
          "text": "It must be acidified with concentrated acid first",
          "correct": false,
          "explanation": "Only the sulfate test acidifies, and dilute at that.",
          "misconception": "prep wrong"
        }
      ]
    },
    {
      "id": "rn_P6XpWdvmHTZC6ShV::L1::Q3",
      "moduleId": "rn_P6XpWdvmHTZC6ShV::L1",
      "stem": "What does an ionic equation omit?",
      "misconceptionClass": "ionic form",
      "options": [
        {
          "key": "A",
          "text": "The water",
          "correct": false,
          "explanation": "Water stays when it is a product.",
          "misconception": "omission wrong"
        },
        {
          "key": "B",
          "text": "The charges",
          "correct": false,
          "explanation": "Charges are essential to the ionic form.",
          "misconception": "omission wrong"
        },
        {
          "key": "C",
          "text": "The spectator ions that take no part in the reaction",
          "correct": true,
          "explanation": "Only the reacting ions stay.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "The gases",
          "correct": false,
          "explanation": "Gases stay in the equation.",
          "misconception": "omission wrong"
        }
      ]
    },
    {
