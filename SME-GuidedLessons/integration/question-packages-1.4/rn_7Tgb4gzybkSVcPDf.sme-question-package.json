    {
      "id": "rn_7Tgb4gzybkSVcPDf::L2::Q8",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L2",
      "stem": "Explain why the formation route works even when the reaction itself cannot be run in a calorimeter.",
      "misconceptionClass": "route reasoning",
      "kind": "explain-why",
      "modelAnswer": "The cycle never runs the actual reaction - it computes the same level gap through the elements' legs, so unmeasurable reactions still yield exact values from tabulated data.",
