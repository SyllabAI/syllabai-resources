    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L3::Q1",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L3",
      "stem": "The combustion-route formula for a formation value reads:",
      "misconceptionClass": "formula recall",
      "options": [
        {
