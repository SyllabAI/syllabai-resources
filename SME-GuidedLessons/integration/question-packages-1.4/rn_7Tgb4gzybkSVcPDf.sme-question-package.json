          "misconception": "convention invented"
        },
        {
          "key": "C",
          "text": "Elements' combustions summed, minus the compound's combustion",
          "correct": true,
          "explanation": "The flipped slogan.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Compound's combustion minus elements' combustions",
