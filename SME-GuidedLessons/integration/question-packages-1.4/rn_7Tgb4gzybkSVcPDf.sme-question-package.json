  "questions": [
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q1",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "What does Hess's law assert about an enthalpy change?",
      "misconceptionClass": "law statement",
      "options": [
        {
          "key": "A",
          "text": "It is independent of the route taken between reactants and products",
          "correct": true,
          "explanation": "State function, route-blind.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "It depends on the route's speed",
          "correct": false,
          "explanation": "Kinetics never enters enthalpy.",
          "misconception": "kinetics crossed"
        },
        {
          "key": "C",
          "text": "It changes when a catalyst is added",
          "correct": false,
          "explanation": "Catalysts move the hump, not the levels.",
          "misconception": "catalyst confusion"
        },
        {
          "key": "D",
          "text": "It only applies to combustion",
          "correct": false,
          "explanation": "The law is universal.",
          "misconception": "scope narrowed"
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q2",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "On a formation-route energy cycle, where do the elements sit?",
      "misconceptionClass": "cycle geography",
      "options": [
        {
          "key": "A",
          "text": "Above the hump",
          "correct": false,
          "explanation": "Cycles have no humps.",
          "misconception": "geometry crossed"
        },
        {
          "key": "B",
          "text": "On their own level, joined to both reactants and products by arrows",
          "correct": true,
          "explanation": "The elements are the shared intermediate.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Inside the products box",
          "correct": false,
          "explanation": "Elements and compounds occupy separate levels.",
          "misconception": "placement crossed"
        },
        {
          "key": "D",
          "text": "Nowhere - cycles skip them",
          "correct": false,
          "explanation": "The elements are the whole point of the construction.",
          "misconception": "design denied"
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q3",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "Why can a reaction's enthalpy change be found from tabulated formation values?",
      "misconceptionClass": "cycle logic",
      "options": [
        {
          "key": "A",
          "text": "The law only holds for elements",
          "correct": false,
          "explanation": "The law holds for all routes.",
          "misconception": "scope misstated"
        },
        {
          "key": "B",
          "text": "Experiments cannot measure any enthalpy",
          "correct": false,
          "explanation": "Many are directly measurable; cycles cover the impossible ones.",
          "misconception": "claim false"
        },
        {
          "key": "C",
          "text": "Both reactants and products can be decomposed to the same elements on paper",
          "correct": true,
          "explanation": "The shared element level closes the cycle.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Formation values equal reaction values",
          "correct": false,
          "explanation": "They are different quantities.",
          "misconception": "quantities equated"
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q4",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "What must you track most carefully when adding the legs of a cycle?",
      "misconceptionClass": "error focus",
      "options": [
        {
          "key": "A",
          "text": "The colour of the arrows",
          "correct": false,
          "explanation": "Presentation, not physics.",
          "misconception": "irrelevant detail"
        },
        {
          "key": "B",
          "text": "The number of decimal places",
          "correct": false,
          "explanation": "Precision matters less than direction.",
          "misconception": "priority misstated"
        },
        {
          "key": "C",
          "text": "The hump's height",
          "correct": false,
          "explanation": "Cycles carry no humps.",
          "misconception": "geometry crossed"
        },
        {
          "key": "D",
          "text": "The direction of each arrow, which fixes each sign",
          "correct": true,
          "explanation": "Reversed arrows flip the value's sign.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q5",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "Which phrase belongs in a full statement of Hess's law?",
      "misconceptionClass": "statement precision",
      "options": [
        {
          "key": "A",
          "text": "The enthalpy change of a reaction is independent of the route taken",
          "correct": true,
          "explanation": "The canonical phrasing.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Energy cannot be created or destroyed",
          "correct": false,
          "explanation": "That is the first law - true but not the Hess statement.",
          "misconception": "law crossed"
        },
        {
          "key": "C",
          "text": "Reactions release energy in all routes",
          "correct": false,
          "explanation": "Endothermic routes exist.",
          "misconception": "claim false"
        },
        {
          "key": "D",
          "text": "Enthalpy equals temperature times capacity",
          "correct": false,
          "explanation": "That is a calorimetry relation.",
          "misconception": "formula crossed"
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q6",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "State Hess's law in its standard wording.",
      "misconceptionClass": "law recall",
      "kind": "recall",
      "modelAnswer": "The enthalpy change of a reaction is independent of the route taken between reactants and products.",
      "keywords": [
        "enthalpy change",
        "independent",
        "route"
      ],
      "options": []
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q7",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "Describe the construction of a simple energy cycle through the elements.",
      "misconceptionClass": "construction recall",
      "kind": "recall",
      "modelAnswer": "Draw reactants and products on the top level, place the elements on a lower level, and join them with arrows carrying the tabulated formation values.",
      "keywords": [
        "elements",
        "level",
        "arrows"
      ],
      "options": []
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q8",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "Explain why enthalpy being a state function makes Hess's law work.",
      "misconceptionClass": "foundation reasoning",
      "kind": "explain-why",
      "modelAnswer": "A state function's value depends only on the current state, so any complete journey between the same two states accumulates the same net change, whatever the path - legs through elements are just one such path.",
      "keywords": [
        "state function",
        "path",
        "net change"
      ],
      "options": []
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L1::Q9",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L1",
      "stem": "A direct reaction's enthalpy change cannot be measured because the reaction is too slow. Explain how a cycle solves the problem.",
      "misconceptionClass": "cycle application",
      "kind": "application",
      "modelAnswer": "Choose tabulated intermediates (the elements), add the legs algebraically with arrow-directed signs, and the sum delivers the direct change without running the slow reaction.",
      "keywords": [
        "elements",
        "legs",
        "sum"
      ],
      "options": []
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L2::Q1",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L2",
      "stem": "The formation-route formula reads: enthalpy of reaction equals:",
      "misconceptionClass": "formula recall",
      "options": [
        {
          "key": "A",
          "text": "The larger side minus the smaller",
          "correct": false,
          "explanation": "The sides are fixed by the equation, not by size.",
          "misconception": "convention invented"
        },
        {
          "key": "B",
          "text": "Sum of products' formation values minus sum of reactants' formation values",
          "correct": true,
          "explanation": "The products-minus-reactants slogan.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Reactants minus products",
          "correct": false,
          "explanation": "That inverts every sign.",
          "misconception": "direction inverted"
        },
        {
          "key": "D",
          "text": "Products plus reactants",
          "correct": false,
          "explanation": "Addition ignores the cycle's geometry.",
          "misconception": "algebra wrong"
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L2::Q2",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L2",
      "stem": "Formation values of N2(g) and H2(g) appear in the ammonia cycle. What do they contribute?",
      "misconceptionClass": "zero contribution",
      "options": [
        {
          "key": "A",
          "text": "A negative correction",
          "correct": false,
          "explanation": "Elements contribute exactly zero.",
          "misconception": "value invented"
        },
        {
          "key": "B",
          "text": "Their combustion values",
          "correct": false,
          "explanation": "Wrong quantity family.",
          "misconception": "quantity crossed"
        },
        {
          "key": "C",
          "text": "Nothing - both are elements in their standard states",
          "correct": true,
          "explanation": "The zero floor applies.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Their bond energies",
          "correct": false,
          "explanation": "Bond enthalpies belong to a different route.",
          "misconception": "quantity crossed"
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L2::Q3",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L2",
      "stem": "A formation value must be multiplied when:",
      "misconceptionClass": "coefficient drill",
      "options": [
        {
          "key": "A",
          "text": "Its value is negative",
          "correct": false,
          "explanation": "Signs never trigger multiplication.",
          "misconception": "trigger misstated"
        },
        {
          "key": "B",
          "text": "Its state is liquid",
          "correct": false,
          "explanation": "State does not scale coefficients.",
          "misconception": "trigger crossed"
        },
        {
          "key": "C",
          "text": "Never - values are used as tabulated",
          "correct": false,
          "explanation": "Coefficients above one demand multiplication.",
          "misconception": "claim false"
        },
        {
          "key": "D",
          "text": "Its species' coefficient in the reaction equation exceeds one",
          "correct": true,
          "explanation": "Scale follows the equation.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_7Tgb4gzybkSVcPDf::L2::Q4",
      "moduleId": "rn_7Tgb4gzybkSVcPDf::L2",
      "stem": "Ammonia synthesis: N2 + 3H2 -> 2NH3 with formation value of NH3 at -46 kJ mol^-1. The reaction enthalpy is:",
      "misconceptionClass": "calculation drill",
      "options": [
        {
