        "shielding",
        "distance",
        "nuclear charge"
      ],
      "options": []
    },
    {
      "id": "rn_kmFRZRhprvZ6CZDM::L2::Q7",
      "moduleId": "rn_kmFRZRhprvZ6CZDM::L2",
      "stem": "Quote the direction of both ionisation energies down Group 2.",
      "misconceptionClass": "direction recall",
      "kind": "recall",
      "modelAnswer": "Both the first and the second ionisation energy decrease going down the group.",
      "keywords": [
        "decrease",
        "first",
        "second"
      ],
      "options": []
    },
    {
      "id": "rn_kmFRZRhprvZ6CZDM::L2::Q8",
      "moduleId": "rn_kmFRZRhprvZ6CZDM::L2",
      "stem": "Explain why easier electron removal makes the metals more reactive down the group.",
      "misconceptionClass": "reactivity link",
      "kind": "explain-why",
      "modelAnswer": "Reactivity here is electron donation, so anything that lowers the energy cost of removal - falling ionisation energies - lets atoms donate sooner and react more vigorously.",
      "keywords": [
        "removal",
        "donate",
        "reactive"
      ],
      "options": []
    },
    {
      "id": "rn_kmFRZRhprvZ6CZDM::L2::Q9",
      "moduleId": "rn_kmFRZRhprvZ6CZDM::L2",
      "stem": "If the first ionisation energy drops by roughly 10 percent per step down Group 2 from 900 kJ mol-1 at the top, estimate the value two steps down.",
      "misconceptionClass": "step application",
      "kind": "application",
      "modelAnswer": "Two 10 percent cuts leave 0.9 x 0.9 = 0.81 of 900, about 729 kJ mol-1.",
      "keywords": [
