  "questions": [
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q1",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "Theoretical lattice energies assume",
      "misconceptionClass": "theoretical assumption",
      "options": [
        {
          "key": "A",
          "text": "Perfectly spherical ions with purely electrostatic attraction",
          "correct": true,
          "explanation": "The model is deliberately idealised.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Partial covalent bonding inside the lattice",
          "correct": false,
          "explanation": "Covalent character is what the theory omits.",
          "misconception": "contradiction"
        },
        {
          "key": "C",
          "text": "Polarised anions",
          "correct": false,
          "explanation": "Polarisation is the real-world deviation.",
          "misconception": "contradiction"
        },
        {
          "key": "D",
          "text": "Variable ionic charges",
          "correct": false,
          "explanation": "Charges are whole numbers in the model.",
          "misconception": "contradiction"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q2",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "Measured lattice energies can differ from theoretical ones because",
      "misconceptionClass": "measured difference",
      "options": [
        {
          "key": "A",
          "text": "Ions gain mass in the lattice",
          "correct": false,
          "explanation": "Mass is conserved.",
          "misconception": "nonsense claim"
        },
        {
          "key": "B",
          "text": "Anion polarisation introduces covalent character the model excludes",
          "correct": true,
          "explanation": "Distorted electron clouds deepen the real attraction.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Experiments are always wrong",
          "correct": false,
          "explanation": "The deviation is systematic, not error.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Lattices are unstable",
          "correct": false,
          "explanation": "They are highly stable.",
          "misconception": "contradiction"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q3",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "A cation with the greatest polarising power is",
      "misconceptionClass": "polarising power ranking",
      "options": [
        {
          "key": "A",
          "text": "Large and highly charged",
          "correct": false,
          "explanation": "Size dilutes even a high charge.",
          "misconception": "partial truth"
        },
        {
          "key": "B",
          "text": "Small and singly charged",
          "correct": false,
          "explanation": "Charge matters as much as size.",
          "misconception": "partial truth"
        },
        {
          "key": "C",
          "text": "Small and highly charged",
          "correct": true,
          "explanation": "Charge density peaks when charge is high and radius low.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Large and singly charged",
          "correct": false,
          "explanation": "That combination minimises charge density.",
          "misconception": "inversion slip"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q4",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "K+ polarises less strongly than Li+ because",
      "misconceptionClass": "K vs Li",
      "options": [
        {
          "key": "A",
          "text": "Its charge is higher",
          "correct": false,
          "explanation": "Both are 1+.",
          "misconception": "fact slip"
        },
        {
          "key": "B",
          "text": "Potassium is a gas",
          "correct": false,
          "explanation": "It is a metal.",
          "misconception": "nonsense claim"
        },
        {
          "key": "C",
          "text": "Lithium repels anions",
          "correct": false,
          "explanation": "Lithium attracts them more strongly.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "Its ionic radius is greater, spreading the same charge over a larger sphere",
          "correct": true,
          "explanation": "Charge density falls as radius grows.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q5",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "Mg2+ polarises more strongly than Na+ chiefly because",
      "misconceptionClass": "Mg vs Na",
      "options": [
        {
          "key": "A",
          "text": "Its charge is larger at a comparable size, raising charge density",
          "correct": true,
          "explanation": "The 2+ charge concentrates the pull.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "It is significantly larger",
          "correct": false,
          "explanation": "It is similar or smaller in radius.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "It carries no charge",
          "correct": false,
          "explanation": "It carries 2+.",
          "misconception": "fact slip"
        },
        {
          "key": "D",
          "text": "Sodium repels electrons",
          "correct": false,
          "explanation": "Sodium's cation attracts them.",
          "misconception": "inversion slip"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q6",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "Define polarisation of an anion.",
      "misconceptionClass": "polarisation recall",
      "kind": "recall",
      "modelAnswer": "The cation attracts the anion's electrons, distorting the anion's electron density and adding covalent character.",
      "keywords": [
        "cation",
        "distort",
        "anion"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q7",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "State the approximate charge-density comparison used to estimate covalent character.",
      "misconceptionClass": "charge density recall",
      "kind": "recall",
      "modelAnswer": "Charge density is compared as charge divided by the square of the ionic radius.",
      "keywords": [
        "charge",
        "radius",
        "density"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q8",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "Explain why polarisation makes measured lattice energies more exothermic than theoretical ones.",
      "misconceptionClass": "measured why",
      "kind": "explain-why",
      "modelAnswer": "Distorting the anion draws electron density into the region between the ions, adding covalent attraction on top of the electrostatic term; the deeper real well releases more energy than the purely ionic model allows.",
      "keywords": [
        "covalent",
        "attraction",
        "electrostatic"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L1::Q9",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L1",
      "stem": "Rank the polarising power of Na+, Mg2+ and Al3+ and justify the order.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "Al3+ > Mg2+ > Na+: the charge climbs 1, 2, 3 while the radius shrinks, so charge density - and hence polarising power - rises steeply across period 3.",
      "keywords": [
        "charge",
        "rank",
        "polarising"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q1",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "The polarisability of an anion increases with",
      "misconceptionClass": "anion polarisability",
      "options": [
        {
          "key": "A",
          "text": "Its colour",
          "correct": false,
          "explanation": "Irrelevant.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "B",
          "text": "Its ionic radius",
          "correct": true,
          "explanation": "Larger clouds distort more easily.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Its charge becoming less negative",
          "correct": false,
          "explanation": "The comparison here is size-driven.",
          "misconception": "wrong lever"
        },
        {
          "key": "D",
          "text": "Its mass alone",
          "correct": false,
          "explanation": "Mass is not the criterion.",
          "misconception": "wrong lever"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q2",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "Br- is more polarisable than Cl- because",
      "misconceptionClass": "Br vs Cl",
      "options": [
        {
          "key": "A",
          "text": "It is heavier but smaller",
          "correct": false,
          "explanation": "It is larger down the group.",
          "misconception": "fact slip"
        },
        {
          "key": "B",
          "text": "Bromine is a liquid",
          "correct": false,
          "explanation": "The ion's phase is irrelevant.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "C",
          "text": "Its ionic radius is larger, so its electron cloud yields more readily",
          "correct": true,
          "explanation": "Down Group 7 the clouds swell and soften.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Its charge is greater",
          "correct": false,
          "explanation": "Both carry 1-.",
          "misconception": "fact slip"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q3",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "In the NaCl versus MgCl2 comparison, the greater covalent character belongs to",
      "misconceptionClass": "chloride comparison",
      "options": [
        {
          "key": "A",
          "text": "NaCl, because sodium is larger",
          "correct": false,
          "explanation": "Larger means weaker pull.",
          "misconception": "inversion slip"
        },
        {
          "key": "B",
          "text": "Neither - both are perfectly ionic",
          "correct": false,
          "explanation": "Polarisation affects both.",
          "misconception": "contradiction"
        },
        {
          "key": "C",
          "text": "Both equally",
          "correct": false,
          "explanation": "The cations differ in charge density.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "MgCl2, because Mg2+ has the higher charge density and pulls harder on the chloride clouds",
          "correct": true,
          "explanation": "The 2+ cation distorts more.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q4",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "The charge density approximation divides",
      "misconceptionClass": "density formula",
      "options": [
        {
          "key": "A",
          "text": "The charge by the square of the ionic radius",
          "correct": true,
          "explanation": "The stated approximation is charge over r squared.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The radius by the charge",
          "correct": false,
          "explanation": "That inverts the quantity.",
          "misconception": "inversion slip"
        },
        {
          "key": "C",
          "text": "The charge by the radius",
          "correct": false,
          "explanation": "The stated version squares the radius.",
          "misconception": "formula slip"
        },
        {
          "key": "D",
          "text": "The mass by the charge",
          "correct": false,
          "explanation": "Mass is not in the approximation.",
          "misconception": "wrong lever"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q5",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "Which pair correctly shows both polarising levers at once?",
      "misconceptionClass": "lever pairing",
      "options": [
        {
          "key": "A",
          "text": "A singly charged cation with a small anion",
          "correct": false,
          "explanation": "Both levers weaken the effect.",
          "misconception": "partial truth"
        },
        {
          "key": "B",
          "text": "A small, highly charged cation with a large anion gives the most covalent character",
          "correct": true,
          "explanation": "Maximum pull meets maximum yield.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "A large cation with a small anion",
          "correct": false,
          "explanation": "Both levers point the wrong way.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "A small cation with a small anion",
          "correct": false,
          "explanation": "The anion resists distortion.",
          "misconception": "partial truth"
        }
      ]
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q6",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "State which chloride is more polarisable and why: NaCl's or MgCl2's.",
      "misconceptionClass": "chloride recall",
      "kind": "recall",
      "modelAnswer": "MgCl2's chloride ions, because the Mg2+ cation's higher charge density distorts them more strongly.",
      "keywords": [
        "charge",
        "distort",
        "chloride"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q7",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "State the polarisability comparison between Br- and Cl-.",
      "misconceptionClass": "bromide recall",
      "kind": "recall",
      "modelAnswer": "Br- is more polarisable than Cl- because its ionic radius is larger.",
      "keywords": [
        "larger",
        "polarisable",
        "radius"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q8",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "Explain why large anions are easily distorted.",
      "misconceptionClass": "large anion why",
      "kind": "explain-why",
      "modelAnswer": "A large ionic radius spreads the outer electrons further from the nucleus, so they are held loosely and a neighbouring cation's attraction can reshape the cloud with little effort.",
      "keywords": [
        "radius",
        "electrons",
        "large"
      ],
      "options": []
    },
    {
      "id": "rn_HpXM38fvyBfzKqQM::L2::Q9",
      "moduleId": "rn_HpXM38fvyBfzKqQM::L2",
      "stem": "Predict which shows more covalent character: LiI or LiF, and justify.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "LiI: the iodide ion is far larger and more polarisable than fluoride, so with the same Li+ cation the iodide compound distorts more and carries the greater covalent character.",
      "keywords": [
        "anion",
        "covalent",
        "character"
      ],
      "options": []
    }
  ]
}
