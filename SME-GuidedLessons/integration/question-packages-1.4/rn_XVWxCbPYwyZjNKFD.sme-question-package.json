  "questions": [
    {
      "id": "rn_XVWxCbPYwyZjNKFD::L1::Q1",
      "moduleId": "rn_XVWxCbPYwyZjNKFD::L1",
      "stem": "What do structural isomers share?",
      "misconceptionClass": "isomer shared trait",
      "options": [
        {
          "key": "A",
          "text": "The same molecular formula",
          "correct": true,
          "explanation": "Identical atom inventories.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The same structural formula",
          "correct": false,
          "explanation": "That would make them the same compound.",
          "misconception": "trait inverted"
        },
        {
          "key": "C",
          "text": "The same functional group position",
          "correct": false,
          "explanation": "Positional isomers differ there.",
          "misconception": "trait wrong"
        },
        {
          "key": "D",
          "text": "The same longest chain length",
          "correct": false,
          "explanation": "Chain isomers differ there.",
          "misconception": "trait wrong"
        }
      ]
    },
    {
      "id": "rn_XVWxCbPYwyZjNKFD::L1::Q2",
      "moduleId": "rn_XVWxCbPYwyZjNKFD::L1",
      "stem": "What differs between structural isomers?",
      "misconceptionClass": "isomer differing trait",
      "options": [
        {
          "key": "A",
          "text": "Their elemental identities",
          "correct": false,
          "explanation": "Same elements throughout.",
          "misconception": "trait inverted"
        },
        {
          "key": "B",
          "text": "Their structural formulae - the bonding arrangement",
          "correct": true,
          "explanation": "Same atoms, different wiring.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Their molecular formulae",
          "correct": false,
          "explanation": "Those are identical by definition.",
          "misconception": "trait inverted"
        },
        {
          "key": "D",
          "text": "Their total atom counts",
          "correct": false,
          "explanation": "Counts match exactly.",
          "misconception": "trait inverted"
        }
      ]
    },
    {
      "id": "rn_XVWxCbPYwyZjNKFD::L1::Q3",
      "moduleId": "rn_XVWxCbPYwyZjNKFD::L1",
      "stem": "Propene and cyclopropane are structural isomers because",
      "misconceptionClass": "propene cyclopropane case",
      "options": [
        {
          "key": "A",
          "text": "one contains oxygen",
          "correct": false,
          "explanation": "Neither does.",
          "misconception": "element invented"
        },
        {
          "key": "B",
          "text": "they have the same structure",
          "correct": false,
          "explanation": "Their structures differ - that is the point.",
          "misconception": "claim inverted"
        },
        {
          "key": "C",
          "text": "both are made of 3 carbons and 6 hydrogens but joined differently - one open chain, one ring",
          "correct": true,
          "explanation": "Same C3H6 inventory, different connectivity.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "they have different molecular formulae",
          "correct": false,
          "explanation": "Both are C3H6.",
          "misconception": "formula misstated"
        }
      ]
    },
    {
      "id": "rn_XVWxCbPYwyZjNKFD::L1::Q4",
      "moduleId": "rn_XVWxCbPYwyZjNKFD::L1",
      "stem": "Which two types of structural isomerism does the syllabus require?",
