        {
          "key": "B",
          "text": "The formula was misread",
          "correct": false,
          "explanation": "The difference is structural, genuine.",
          "misconception": "explanation wrong"
        },
        {
          "key": "C",
          "text": "They are actually identical",
          "correct": false,
          "explanation": "Different structures mean different compounds.",
          "misconception": "claim inverted"
        },
        {
          "key": "D",
          "text": "Isomers always share properties",
          "correct": false,
          "explanation": "They differ, sometimes sharply.",
          "misconception": "claim inverted"
        }
      ]
    },
    {
