  "questions": [
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q1",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "What shape does an s orbital have?",
      "misconceptionClass": "s shape",
      "options": [
        {
          "key": "A",
          "text": "Spherical",
          "correct": true,
          "explanation": "The s probability cloud is angle-independent: a sphere.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Dumbbell",
          "correct": false,
          "explanation": "That is the p orbital's shape.",
          "misconception": "shape confused"
        },
        {
          "key": "C",
          "text": "Four-lobed clover",
          "correct": false,
          "explanation": "That describes d orbitals - and is not required.",
          "misconception": "shape confused"
        },
        {
          "key": "D",
          "text": "Ring",
          "correct": false,
          "explanation": "No orbital is a ring.",
          "misconception": "shape invented"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q2",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "How are the three p orbitals of a shell oriented?",
      "misconceptionClass": "p orientation",
      "options": [
        {
          "key": "A",
          "text": "Randomly oriented",
          "correct": false,
          "explanation": "The axes are fixed and orthogonal.",
          "misconception": "orientation denied"
        },
        {
          "key": "B",
          "text": "Along the x, y and z axes, perpendicular to one another",
          "correct": true,
          "explanation": "Each p orbital claims one axis.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "All three along the x axis",
          "correct": false,
          "explanation": "They would be degenerate AND identical, which is impossible.",
          "misconception": "orientation wrong"
        },
        {
          "key": "D",
          "text": "Pointing at 45 degrees to each other",
          "correct": false,
          "explanation": "The angles are 90 degrees.",
          "misconception": "angle wrong"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q3",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "Which shells contain p orbitals?",
      "misconceptionClass": "p shells",
      "options": [
        {
          "key": "A",
          "text": "Only shells n = 3 and above",
          "correct": false,
          "explanation": "2p exists.",
          "misconception": "shell miscounted"
        },
        {
          "key": "B",
          "text": "Only the outermost shell of each atom",
          "correct": false,
          "explanation": "Every filled shell from 2 up has its own p set.",
          "misconception": "scope narrowed"
        },
        {
          "key": "C",
          "text": "Every shell from n = 2 upward",
          "correct": true,
          "explanation": "The first shell is s-only.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Every shell including n = 1",
          "correct": false,
          "explanation": "The first shell has just 1s.",
          "misconception": "shell miscounted"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q4",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "How does the size of s orbitals change with shell number?",
      "misconceptionClass": "s sizing",
      "options": [
        {
          "key": "A",
          "text": "They shrink with increasing n",
          "correct": false,
          "explanation": "The trend is growth.",
          "misconception": "trend inverted"
        },
        {
          "key": "B",
          "text": "They stay identical across shells",
          "correct": false,
          "explanation": "Size tracks the shell.",
          "misconception": "trend denied"
        },
        {
          "key": "C",
          "text": "Only p orbitals change size",
          "correct": false,
          "explanation": "Both s and p lobes lengthen.",
          "misconception": "scope wrong"
        },
        {
          "key": "D",
          "text": "They grow larger as n increases, so 3s is bigger than 1s",
          "correct": true,
          "explanation": "Higher shells sit farther out on average.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q5",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "What must you know about the shapes of d orbitals?",
      "misconceptionClass": "d requirement",
      "options": [
        {
          "key": "A",
          "text": "Nothing beyond their count and capacity - their shape is not required",
          "correct": true,
          "explanation": "The specification stops at s and p shapes.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "They are dumbbells like p",
          "correct": false,
          "explanation": "The d shape is out of scope.",
          "misconception": "requirement invented"
        },
        {
          "key": "C",
          "text": "They are always spherical",
          "correct": false,
          "explanation": "Sphericity belongs to s.",
          "misconception": "shape misattributed"
        },
        {
          "key": "D",
          "text": "They only exist in shells 1 and 2",
          "correct": false,
          "explanation": "d sub-shells start at n = 3.",
          "misconception": "occupancy wrong"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q6",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "Describe the shape and orientation of p orbitals.",
      "misconceptionClass": "p description recall",
      "kind": "recall",
      "modelAnswer": "Dumbbell-shaped, three per shell from n = 2 upward, pointing along the x, y and z axes at right angles to each other.",
      "keywords": [
        "dumbbell",
        "three",
        "axes",
        "perpendicular"
      ],
      "options": []
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q7",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "State the capacities of s and p sub-shells.",
      "misconceptionClass": "capacity recall",
      "kind": "recall",
      "modelAnswer": "An s sub-shell holds one orbital (2 electrons); a p sub-shell holds three orbitals (6 electrons).",
      "keywords": [
        "one orbital",
        "2 electrons",
        "three orbitals",
        "6 electrons"
      ],
      "options": []
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q8",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "Explain why the p orbital's shape shows a node at the nucleus.",
      "misconceptionClass": "p node reason",
      "kind": "explain-why",
      "modelAnswer": "The p probability distribution splits into two lobes on opposite sides of the nucleus with a plane of zero probability through it: the electron in a p orbital is found on either side, never ON the nodal plane at the centre, which is what the dumbbell drawing encodes.",
      "keywords": [
        "lobes",
        "probability",
        "plane",
        "centre"
      ],
      "options": []
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L1::Q9",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L1",
      "stem": "Sketch-verbalise the difference between a 2p orbital and a 3p orbital.",
      "misconceptionClass": "p comparison application",
      "kind": "application",
      "modelAnswer": "Both are dumbbells along one axis, but the 3p lobes are larger and longer, because the third shell's probability cloud extends farther from the nucleus.",
      "keywords": [
        "dumbbell",
        "axis",
        "larger",
        "third shell"
      ],
      "options": []
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L2::Q1",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L2",
      "stem": "Three electrons enter a p sub-shell. Where do they go?",
      "misconceptionClass": "three electron placement",
      "options": [
        {
          "key": "A",
          "text": "One in px, two split between py and pz with random spins",
          "correct": false,
          "explanation": "Spins stay parallel while single.",
          "misconception": "spin misdrawn"
        },
        {
          "key": "B",
          "text": "One each into px, py and pz, all with parallel spins",
          "correct": true,
          "explanation": "Hund's rule: single occupancy first.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Two paired in px, one in py",
          "correct": false,
          "explanation": "Pairing must wait until every orbital has one.",
          "misconception": "pairing premature"
        },
        {
          "key": "D",
          "text": "All three in px",
          "correct": false,
          "explanation": "An orbital holds two electrons at most.",
          "misconception": "capacity breached"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L2::Q2",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L2",
      "stem": "What does the Pauli exclusion principle state?",
      "misconceptionClass": "Pauli statement",
      "options": [
        {
          "key": "A",
          "text": "Electrons always spin in the same direction",
          "correct": false,
          "explanation": "Pairs run opposite.",
          "misconception": "spin misstated"
        },
        {
          "key": "B",
          "text": "Each sub-shell fills completely before the next",
          "correct": false,
          "explanation": "That is the filling order, not Pauli.",
          "misconception": "rule confused"
        },
        {
          "key": "C",
          "text": "An orbital holds at most two electrons, and they must have opposite spins",
          "correct": true,
          "explanation": "The two-rule capacity and spin condition.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Electrons never share orbitals",
          "correct": false,
          "explanation": "They share, under spin conditions.",
          "misconception": "sharing denied"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L2::Q3",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L2",
      "stem": "Why do electrons single-occupy before pairing, given that they repel each other anyway?",
      "misconceptionClass": "single-first logic",
      "options": [
        {
          "key": "A",
          "text": "Because paired electrons cancel charges",
          "correct": false,
          "explanation": "Charges never cancel between electrons.",
          "misconception": "physics misstated"
        },
        {
          "key": "B",
          "text": "Because orbitals repel electrons",
          "correct": false,
          "explanation": "Orbitals are regions, not actors.",
          "misconception": "agency misattributed"
        },
        {
          "key": "C",
          "text": "Because Hund's rule is arbitrary",
          "correct": false,
          "explanation": "It follows from energy minimisation.",
          "misconception": "rule arbitrary claim"
        },
        {
          "key": "D",
          "text": "Because the energy cost of climbing to the next empty orbital is greater than the repulsion of sharing later",
          "correct": true,
          "explanation": "Pairing is deferred while cheaper single slots exist.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L2::Q4",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L2",
      "stem": "When a fourth electron enters a p sub-shell, what happens?",
      "misconceptionClass": "fourth electron placement",
      "options": [
        {
          "key": "A",
          "text": "It pairs in one of the p orbitals with opposite spin, leaving two singles",
          "correct": true,
          "explanation": "The first three took the empty orbitals; the fourth doubles one.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "It starts a new shell",
          "correct": false,
          "explanation": "The sub-shell has room for six.",
          "misconception": "placement wrong"
        },
        {
          "key": "C",
          "text": "It enters the s orbital of the same shell",
          "correct": false,
          "explanation": "Sub-shell filling completes first.",
          "misconception": "placement wrong"
        },
        {
          "key": "D",
          "text": "It cannot enter - p is full",
          "correct": false,
          "explanation": "p holds six electrons.",
          "misconception": "capacity misread"
        }
      ]
    },
    {
      "id": "rn_YXZBtqvvgTHppc4Q::L2::Q5",
      "moduleId": "rn_YXZBtqvvgTHppc4Q::L2",
      "stem": "Electrons with the same spin repel. What is this called and what does it drive?",
      "misconceptionClass": "repulsion naming",
      "options": [
        {
          "key": "A",
          "text": "Shielding, weakening nuclear pull",
          "correct": false,
          "explanation": "Shielding is a nuclear-attraction effect.",
          "misconception": "term confused"
        },
        {
          "key": "B",
          "text": "Spin-pair repulsion, driving single occupancy before pairing",
          "correct": true,
          "explanation": "The repulsion pushes electrons apart into empty orbitals.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Electron affinity, driving pairing",
          "correct": false,
          "explanation": "Affinity is an attraction concept.",
          "misconception": "term confused"
        },
        {
          "key": "D",
          "text": "Pauli exclusion, forbidding same-spin pairs",
          "correct": false,
          "explanation": "Pauli forbids identical quantum states.",
          "misconception": "rule confused"
        }
      ]
    },
