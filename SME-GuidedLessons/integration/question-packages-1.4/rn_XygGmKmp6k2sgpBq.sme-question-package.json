  "questions": [
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q1",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "As ionic radius increases, lattice energy becomes",
      "misconceptionClass": "radius trend",
      "options": [
        {
          "key": "A",
          "text": "Less exothermic, as the charges sit further apart and attract more weakly",
          "correct": true,
          "explanation": "Distance weakens the electrostatic pull.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "More exothermic",
          "correct": false,
          "explanation": "That is the charge trend, not the radius trend.",
          "misconception": "trend swap"
        },
        {
          "key": "C",
          "text": "Unchanged",
          "correct": false,
          "explanation": "Distance matters directly.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Positive",
          "correct": false,
          "explanation": "The value stays negative throughout.",
          "misconception": "sign slip"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q2",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "Caesium fluoride's lattice energy is less exothermic than potassium fluoride's because",
      "misconceptionClass": "CsF comparison",
      "options": [
        {
          "key": "A",
          "text": "Caesium carries a 2+ charge",
          "correct": false,
          "explanation": "It is 1+.",
          "misconception": "fact slip"
        },
        {
          "key": "B",
          "text": "The Cs+ ion is larger than K+, weakening the attraction to fluoride",
          "correct": true,
          "explanation": "Same anion, bigger cation, softer value.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Caesium is more reactive",
          "correct": false,
          "explanation": "Reactivity is irrelevant here.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "D",
          "text": "Fluoride is smaller in CsF",
          "correct": false,
          "explanation": "The anion is identical in both.",
          "misconception": "fact slip"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q3",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "As ionic charge increases, lattice energy becomes",
      "misconceptionClass": "charge trend",
      "options": [
        {
          "key": "A",
          "text": "Unchanged",
          "correct": false,
          "explanation": "Charge enters the attraction directly.",
          "misconception": "false claim"
        },
        {
          "key": "B",
          "text": "Endothermic",
          "correct": false,
          "explanation": "Formation from gaseous ions always releases energy.",
          "misconception": "sign slip"
        },
        {
          "key": "C",
          "text": "More exothermic, because higher charge density strengthens the attractions",
          "correct": true,
          "explanation": "Charge is the deepening lever.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Less exothermic",
          "correct": false,
          "explanation": "That is the radius trend.",
          "misconception": "trend swap"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q4",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "Calcium oxide's lattice energy is more exothermic than potassium chloride's because",
      "misconceptionClass": "CaO comparison",
      "options": [
        {
          "key": "A",
          "text": "Oxygen is heavier than chlorine",
          "correct": false,
          "explanation": "Mass is irrelevant.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "B",
          "text": "Calcium is a gas",
          "correct": false,
          "explanation": "It is a metal.",
          "misconception": "nonsense claim"
        },
        {
          "key": "C",
          "text": "Potassium fluoride is larger",
          "correct": false,
          "explanation": "Different compound entirely.",
          "misconception": "comparison slip"
        },
        {
          "key": "D",
          "text": "The 2+/2- charges attract far more strongly than 1+/1-, and the smaller ions sit closer",
          "correct": true,
          "explanation": "Both levers point the same way.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q5",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "The attraction between lattice ions acts between",
      "misconceptionClass": "attraction geometry",
      "options": [
        {
          "key": "A",
          "text": "The centres of the ions, so larger ions mean larger centre-to-centre distances",
          "correct": true,
          "explanation": "The centre-to-centre framing is why radius matters.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Their surfaces only",
          "correct": false,
          "explanation": "The centre framing is the model.",
          "misconception": "geometry slip"
        },
        {
          "key": "C",
          "text": "Their electrons exclusively",
          "correct": false,
          "explanation": "The whole ion's charge is the model.",
          "misconception": "geometry slip"
        },
        {
          "key": "D",
          "text": "The lattice edges",
          "correct": false,
          "explanation": "No such edge rule exists.",
          "misconception": "nonsense claim"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q6",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "State the two key factors affecting lattice energy.",
      "misconceptionClass": "factors recall",
      "kind": "recall",
      "modelAnswer": "The charge and the radius of the ions making up the crystalline lattice.",
      "keywords": [
        "charge",
        "radius",
        "lattice"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q7",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "State the lattice-energy comparison between CsF and KF with the reason.",
      "misconceptionClass": "CsF recall",
      "kind": "recall",
      "modelAnswer": "CsF is less exothermic than KF, because Cs+ is larger than K+, weakening the attraction to F-.",
      "keywords": [
        "larger",
        "attraction",
        "exothermic"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q8",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "Explain why higher ionic charge makes lattice energy more exothermic.",
      "misconceptionClass": "charge why",
      "kind": "explain-why",
      "modelAnswer": "Electrostatic attraction grows with the product of the charges, so doubling each ion's charge quadruples the pull; a stronger attraction releases more energy as the lattice forms.",
      "keywords": [
        "charge",
        "attraction",
        "lattice"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L1::Q9",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L1",
      "stem": "Predict which is more exothermic: NaF or NaCl, and justify.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "NaF: the fluoride ion is smaller than chloride, so the Na+ to anion centre-to-centre distance shrinks and the attraction strengthens, deepening the lattice energy.",
      "keywords": [
        "smaller",
        "attraction",
        "strengthens"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q1",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "Hydration enthalpies are exothermic because",
      "misconceptionClass": "hydration sign why",
      "options": [
        {
          "key": "A",
          "text": "The lattice is breaking",
          "correct": false,
          "explanation": "That is the solution side.",
          "misconception": "step mix"
        },
        {
          "key": "B",
          "text": "Energy is released as water molecules bond to the ions",
          "correct": true,
          "explanation": "Forming ion-water attractions releases energy.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Water is consumed",
          "correct": false,
          "explanation": "Water is the solvent, not a reactant consumed.",
          "misconception": "false cause"
        },
        {
          "key": "D",
          "text": "The ions shrink",
          "correct": false,
          "explanation": "Ions do not shrink on hydrating.",
          "misconception": "false cause"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q2",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "The ion feature that most strengthens hydration is",
      "misconceptionClass": "hydration lever",
      "options": [
        {
          "key": "A",
          "text": "A low charge",
          "correct": false,
          "explanation": "Lower charge weakens the pull.",
          "misconception": "inversion slip"
        },
        {
          "key": "B",
          "text": "A full outer shell of electrons",
          "correct": false,
          "explanation": "All ions have those.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "C",
          "text": "High charge density - a small radius or a large charge",
          "correct": true,
          "explanation": "Both raise the pull on water.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "A large radius",
          "correct": false,
          "explanation": "Larger ions grip more weakly.",
          "misconception": "inversion slip"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q3",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "Fluoride's hydration enthalpy is more negative than chloride's because",
      "misconceptionClass": "fluoride case",
      "options": [
        {
          "key": "A",
          "text": "Fluoride is heavier",
          "correct": false,
          "explanation": "Mass is irrelevant.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "B",
          "text": "Chloride repels water",
          "correct": false,
          "explanation": "It attracts it, just less strongly.",
          "misconception": "inversion slip"
        },
        {
          "key": "C",
          "text": "Fluoride carries 2-",
          "correct": false,
          "explanation": "It carries 1-, like chloride.",
          "misconception": "fact slip"
        },
        {
          "key": "D",
          "text": "The smaller F- ion attracts water molecules more strongly",
          "correct": true,
          "explanation": "Charge density falls down the group.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q4",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "Mg2+ hydrates more exothermically than Ba2+ because",
      "misconceptionClass": "magnesium case",
      "options": [
        {
          "key": "A",
          "text": "Mg2+ is smaller, so its charge density and grip on water are greater",
          "correct": true,
          "explanation": "Down Group 2 the grip softens.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Ba2+ carries less charge",
          "correct": false,
          "explanation": "Both are 2+.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "Magnesium is a liquid",
          "correct": false,
          "explanation": "It is a metal.",
          "misconception": "nonsense claim"
        },
        {
          "key": "D",
          "text": "Barium repels water",
          "correct": false,
          "explanation": "It attracts it weakly.",
          "misconception": "inversion slip"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q5",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "Within the ion-dipole picture, the water's hydrogens face",
      "misconceptionClass": "orientation recall",
      "options": [
        {
          "key": "A",
          "text": "Neither end of any ion",
          "correct": false,
          "explanation": "Orientation is the model's core.",
          "misconception": "contradiction"
        },
        {
          "key": "B",
          "text": "Negative ions, attracted to their delta-positive charge",
          "correct": true,
          "explanation": "The oxygen end faces the positive ions.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Positive ions",
          "correct": false,
          "explanation": "The oxygen end takes that job.",
          "misconception": "orientation slip"
        },
        {
          "key": "D",
          "text": "Both equally",
          "correct": false,
          "explanation": "Each end has its partner.",
          "misconception": "geometry slip"
        }
      ]
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q6",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "State the hydration comparison between F- and Cl-.",
      "misconceptionClass": "fluoride recall",
      "kind": "recall",
      "modelAnswer": "Fluoride's hydration enthalpy is more negative than chloride's, since the smaller ion attracts water more strongly.",
      "keywords": [
        "smaller",
        "more",
        "hydration"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q7",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "State the hydration comparison between Mg2+ and Ba2+.",
      "misconceptionClass": "magnesium recall",
      "kind": "recall",
      "modelAnswer": "Mg2+ has the more negative hydration enthalpy, as its higher charge density grips water more tightly.",
      "keywords": [
        "charge",
        "water",
        "hydration"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q8",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "Explain why charge density controls hydration enthalpy.",
      "misconceptionClass": "density why",
      "kind": "explain-why",
      "modelAnswer": "Hydration releases energy in proportion to the ion's pull on water's delta charges; that pull strengthens with concentrated charge - small radius, high charge - so charge density is the controlling quantity.",
      "keywords": [
        "charge",
        "water",
        "hydration"
      ],
      "options": []
    },
    {
      "id": "rn_XygGmKmp6k2sgpBq::L2::Q9",
      "moduleId": "rn_XygGmKmp6k2sgpBq::L2",
      "stem": "Predict which hydrates more exothermically, Li+ or K+, and state the trend across Group 1.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "Li+: the smallest Group 1 cation grips water hardest, and hydration enthalpies grow less negative descending the group as radii swell.",
      "keywords": [
        "smaller",
        "trend",
        "group"
      ],
      "options": []
    }
  ]
}
