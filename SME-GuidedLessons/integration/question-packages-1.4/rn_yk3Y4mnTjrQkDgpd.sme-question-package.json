  "questions": [
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q1",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "When a substance melts, its entropy",
      "misconceptionClass": "melting entropy",
      "options": [
        {
          "key": "A",
          "text": "Increases, as the regular lattice becomes an irregular, mobile arrangement",
          "correct": true,
          "explanation": "Freedom of movement raises the arrangement count.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Decreases, as particles slow down",
          "correct": false,
          "explanation": "Melting increases particle freedom.",
          "misconception": "inversion slip"
        },
        {
          "key": "C",
          "text": "Stays constant",
          "correct": false,
          "explanation": "State changes always shift entropy.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Becomes undefined",
          "correct": false,
          "explanation": "Entropy remains well defined.",
          "misconception": "nonsense claim"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q2",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "Boiling raises entropy more sharply than melting because",
      "misconceptionClass": "boiling jump",
      "options": [
        {
          "key": "A",
          "text": "Gases cannot be ordered at all",
          "correct": false,
          "explanation": "The point is the degree of freedom, not an absolute.",
          "misconception": "overstatement"
        },
        {
          "key": "B",
          "text": "Gas particles move freely and sit far apart, compared with the modest loosening of a lattice",
          "correct": true,
          "explanation": "The liquid-to-gas step is the biggest disorder jump.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Boiling is always exothermic",
          "correct": false,
          "explanation": "Boiling is endothermic, and the size argument stands regardless.",
          "misconception": "fact slip"
        },
        {
          "key": "D",
          "text": "Liquids have no entropy",
          "correct": false,
          "explanation": "Liquids have intermediate entropy.",
          "misconception": "false claim"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q3",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "When a gas condenses, the entropy of the substance",
      "misconceptionClass": "condensing entropy",
      "options": [
        {
          "key": "A",
          "text": "Remains unchanged",
          "correct": false,
          "explanation": "State changes move entropy.",
          "misconception": "false claim"
        },
        {
          "key": "B",
          "text": "Doubles",
          "correct": false,
          "explanation": "No fixed doubling rule exists.",
          "misconception": "invented rule"
        },
        {
          "key": "C",
          "text": "Decreases, as particles are drawn into a more regular arrangement",
          "correct": true,
          "explanation": "Condensing reverses the boiling gain.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Increases sharply",
          "correct": false,
          "explanation": "That describes boiling.",
          "misconception": "inversion slip"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q4",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "The state ladder used to read entropy signs runs",
      "misconceptionClass": "state ladder",
      "options": [
        {
          "key": "A",
          "text": "Gas, liquid, solid upward",
          "correct": false,
          "explanation": "That inverts the ladder.",
          "misconception": "inversion slip"
        },
        {
          "key": "B",
          "text": "Solid, gas, liquid",
          "correct": false,
          "explanation": "Gas sits above liquid.",
          "misconception": "ladder slip"
        },
        {
          "key": "C",
          "text": "Alphabetical by state name",
          "correct": false,
          "explanation": "The ladder is physical, not lexical.",
          "misconception": "nonsense claim"
        },
        {
          "key": "D",
          "text": "Solid, liquid, gas in order of increasing entropy",
          "correct": true,
          "explanation": "Each step up grants more particle freedom.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q5",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "Raising the temperature of a solid below its melting point",
      "misconceptionClass": "warming solid",
      "options": [
        {
          "key": "A",
          "text": "Increases its entropy gradually as particles vibrate more widely",
          "correct": true,
          "explanation": "Even before melting, disorder grows with warmth.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Leaves entropy unchanged until melting",
          "correct": false,
          "explanation": "Disorder rises continuously with temperature.",
          "misconception": "false claim"
        },
        {
          "key": "C",
          "text": "Decreases entropy",
          "correct": false,
          "explanation": "Warmth never orders a substance.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "Changes its state immediately",
          "correct": false,
          "explanation": "Melting waits for the melting point.",
          "misconception": "false claim"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q6",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "State the entropy direction for melting and for freezing.",
      "misconceptionClass": "melting recall",
      "kind": "recall",
      "modelAnswer": "Melting increases entropy; freezing decreases it.",
      "keywords": [
        "melting",
        "freezing",
        "entropy"
      ],
      "options": []
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q7",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "State which state change produces the largest entropy increase.",
      "misconceptionClass": "largest recall",
      "kind": "recall",
      "modelAnswer": "Boiling, the liquid-to-gas change, produces the significant entropy increase.",
      "keywords": [
        "boiling",
        "gas",
        "produces"
      ],
      "options": []
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q8",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "Explain why boiling raises entropy more than melting does.",
      "misconceptionClass": "boiling why",
      "kind": "explain-why",
      "modelAnswer": "Melting frees particles to slide within a still-crowded liquid, while boiling removes the crowding entirely: gas particles range freely and far apart, multiplying positional arrangements by far more.",
      "keywords": [
        "particles",
        "gas",
        "melting"
      ],
      "options": []
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L1::Q9",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L1",
      "stem": "A reaction turns one mole of solid and one mole of gas into two moles of solid. Predict the entropy sign and justify from the ladder.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "The gas is lost and a solid is gained, so the change descends the ladder and the entropy change is negative.",
      "keywords": [
        "solid",
        "gas",
        "entropy"
      ],
      "options": []
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L2::Q1",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L2",
      "stem": "The thermal decomposition of calcium carbonate raises entropy because",
      "misconceptionClass": "carbonate entropy",
      "options": [
        {
          "key": "A",
          "text": "The reaction is exothermic",
          "correct": false,
          "explanation": "The sign of delta H is not the entropy reason.",
          "misconception": "topic mix"
        },
        {
          "key": "B",
          "text": "A gas, carbon dioxide, is formed from a solid reactant",
          "correct": true,
          "explanation": "Gas formation multiplies the arrangements sharply.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The solid melts first",
          "correct": false,
          "explanation": "No melting occurs in this decomposition.",
          "misconception": "false claim"
        },
        {
          "key": "D",
          "text": "Calcium oxide is a liquid",
          "correct": false,
          "explanation": "It is a solid.",
          "misconception": "fact slip"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L2::Q2",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L2",
      "stem": "Dissolving ammonium nitrate in water is endothermic with delta H of",
      "misconceptionClass": "ammonium nitrate value",
      "options": [
        {
          "key": "A",
          "text": "+257 kJ mol^-1",
          "correct": false,
          "explanation": "A magnitude slip of ten.",
          "misconception": "magnitude slip"
        },
        {
          "key": "B",
          "text": "0 kJ mol^-1",
          "correct": false,
          "explanation": "The temperature drop proves a nonzero value.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "+25.7 kJ mol^-1",
          "correct": true,
          "explanation": "The dissolution takes in energy.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "-25.7 kJ mol^-1",
          "correct": false,
          "explanation": "The minus sign would mean exothermic.",
          "misconception": "sign slip"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L2::Q3",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L2",
      "stem": "When an ionic solid dissolves, the overall entropy change is hard to predict because",
      "misconceptionClass": "dissolving balance",
      "options": [
        {
          "key": "A",
          "text": "Solids have no entropy",
          "correct": false,
          "explanation": "Solids have low but real entropy.",
          "misconception": "false claim"
        },
        {
          "key": "B",
          "text": "Water is always ordered",
          "correct": false,
          "explanation": "Water's order only changes where ions impose it.",
          "misconception": "overstatement"
        },
        {
          "key": "C",
          "text": "Ions cannot move in solution",
          "correct": false,
          "explanation": "Ions move freely once dissolved.",
          "misconception": "contradiction"
        },
        {
          "key": "D",
          "text": "Lattice bonds breaking raise disorder while solvent bonds forming lower it",
          "correct": true,
          "explanation": "Two opposing effects decide the net sign.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L2::Q4",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L2",
      "stem": "Ethanoic acid reacting with ammonium carbonate is notable because",
      "misconceptionClass": "ethanoic case",
      "options": [
        {
          "key": "A",
          "text": "It is endothermic yet its entropy still rises, since solution and gas form from a solid",
          "correct": true,
          "explanation": "Disorder rises even as temperature falls.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "It is exothermic and disorder falls",
          "correct": false,
          "explanation": "Both claims are inverted.",
          "misconception": "inversion slip"
        },
        {
          "key": "C",
          "text": "It produces no gas",
          "correct": false,
          "explanation": "Carbon dioxide is produced.",
          "misconception": "fact slip"
        },
        {
          "key": "D",
          "text": "It proves entropy never rises endothermically",
          "correct": false,
          "explanation": "This case proves the opposite.",
          "misconception": "contradiction"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L2::Q5",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L2",
      "stem": "A gas molecule carries more disorder than the solid it came from chiefly because",
      "misconceptionClass": "gas disorder",
      "options": [
        {
          "key": "A",
          "text": "It is coloured",
          "correct": false,
          "explanation": "Colour is irrelevant.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "B",
          "text": "It moves constantly through space rather than vibrating in a fixed site",
          "correct": true,
          "explanation": "Freedom of position is the disorder measure.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "It is heavier",
          "correct": false,
          "explanation": "Mass is irrelevant to disorder.",
          "misconception": "irrelevant claim"
        },
        {
          "key": "D",
          "text": "It is colder",
          "correct": false,
          "explanation": "Gases from decomposition are not colder.",
          "misconception": "fact slip"
        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L2::Q6",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L2",
      "stem": "State the entropy change when calcium carbonate decomposes thermally.",
      "misconceptionClass": "carbonate recall",
