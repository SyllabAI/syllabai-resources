        },
        {
          "key": "B",
          "text": "The reaction is exothermic",
          "correct": false,
          "explanation": "It is endothermic.",
          "misconception": "fact slip"
        },
        {
          "key": "C",
          "text": "Solids have high entropy",
          "correct": false,
          "explanation": "Solids have the lowest entropy.",
          "misconception": "inversion slip"
        },
        {
          "key": "D",
          "text": "The paste is coloured",
