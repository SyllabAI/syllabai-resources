        }
      ]
    },
    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L3::Q4",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L3",
      "stem": "The lesson of the cold-paste reaction is that feasibility depends on",
