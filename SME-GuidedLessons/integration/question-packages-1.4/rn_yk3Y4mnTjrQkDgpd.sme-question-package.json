    {
      "id": "rn_yk3Y4mnTjrQkDgpd::L3::Q8",
      "moduleId": "rn_yk3Y4mnTjrQkDgpd::L3",
      "stem": "Explain why two reacting solids can produce a large entropy rise.",
      "misconceptionClass": "solids entropy why",
      "kind": "explain-why",
      "modelAnswer": "Solids lock particles into fixed, low-arrangement positions; when the products include a gas and a liquid, the particles gain free movement and the arrangement count multiplies enormously, outweighing the solids' lost order.",
