          "explanation": "States set the entropy term.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Enthalpy alone",
          "correct": false,
          "explanation": "Enthalpy alone would forbid the reaction.",
          "misconception": "half truth"
