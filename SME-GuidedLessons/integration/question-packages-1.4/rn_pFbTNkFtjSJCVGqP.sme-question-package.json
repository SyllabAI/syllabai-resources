      "options": [
        {
          "key": "A",
          "text": "The quantity is a difference of two readings, and adding measurements adds their absolute uncertainties",
          "correct": true,
          "explanation": "Initial minus final doubles the exposure.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Burettes are inherently twice as inaccurate",
          "correct": false,
          "explanation": "The doubling comes from the subtraction, not the instrument.",
          "misconception": "instrument myth"
        },
        {
          "key": "C",
          "text": "The meniscus is read twice per line",
          "correct": false,
          "explanation": "One meniscus reading per reading.",
          "misconception": "mechanism wrong"
        },
        {
          "key": "D",
          "text": "Uncertainties multiply on subtraction",
          "correct": false,
          "explanation": "They add, not multiply.",
          "misconception": "operation wrong"
        }
      ]
    },
