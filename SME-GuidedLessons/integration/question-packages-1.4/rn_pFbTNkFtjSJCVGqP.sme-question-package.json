    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q1",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "Which colour does methyl orange show in alkali?",
      "misconceptionClass": "table recall",
      "options": [
        {
          "key": "A",
          "text": "Yellow",
          "correct": true,
          "explanation": "Methyl orange runs red in acid and yellow in alkali.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Blue",
          "correct": false,
          "explanation": "Blue is litmus's alkali colour.",
          "misconception": "indicator confused"
        },
        {
          "key": "C",
          "text": "Pink",
          "correct": false,
          "explanation": "Pink is phenolphthalein's alkali colour.",
          "misconception": "indicator confused"
        },
        {
          "key": "D",
          "text": "Colourless",
          "correct": false,
          "explanation": "Colourless is phenolphthalein's acid form.",
          "misconception": "pair confused"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q2",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "Why can litmus not be used successfully in a titration?",
      "misconceptionClass": "litmus failure",
      "options": [
        {
          "key": "A",
          "text": "It only works in alkali",
          "correct": false,
          "explanation": "Litmus responds across the whole range.",
          "misconception": "range myth"
        },
        {
          "key": "B",
          "text": "Its colour change is too gradual to mark the equivalence point sharply",
          "correct": true,
          "explanation": "Titration endpoints need an abrupt flip.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "It is not a weak acid or base",
          "correct": false,
          "explanation": "Litmus is one; the gradualism is the problem.",
          "misconception": "class misstated"
        },
        {
          "key": "D",
          "text": "It dissolves the analyte",
          "correct": false,
          "explanation": "Indicators never consume the sample.",
          "misconception": "nonsense"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q3",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "Why is phenolphthalein usually better in the burette?",
      "misconceptionClass": "placement reasoning",
      "options": [
        {
          "key": "A",
          "text": "It reacts with the burette glass",
          "correct": false,
          "explanation": "No such reaction occurs.",
          "misconception": "nonsense"
        },
        {
          "key": "B",
          "text": "Its colours reverse in the burette",
          "correct": false,
          "explanation": "The colour pair never reverses.",
          "misconception": "nonsense"
        },
        {
          "key": "C",
          "text": "A sudden, permanent appearance of pink is easier to see than pink fading to colourless",
          "correct": true,
          "explanation": "Appearance beats disappearance for endpoint spotting.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "It is more accurate in that position",
          "correct": false,
          "explanation": "Accuracy is chemical, not positional.",
          "misconception": "accuracy myth"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q4",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "What chemical class do indicators belong to?",
      "misconceptionClass": "indicator class",
      "options": [
        {
          "key": "A",
          "text": "Strong acids",
          "correct": false,
          "explanation": "Strong acids never switch colour reversibly.",
          "misconception": "class wrong"
        },
        {
          "key": "B",
          "text": "Metal salts",
          "correct": false,
          "explanation": "Salts are not the indicator family.",
          "misconception": "class wrong"
        },
        {
          "key": "C",
          "text": "Neutral hydrocarbons",
          "correct": false,
          "explanation": "Hydrocarbons carry no switching chemistry.",
          "misconception": "class wrong"
        },
        {
          "key": "D",
          "text": "Weak acids and bases with differently coloured conjugate forms",
          "correct": true,
          "explanation": "The colour switch is the conjugate pair changing places.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q5",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "What drives an indicator's colour change?",
      "misconceptionClass": "driver",
      "options": [
        {
          "key": "A",
          "text": "The concentration of hydrogen ions in the solution",
          "correct": true,
          "explanation": "H+ level selects which conjugate form dominates.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Temperature alone",
          "correct": false,
          "explanation": "Temperature is not the switching driver here.",
          "misconception": "driver wrong"
        },
        {
          "key": "C",
          "text": "Light intensity",
          "correct": false,
          "explanation": "Light does not shift the equilibrium.",
          "misconception": "driver wrong"
        },
        {
          "key": "D",
          "text": "The volume of the flask",
          "correct": false,
          "explanation": "Flask size is irrelevant.",
          "misconception": "nonsense"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q6",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "State the colour pair for phenolphthalein.",
      "misconceptionClass": "pair recall",
      "kind": "recall",
      "modelAnswer": "Phenolphthalein is colourless in acid and pink in alkali.",
      "keywords": [
        "colourless",
