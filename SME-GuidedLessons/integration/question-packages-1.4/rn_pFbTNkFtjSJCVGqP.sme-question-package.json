        "phenolphthalein"
      ],
      "options": []
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q7",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "Define what an acid-base indicator does.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "An indicator gives information about the change in chemical environment by changing colour reversibly with the hydrogen ion concentration.",
      "keywords": [
        "reversibly",
        "colour",
        "environment"
      ],
      "options": []
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q8",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "Explain why a sharp colour change at the equivalence point is the defining property of a good titration indicator.",
      "misconceptionClass": "sharpness reasoning",
      "kind": "explain-why",
      "modelAnswer": "The endpoint must be read in a single drop's worth of added reagent, so only an indicator whose transition sits inside the steep pH jump delivers an endpoint that matches the equivalence point.",
      "keywords": [
        "sharp",
        "equivalence",
        "transition"
      ],
      "options": []
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L1::Q9",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L1",
      "stem": "A titration needs an indicator switching between pH 3 and 10 is impossible, but one switching sharply near pH 9 works for a weak acid-strong base pair. Which indicator fits, by colour pair?",
      "misconceptionClass": "selection application",
      "kind": "application",
      "modelAnswer": "Phenolphthalein fits: it is colourless in acid and flips to pink sharply in the alkaline region.",
      "keywords": [
        "phenolphthalein",
        "pink",
        "sharp"
      ],
      "options": []
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L2::Q1",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L2",
      "stem": "How do you convert 25.0 cm3 to dm3?",
      "misconceptionClass": "unit conversion",
      "options": [
        {
          "key": "A",
          "text": "Leave it unchanged",
          "correct": false,
          "explanation": "Units must match before multiplying.",
          "misconception": "conversion denied"
        },
        {
          "key": "B",
          "text": "Divide by 1000 to get 0.025 dm3",
          "correct": true,
          "explanation": "One dm3 holds 1000 cm3.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Multiply by 1000",
          "correct": false,
          "explanation": "That inflates the volume a thousandfold.",
          "misconception": "direction wrong"
        },
        {
          "key": "D",
          "text": "Divide by 100",
          "correct": false,
          "explanation": "The factor is 1000, not 100.",
          "misconception": "factor wrong"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L2::Q2",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L2",
      "stem": "In Na2CO3 + 2HCl -> 2NaCl + H2O + CO2, what moles of HCl react per mole of sodium carbonate?",
      "misconceptionClass": "stoichiometry",
      "options": [
        {
          "key": "A",
          "text": "0.5 moles",
          "correct": false,
          "explanation": "That inverts the ratio.",
          "misconception": "ratio inverted"
        },
        {
          "key": "B",
          "text": "3 moles",
          "correct": false,
          "explanation": "No coefficient 3 appears.",
          "misconception": "invented ratio"
        },
        {
          "key": "C",
          "text": "2 moles",
          "correct": true,
          "explanation": "The balanced equation's ratio is 1:2.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "1 mole",
          "correct": false,
          "explanation": "The coefficient 2 on HCl forbids that.",
          "misconception": "ratio misread"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L2::Q3",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L2",
      "stem": "A titre of 20.00 cm3 of acid neutralises 0.00125 mol of sodium carbonate at ratio 1:2. What moles of acid reacted?",
      "misconceptionClass": "mole scaling",
      "options": [
        {
          "key": "A",
          "text": "0.00125 mol",
          "correct": false,
          "explanation": "That ignores the 1:2 ratio.",
          "misconception": "ratio ignored"
        },
        {
          "key": "B",
          "text": "0.000625 mol",
          "correct": false,
          "explanation": "That halves instead of doubling.",
          "misconception": "direction flipped"
        },
        {
          "key": "C",
          "text": "0.025 mol",
          "correct": false,
          "explanation": "That is the volume in dm3, not the moles.",
          "misconception": "quantity confused"
        },
        {
          "key": "D",
