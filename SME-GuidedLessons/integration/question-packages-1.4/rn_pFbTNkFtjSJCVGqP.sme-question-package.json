    {
      "id": "rn_pFbTNkFtjSJCVGqP::L3::Q1",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L3",
      "stem": "How is percentage uncertainty calculated?",
      "misconceptionClass": "formula recall",
      "options": [
        {
          "key": "A",
          "text": "Measured value divided by total uncertainty",
          "correct": false,
          "explanation": "The division is inverted.",
          "misconception": "inverted"
        },
        {
          "key": "B",
          "text": "Uncertainty squared",
          "correct": false,
          "explanation": "No squaring appears in the formula.",
          "misconception": "nonsense"
        },
        {
          "key": "C",
          "text": "Total uncertainty divided by measured value, times 100",
          "correct": true,
          "explanation": "That is the definition.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Literature value divided by measured value",
          "correct": false,
          "explanation": "That mixes error with uncertainty.",
          "misconception": "definition confused"
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L3::Q2",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L3",
      "stem": "What is percentage error?",
      "misconceptionClass": "error definition",
      "options": [
        {
          "key": "A",
          "text": "The same as percentage uncertainty",
          "correct": false,
          "explanation": "The two quantities are distinct.",
          "misconception": "conflation"
        },
        {
          "key": "B",
          "text": "The spread of repeated readings",
          "correct": false,
          "explanation": "That describes precision, not error.",
          "misconception": "concept swapped"
        },
        {
          "key": "C",
          "text": "Half the uncertainty",
          "correct": false,
          "explanation": "No such relation exists.",
          "misconception": "nonsense"
        },
        {
          "key": "D",
          "text": "A comparison of a result with a literature value",
          "correct": true,
          "explanation": "Error measures agreement with the accepted figure.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_pFbTNkFtjSJCVGqP::L3::Q3",
      "moduleId": "rn_pFbTNkFtjSJCVGqP::L3",
      "stem": "Why does a burette titre carry twice the single-reading uncertainty?",
