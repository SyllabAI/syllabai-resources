        "2Li2O",
        "O2"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q7",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "State the gas test for nitrogen dioxide's acidity.",
      "misconceptionClass": "NO2 recall",
      "kind": "recall",
      "modelAnswer": "Dissolved in water, NO2 gives an acidic solution, forming 2HNO3 plus HNO2 from 2NO2 + H2O.",
      "keywords": [
        "acidic",
        "water",
        "NO2"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q8",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "Explain why the same polarising argument covers both carbonates and nitrates.",
      "misconceptionClass": "generality reasoning",
      "kind": "explain-why",
      "modelAnswer": "Both anions are large, delocalised species; small cations distort either one, so thermal stability rises down both groups for the same physical reason.",
      "keywords": [
        "anions",
        "distort",
        "stability"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q9",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "Balance the full-integer form of magnesium nitrate's decomposition: Mg(NO3)2 -> MgO + 2NO2 + ?O2.",
      "misconceptionClass": "balance application",
      "kind": "application",
      "modelAnswer": "The oxygen census 6 = 1 + 4 + 1 fixes the last coefficient at 1/2, or doubled: 2Mg(NO3)2 -> 2MgO + 4NO2 + O2.",
      "keywords": [
        "1/2",
        "census",
        "coefficient"
      ],
      "options": []
    }
  ]
}
