  "questions": [
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q1",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "Which Group 1 carbonate decomposes at Bunsen temperatures?",
      "misconceptionClass": "lone decomposer",
      "options": [
        {
          "key": "A",
          "text": "Lithium carbonate",
          "correct": true,
          "explanation": "Li2CO3 cracks to Li2O and CO2.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Sodium carbonate",
          "correct": false,
          "explanation": "It holds firm at Bunsen temperatures.",
          "misconception": "member wrong"
        },
        {
          "key": "C",
          "text": "Potassium carbonate",
          "correct": false,
          "explanation": "It is even more stable than sodium's.",
          "misconception": "member wrong"
        },
        {
          "key": "D",
          "text": "None of them",
          "correct": false,
          "explanation": "Lithium's is the exception that does crack.",
          "misconception": "exception denied"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q2",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "What are the products of Group 2 carbonate decomposition?",
      "misconceptionClass": "product pair",
      "options": [
        {
          "key": "A",
          "text": "The metal and carbon",
          "correct": false,
          "explanation": "Carbonates never reduce that far.",
          "misconception": "overstatement"
        },
        {
          "key": "B",
          "text": "The metal oxide and carbon dioxide",
          "correct": true,
          "explanation": "XCO3 -> XO + CO2.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The metal hydroxide and CO2",
          "correct": false,
          "explanation": "No water participates in the decomposition.",
          "misconception": "product wrong"
        },
        {
          "key": "D",
          "text": "The metal nitrate and oxygen",
          "correct": false,
          "explanation": "That is the nitrate family.",
          "misconception": "family confused"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q3",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "How does the decomposition temperature trend down Group 2?",
      "misconceptionClass": "temperature trend",
      "options": [
        {
          "key": "A",
          "text": "All decompose identically",
          "correct": false,
          "explanation": "The temperatures clearly differ.",
          "misconception": "uniformity myth"
        },
        {
          "key": "B",
          "text": "Only magnesium decomposes",
          "correct": false,
          "explanation": "Every Group 2 carbonate decomposes with enough heat.",
          "misconception": "scope myth"
        },
        {
          "key": "C",
          "text": "More heat is needed going down",
          "correct": true,
          "explanation": "Larger cations protect their carbonates.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Less heat is needed going down",
          "correct": false,
          "explanation": "The bill climbs, not falls.",
          "misconception": "direction wrong"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q4",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "Why does lithium carbonate decompose while sodium carbonate does not?",
      "misconceptionClass": "lithium exception",
      "options": [
        {
          "key": "A",
          "text": "Lithium carbonate is lighter",
          "correct": false,
          "explanation": "Mass does not set stability.",
          "misconception": "mass myth"
        },
        {
          "key": "B",
          "text": "Sodium carbonate is covalent",
          "correct": false,
          "explanation": "Both are ionic salts.",
          "misconception": "bonding myth"
        },
        {
          "key": "C",
          "text": "Lithium's carbonate contains water",
          "correct": false,
          "explanation": "It is an anhydrous salt.",
          "misconception": "hydrate myth"
        },
        {
          "key": "D",
          "text": "Lithium's small cation polarises the carbonate ion more strongly",
          "correct": true,
          "explanation": "High polarising power destabilises the anion.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q5",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "What general equation covers the Group 2 carbonates?",
      "misconceptionClass": "general equation",
      "options": [
        {
          "key": "A",
          "text": "XCO3 -> XO + CO2 with heat",
          "correct": true,
          "explanation": "One carbonate yields one oxide plus one CO2.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "XCO3 -> XC + O2",
          "correct": false,
          "explanation": "No such cleavage occurs.",
          "misconception": "nonsense"
        },
        {
          "key": "C",
          "text": "2XCO3 -> 2XO + 2CO2 only",
          "correct": false,
          "explanation": "The per-formula equation is the general form.",
          "misconception": "form quibble"
        },
        {
          "key": "D",
          "text": "XCO3 + H2O -> X(OH)2 + CO2",
          "correct": false,
          "explanation": "Water plays no role here.",
          "misconception": "reagent confusion"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q6",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "Write the equation for lithium carbonate's decomposition.",
      "misconceptionClass": "Li recall",
      "kind": "recall",
      "modelAnswer": "Li2CO3 (s) -> Li2O (s) + CO2 (g) under heat.",
      "keywords": [
        "Li2CO3",
        "Li2O",
        "CO2"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q7",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "State what happens to the decomposition temperatures down both groups.",
      "misconceptionClass": "trend recall",
      "kind": "recall",
      "modelAnswer": "The decomposition temperatures increase going down both groups, so more heat is needed for the heavier members.",
      "keywords": [
        "increase",
        "down",
        "heat"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q8",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "Explain why small cations destabilise carbonates more than large ones.",
      "misconceptionClass": "polarising reasoning",
      "kind": "explain-why",
      "modelAnswer": "A small, highly charged cation polarises the carbonate ion, drawing its delocalised electrons toward itself and weakening the anion's internal bonds, so the carbonate cracks apart at lower temperature.",
      "keywords": [
        "small",
        "polarise",
        "weakening"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L1::Q9",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L1",
      "stem": "Magnesium carbonate decomposes per MgCO3 -> MgO + CO2. What mass of CO2 (M = 44) escapes from 8.4 g of MgCO3 (M = 84)?",
      "misconceptionClass": "mass application",
      "kind": "application",
      "modelAnswer": "8.4 g is 0.1 mol of carbonate, releasing 0.1 mol of CO2, which is 4.4 g.",
      "keywords": [
        "4.4",
        "0.1",
        "CO2"
      ],
      "options": []
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q1",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "Which products form when lithium nitrate decomposes?",
      "misconceptionClass": "LiNO3 products",
      "options": [
        {
          "key": "A",
          "text": "Lithium oxide and nitrogen monoxide",
          "correct": false,
          "explanation": "The gas is NO2, not NO.",
          "misconception": "gas confused"
        },
        {
          "key": "B",
          "text": "Lithium oxide, nitrogen dioxide and oxygen",
          "correct": true,
          "explanation": "The full decomposition mirrors Group 2.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Lithium nitrite and oxygen only",
          "correct": false,
          "explanation": "That is the heavier Group 1 route.",
          "misconception": "route confused"
        },
        {
          "key": "D",
          "text": "Lithium carbonate and oxygen",
          "correct": false,
          "explanation": "No carbonate appears.",
          "misconception": "product invented"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q2",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "What does 2XNO3 -> 2XNO2 + O2 describe?",
      "misconceptionClass": "nitrite route",
      "options": [
        {
          "key": "A",
          "text": "Lithium nitrate",
          "correct": false,
          "explanation": "Lithium takes the full route.",
          "misconception": "member confused"
        },
        {
          "key": "B",
          "text": "All nitrates universally",
          "correct": false,
          "explanation": "The three routes differ.",
          "misconception": "uniformity myth"
        },
        {
          "key": "C",
          "text": "The decomposition of Group 1 nitrates from sodium to caesium",
          "correct": true,
          "explanation": "The nitrite-plus-oxygen route belongs to the middle alkali metals.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Group 2 nitrates",
          "correct": false,
          "explanation": "Group 2 goes all the way to the oxide plus NO2.",
          "misconception": "family confused"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q3",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "Why are nitrate decompositions carried out in a fume cupboard?",
      "misconceptionClass": "safety reason",
      "options": [
        {
          "key": "A",
          "text": "Oxygen feeds fires",
          "correct": false,
          "explanation": "Oxygen release is a hazard but not the named reason.",
          "misconception": "partial reason"
        },
        {
          "key": "B",
          "text": "The nitrates are radioactive",
          "correct": false,
          "explanation": "No radioactivity is involved.",
          "misconception": "nonsense"
        },
        {
          "key": "C",
          "text": "The nitrites smell strongly",
          "correct": false,
          "explanation": "The named hazard is the NO2.",
          "misconception": "reason confused"
        },
        {
          "key": "D",
          "text": "Nitrogen dioxide is a toxic brown gas",
          "correct": true,
          "explanation": "The fume cupboard carries it away.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q4",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "What does carbon dioxide do to limewater?",
      "misconceptionClass": "CO2 test",
      "options": [
        {
          "key": "A",
          "text": "Turns it milky through fine calcium carbonate precipitate",
          "correct": true,
          "explanation": "The white suspension is the positive test.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Turns it blue",
          "correct": false,
          "explanation": "Blue belongs to litmus in alkali.",
          "misconception": "colour wrong"
        },
        {
          "key": "C",
          "text": "Releases oxygen",
          "correct": false,
          "explanation": "The CO2 is absorbed, not decomposed.",
          "misconception": "direction wrong"
        },
        {
          "key": "D",
          "text": "Nothing, limewater ignores CO2",
          "correct": false,
          "explanation": "The milky turn is textbook.",
          "misconception": "denial"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q5",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "Which observation identifies oxygen gas?",
      "misconceptionClass": "O2 test",
      "options": [
        {
          "key": "A",
          "text": "It turns damp litmus red",
          "correct": false,
          "explanation": "That marks acidic gases.",
          "misconception": "test wrong"
        },
        {
          "key": "B",
          "text": "It relights a glowing splint",
          "correct": true,
          "explanation": "The reigniting splint is the oxygen fingerprint.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "It turns limewater milky",
          "correct": false,
          "explanation": "That is CO2's test.",
          "misconception": "test swapped"
        },
        {
          "key": "D",
          "text": "It smells sharply",
          "correct": false,
          "explanation": "Oxygen is odourless.",
          "misconception": "sense wrong"
        }
      ]
    },
    {
      "id": "rn_dTh7m5D2Yw4xCY7D::L2::Q6",
      "moduleId": "rn_dTh7m5D2Yw4xCY7D::L2",
      "stem": "Write the equation for thermal decomposition of lithium nitrate.",
      "misconceptionClass": "equation recall",
      "kind": "recall",
      "modelAnswer": "4LiNO3 (s) -> 2Li2O (s) + 4NO2 (g) + O2 (g).",
      "keywords": [
