    {
      "id": "rn_VP3jR4bvMZQTK4bx::L1::Q1",
      "moduleId": "rn_VP3jR4bvMZQTK4bx::L1",
      "stem": "What solution results when sodium oxide reacts with water?",
      "misconceptionClass": "solution character",
      "options": [
        {
          "key": "A",
          "text": "A colourless alkaline solution of sodium hydroxide",
          "correct": true,
          "explanation": "The released OH- makes it alkaline.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "A colourless acidic solution",
          "correct": false,
          "explanation": "The oxide is basic, not acidic.",
          "misconception": "character flipped"
        },
        {
          "key": "C",
          "text": "A white precipitate of sodium oxide",
          "correct": false,
          "explanation": "Sodium compounds stay dissolved.",
          "misconception": "state wrong"
        },
        {
          "key": "D",
          "text": "A neutral solution",
          "correct": false,
          "explanation": "Hydroxide release forbids neutrality.",
          "misconception": "character wrong"
        }
      ]
    },
    {
      "id": "rn_VP3jR4bvMZQTK4bx::L1::Q2",
      "moduleId": "rn_VP3jR4bvMZQTK4bx::L1",
      "stem": "Which ionic equation captures the oxide-in-water step?",
      "misconceptionClass": "ionic step",
      "options": [
        {
          "key": "A",
          "text": "O2- + OH- -> O2H3-",
          "correct": false,
          "explanation": "No such species exists.",
          "misconception": "invented species"
        },
        {
          "key": "B",
          "text": "O2- + H2O -> 2OH-",
          "correct": true,
          "explanation": "The oxide ion protonates once and splits into two hydroxides.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "O2- + 2H+ -> H2O",
          "correct": false,
          "explanation": "That is neutralisation, not the water reaction.",
          "misconception": "equation confused"
        },
        {
          "key": "D",
          "text": "O2- + H2O -> O2 + H2",
          "correct": false,
          "explanation": "No gas pair forms here.",
          "misconception": "nonsense"
        }
      ]
    },
    {
      "id": "rn_VP3jR4bvMZQTK4bx::L1::Q3",
      "moduleId": "rn_VP3jR4bvMZQTK4bx::L1",
      "stem": "What are the products when sodium hydroxide meets dilute sulfuric acid?",
      "misconceptionClass": "acid pair products",
      "options": [
        {
          "key": "A",
          "text": "Sodium sulfite and water",
          "correct": false,
          "explanation": "Sulfite implies SO3 2-, not the sulfate.",
          "misconception": "anion confused"
        },
        {
          "key": "B",
          "text": "Sodium hydride and oxygen",
          "correct": false,
          "explanation": "No such swap occurs.",
          "misconception": "nonsense"
        },
        {
          "key": "C",
          "text": "Sodium sulfate and water",
          "correct": true,
          "explanation": "The sulfate salt plus the neutralisation water.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Sodium sulfate and hydrogen",
          "correct": false,
          "explanation": "Hydrogen needs a metal above it in the series, not an acid-base pair.",
          "misconception": "gas invented"
        }
      ]
    },
    {
      "id": "rn_VP3jR4bvMZQTK4bx::L1::Q4",
      "moduleId": "rn_VP3jR4bvMZQTK4bx::L1",
      "stem": "Why is the NaOH + HCl equation a neutralisation?",
      "misconceptionClass": "neutralisation logic",
      "options": [
        {
          "key": "A",
          "text": "Both reactants are neutral",
          "correct": false,
          "explanation": "NaOH is an alkali.",
          "misconception": "premise wrong"
        },
        {
          "key": "B",
          "text": "A gas drives the reaction",
          "correct": false,
          "explanation": "No gas forms here.",
          "misconception": "driver wrong"
        },
        {
          "key": "C",
          "text": "Electrons transfer",
          "correct": false,
          "explanation": "Acid-base chemistry transfers protons, not electrons.",
          "misconception": "domain confusion"
        },
        {
          "key": "D",
          "text": "The alkali's hydroxide meets the acid's hydrogen ion to form water and a salt",
          "correct": true,
          "explanation": "That pairing is the neutralisation definition.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_VP3jR4bvMZQTK4bx::L1::Q5",
      "moduleId": "rn_VP3jR4bvMZQTK4bx::L1",
      "stem": "How many moles of NaOH neutralise one mole of H2SO4?",
      "misconceptionClass": "capacity check",
      "options": [
        {
          "key": "A",
          "text": "Two",
          "correct": true,
          "explanation": "The diprotic acid needs two hydroxides.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "One",
          "correct": false,
          "explanation": "One hydroxide seats only one proton.",
          "misconception": "undercount"
        },
        {
          "key": "C",
          "text": "Three",
          "correct": false,
          "explanation": "No third proton exists.",
          "misconception": "overcount"
        },
        {
          "key": "D",
          "text": "Zero",
          "correct": false,
          "explanation": "Neutralisation clearly runs.",
          "misconception": "denial"
        }
      ]
    },
    {
