    },
    {
      "id": "rn_VP3jR4bvMZQTK4bx::L1::Q8",
      "moduleId": "rn_VP3jR4bvMZQTK4bx::L1",
      "stem": "Explain why the oxide solution is alkaline.",
      "misconceptionClass": "alkalinity reasoning",
      "kind": "explain-why",
      "modelAnswer": "The oxide ion abstracts protons from water, releasing free hydroxide ions; any solution carrying excess OH- is alkaline by definition.",
