  "questions": [
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q1",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "What must every member of a homologous series share?",
      "misconceptionClass": "series shared trait",
      "options": [
        {
          "key": "A",
          "text": "The same functional group",
          "correct": true,
          "explanation": "That is the defining membership test.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The same number of carbon atoms",
          "correct": false,
          "explanation": "Members differ by CH2, so carbon counts grow.",
          "misconception": "trait mispicked"
        },
        {
          "key": "C",
          "text": "The same boiling point",
          "correct": false,
          "explanation": "Physical properties change gradually, not identically.",
          "misconception": "trait mispicked"
        },
        {
          "key": "D",
          "text": "The same density",
          "correct": false,
          "explanation": "Density shifts as molecules grow.",
          "misconception": "trait mispicked"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q2",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "By how much does each successive member of a homologous series differ?",
      "misconceptionClass": "CH2 increment",
      "options": [
        {
          "key": "A",
          "text": "By nothing - members are identical",
          "correct": false,
          "explanation": "Members differ by CH2.",
          "misconception": "difference denied"
        },
        {
          "key": "B",
          "text": "By one CH2 unit",
          "correct": true,
          "explanation": "The definitional increment of the family.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "By one CH3 unit",
          "correct": false,
          "explanation": "No CH3 increment exists in the definition.",
          "misconception": "increment wrong"
        },
        {
          "key": "D",
          "text": "By one carbon atom alone",
          "correct": false,
          "explanation": "The step adds carbon AND two hydrogens together.",
          "misconception": "increment incomplete"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q3",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "What happens to physical properties as a homologous series is ascended?",
      "misconceptionClass": "property drift direction",
      "options": [
        {
          "key": "A",
          "text": "They change randomly from member to member",
          "correct": false,
          "explanation": "The change is gradual and systematic.",
          "misconception": "drift randomised"
        },
        {
          "key": "B",
          "text": "They all jump sharply at each step",
          "correct": false,
          "explanation": "The changes are gradual, not jumps.",
          "misconception": "drift exaggerated"
        },
        {
          "key": "C",
          "text": "They change gradually as the molecules increase in size",
          "correct": true,
          "explanation": "Boiling point, melting point and density slide along the ladder.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "They stay exactly constant",
          "correct": false,
          "explanation": "Only chemical properties stay similar.",
          "misconception": "drift denied"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q4",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "Why do ethanol and propanol sit in one homologous series?",
      "misconceptionClass": "ethanol propanol membership",
      "options": [
        {
          "key": "A",
          "text": "they have the same number of hydrogens",
          "correct": false,
          "explanation": "Their hydrogen counts differ.",
          "misconception": "count misstated"
        },
        {
          "key": "B",
          "text": "they have identical boiling points",
          "correct": false,
          "explanation": "Their boiling points differ.",
          "misconception": "property misstated"
        },
        {
          "key": "C",
          "text": "one is the alkane series member",
          "correct": false,
          "explanation": "Both are alcohols, not alkanes.",
          "misconception": "series misnamed"
        },
        {
          "key": "D",
          "text": "they share the same functional group and propanol is one CH2 longer",
          "correct": true,
          "explanation": "One increment up the same family ladder.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q5",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "Which set of properties would you expect to be SIMILAR across a homologous series?",
      "misconceptionClass": "chemical similarity scope",
      "options": [
        {
          "key": "A",
          "text": "Chemical properties, because the functional group is shared",
          "correct": true,
          "explanation": "Reactivity follows the group.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Boiling points",
          "correct": false,
          "explanation": "Those drift gradually upward.",
          "misconception": "property mispicked"
        },
        {
          "key": "C",
          "text": "Melting points",
          "correct": false,
          "explanation": "They drift too.",
          "misconception": "property mispicked"
        },
        {
          "key": "D",
          "text": "Densities",
          "correct": false,
          "explanation": "They also change gradually.",
          "misconception": "property mispicked"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q6",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "Define a homologous series.",
      "misconceptionClass": "definition recall",
      "kind": "recall",
      "modelAnswer": "A homologous series gathers organic compounds sharing one functional group, and each step up the series adds a CH2.",
      "keywords": [
        "organic compounds",
        "same functional group",
        "successive",
        "CH2"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q7",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "State what members of a homologous series share and what changes gradually.",
      "misconceptionClass": "invariants sliders recall",
      "kind": "recall",
      "modelAnswer": "They share the functional group, general formula and similar chemical properties; boiling point, melting point and density change gradually.",
      "keywords": [
        "functional group",
        "general formula",
        "chemical",
        "gradually"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q8",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "Explain why ascending a homologous series changes boiling point but not chemical behaviour.",
      "misconceptionClass": "size vs reactivity logic",
      "kind": "explain-why",
      "modelAnswer": "Each CH2 step enlarges the molecule, raising the intermolecular attractions that boiling must overcome, while the reactive site - the functional group - stays identical, so the chemistry is unchanged.",
      "keywords": [
        "CH2",
        "intermolecular",
        "functional group",
        "unchanged"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L1::Q9",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L1",
      "stem": "An unknown alcohol sits two rungs above ethanol in its series. State the increment between them and the effect on boiling point.",
      "misconceptionClass": "two-rung application",
      "kind": "application",
      "modelAnswer": "Two successive CH2 increments separate them - two CH2 units in total - so the unknown is larger and boils higher than ethanol, with the change gradual across the two steps.",
      "keywords": [
        "CH2",
        "two",
        "larger",
        "boils higher"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q1",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "What do functional groups determine?",
      "misconceptionClass": "group determinants",
      "options": [
        {
          "key": "A",
          "text": "Nothing - they are decorative labels",
          "correct": false,
          "explanation": "They are the reactive core.",
          "misconception": "importance denied"
        },
        {
          "key": "B",
          "text": "The physical and chemical properties of molecules",
          "correct": true,
          "explanation": "The group is the property engine.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Only the colour of a compound",
          "correct": false,
          "explanation": "Colour is incidental.",
          "misconception": "scope narrowed"
        },
        {
          "key": "D",
          "text": "Only the molecular mass",
          "correct": false,
          "explanation": "Mass belongs to the whole molecule, not the group.",
          "misconception": "scope narrowed"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q2",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "In functional-group tables, what does R represent?",
      "misconceptionClass": "R meaning",
      "options": [
        {
          "key": "A",
          "text": "A radical sign",
          "correct": false,
          "explanation": "R is a placeholder, not an operator.",
          "misconception": "meaning misstated"
        },
        {
          "key": "B",
          "text": "The rare-earth metals",
          "correct": false,
          "explanation": "No such restriction applies.",
          "misconception": "meaning misstated"
        },
        {
          "key": "C",
          "text": "Whatever other atom or atom-cluster the molecule carries, hydrogen barred",
          "correct": true,
          "explanation": "The placeholder definition of record.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Any atom including hydrogen",
          "correct": false,
          "explanation": "Hydrogen is explicitly excluded.",
          "misconception": "restriction dropped"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q3",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "Why do ethanol and propanol share their chemical reactivity?",
      "misconceptionClass": "same group same reactions",
      "options": [
        {
          "key": "A",
          "text": "They have identical chain lengths",
          "correct": false,
          "explanation": "Propanol is one CH2 longer.",
          "misconception": "length misstated"
        },
        {
          "key": "B",
          "text": "They have the same boiling point",
          "correct": false,
          "explanation": "Their physical properties differ.",
          "misconception": "property misstated"
        },
        {
          "key": "C",
          "text": "Both are alkanes",
          "correct": false,
          "explanation": "They belong to the alcohol series.",
          "misconception": "series misnamed"
        },
        {
          "key": "D",
          "text": "Both carry the same functional group, which runs their chemistry",
          "correct": true,
          "explanation": "The shared group gives shared reactions.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q4",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "A molecule's formula changes but its functional group stays the same. What happens to its chemistry?",
      "misconceptionClass": "group constancy",
      "options": [
        {
          "key": "A",
          "text": "Its chemical properties stay essentially the same, run by the unchanged group",
          "correct": true,
          "explanation": "Reactivity follows the group.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Its chemistry changes completely",
          "correct": false,
          "explanation": "The group, not the chain, drives reactivity.",
          "misconception": "claim inverted"
        },
        {
          "key": "C",
          "text": "It stops reacting altogether",
          "correct": false,
          "explanation": "The group still reacts.",
          "misconception": "reactivity denied"
        },
        {
          "key": "D",
          "text": "It becomes a different homologous series",
          "correct": false,
          "explanation": "The same group keeps it in the same series.",
          "misconception": "membership misstated"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q5",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "Where would you look up the pattern of a functional group you need to identify?",
      "misconceptionClass": "reference table use",
      "options": [
        {
          "key": "A",
          "text": "Nowhere - they must be memorised without patterns",
          "correct": false,
          "explanation": "The table summarises the patterns.",
          "misconception": "source denied"
        },
        {
          "key": "B",
          "text": "In the summary table of common functional groups found in compounds",
          "correct": true,
          "explanation": "The table is the reference of record.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "In the periodic table",
          "correct": false,
          "explanation": "The periodic table lists elements, not organic groups.",
          "misconception": "source wrong"
        },
        {
          "key": "D",
          "text": "In the hazard symbol chart",
          "correct": false,
          "explanation": "That covers safety pictograms.",
          "misconception": "source wrong"
        }
      ]
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q6",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "State the role of a functional group in a molecule.",
      "misconceptionClass": "role recall",
      "kind": "recall",
      "modelAnswer": "The functional group determines the physical and chemical properties of the molecule.",
      "keywords": [
        "determines",
        "physical",
        "chemical",
        "properties"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q7",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "State what R stands for in the functional-group table.",
      "misconceptionClass": "R recall",
      "kind": "recall",
      "modelAnswer": "R stands for whatever other atom or atom-cluster the molecule carries, with hydrogen explicitly excluded.",
      "keywords": [
        "any",
        "atom",
        "group",
        "hydrogen"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q8",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "Explain why the functional group, rather than the carbon chain, decides a molecule's reactions.",
      "misconceptionClass": "group primacy logic",
      "kind": "explain-why",
      "modelAnswer": "Reactions happen at sites of particular bonding patterns, and the functional group is exactly that site; the carbon chain is mostly spectator framework, so swapping CH2 units leaves the reactive behaviour in place.",
      "keywords": [
        "bonding pattern",
        "site",
        "spectator",
        "reactive"
      ],
      "options": []
    },
    {
      "id": "rn_Tvxs28xrnwtx4Jbm::L2::Q9",
      "moduleId": "rn_Tvxs28xrnwtx4Jbm::L2",
      "stem": "Two molecules share a functional group but differ by three CH2 units. Predict their relative reactivity and boiling points.",
      "misconceptionClass": "dual prediction application",
      "kind": "application",
      "modelAnswer": "Their reactivity is similar - the same group runs both - while the three-CH2-longer molecule is larger and so boils higher, the gradual size effect on physical properties.",
      "keywords": [
        "similar",
        "reactivity",
        "larger",
        "boils higher"
      ],
      "options": []
    }
  ]
}
