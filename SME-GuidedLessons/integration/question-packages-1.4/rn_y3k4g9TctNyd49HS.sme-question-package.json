    },
    {
      "id": "rn_y3k4g9TctNyd49HS::L2::Q9",
      "moduleId": "rn_y3k4g9TctNyd49HS::L2",
      "stem": "Classify 1-bromobutane and 2-bromo-2-methylpropane without drawing full formulae.",
      "misconceptionClass": "application",
      "kind": "application",
      "modelAnswer": "1-bromobutane: the C-Br carbon is an end carbon with one alkyl neighbour - primary. 2-bromo-2-methylpropane: the C-Br carbon touches three methyl groups - tertiary.",
      "keywords": [
        "primary",
        "tertiary",
