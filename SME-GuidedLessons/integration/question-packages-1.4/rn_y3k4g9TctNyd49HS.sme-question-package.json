    {
      "id": "rn_y3k4g9TctNyd49HS::L2::Q7",
      "moduleId": "rn_y3k4g9TctNyd49HS::L2",
      "stem": "State how many alkyl groups attach to the C-X carbon in a tertiary halogenoalkane.",
      "misconceptionClass": "count recall",
      "kind": "recall",
      "modelAnswer": "Three alkyl groups.",
      "keywords": [
        "three",
