  "questions": [
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q1",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "What is the diploid chromosome number in human cells?",
      "misconceptionClass": "number recall",
      "options": [
        {
          "key": "A",
          "text": "46",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "23",
          "correct": false,
          "explanation": "That is the haploid number carried by gametes.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "92",
          "correct": false,
          "explanation": "No human cell type carries four sets.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "12",
          "correct": false,
          "explanation": "That number belongs to rice plants, not humans.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q2",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "How are the 46 chromosomes of a diploid human cell arranged?",
      "misconceptionClass": "pairing",
      "options": [
        {
          "key": "A",
          "text": "One long chain",
          "correct": false,
          "explanation": "Chromosomes are separate structures, not a chain.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "As 23 matching pairs",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "46 unpaired singles",
          "correct": false,
          "explanation": "The two sets pair up chromosome by chromosome.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "12 loose groups",
          "correct": false,
          "explanation": "The taught arrangement is 23 pairs.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q3",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "Which human cells are haploid?",
      "misconceptionClass": "cell identity",
      "options": [
        {
          "key": "A",
          "text": "Red blood cells",
          "correct": false,
          "explanation": "They are diploid-derived body cells, not gametes.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Nerve cells",
          "correct": false,
          "explanation": "Nerve cells carry the full diploid set.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "The gametes, egg and sperm",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Skin cells",
          "correct": false,
          "explanation": "Skin cells are diploid body cells.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q4",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "What does the DNA in diploid cells supply?",
      "misconceptionClass": "function",
      "options": [
        {
          "key": "A",
          "text": "Energy for contraction",
          "correct": false,
          "explanation": "Energy is supplied by respiration, not chromosomes.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "Waste removal",
          "correct": false,
          "explanation": "Waste handling is not a DNA function.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "Oxygen transport",
          "correct": false,
          "explanation": "That is the red blood cell's job.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "The instructions for protein synthesis and cell function",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q5",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "Why must gametes be haploid rather than diploid?",
      "misconceptionClass": "reasoning",
      "options": [
        {
          "key": "A",
          "text": "So fertilisation restores the diploid number instead of doubling it",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Gametes are too small for pairs",
          "correct": false,
          "explanation": "Size is not the reason.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Haploid cells are stronger",
          "correct": false,
          "explanation": "Neither state is stronger; each suits its job.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "The egg rejects paired chromosomes",
          "correct": false,
          "explanation": "Nothing is rejected; the arithmetic is the point.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q6",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "State the diploid and haploid numbers for human cells.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Diploid cells hold 46 chromosomes and haploid cells hold 23.",
      "keywords": [
        "diploid",
        "haploid",
        "46",
        "23"
      ],
      "options": []
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q7",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "Name the two haploid cells produced in humans.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "The female egg and the male sperm are the haploid gametes.",
      "keywords": [
        "egg",
        "sperm",
        "haploid",
        "gametes"
      ],
      "options": []
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q8",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "Explain why the chromosome number must be halved before fertilisation.",
      "misconceptionClass": "mechanism reasoning",
      "kind": "explain-why",
      "modelAnswer": "If both gametes carried a full diploid set, the zygote would receive double the number of chromosomes, so meiosis halves each set first and fertilisation restores the normal 46.",
      "keywords": [
        "zygote",
        "chromosomes",
        "fertilisation",
        "46"
      ],
      "options": []
    },
    {
      "id": "rn_BNypNmmFWkMYRSHP::L1::Q9",
      "moduleId": "rn_BNypNmmFWkMYRSHP::L1",
      "stem": "A lab technician counts 23 chromosomes in a human cell sample. What cell type have they likely found, and what is that state called?",
      "misconceptionClass": "scenario application",
      "kind": "application",
      "modelAnswer": "They have likely found a gamete, an egg or sperm, and the single-set state is called haploid.",
      "keywords": [
        "gamete",
