  "questions": [
    {
      "id": "rn_zC7QWr77fGFWbhNS::L1::Q1",
      "moduleId": "rn_zC7QWr77fGFWbhNS::L1",
      "stem": "What does polygenic literally involve?",
      "misconceptionClass": "definition",
      "options": [
        {
          "key": "A",
          "text": "Many genes contributing to one characteristic",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "One gene acting alone",
          "correct": false,
          "explanation": "That is monogenic inheritance.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "One chromosome working unaided",
          "correct": false,
          "explanation": "Genes, not whole chromosomes, are the unit.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "One parent supplying everything",
          "correct": false,
          "explanation": "Both parents contribute genes.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_zC7QWr77fGFWbhNS::L1::Q2",
      "moduleId": "rn_zC7QWr77fGFWbhNS::L1",
      "stem": "Why do polygenic traits show a wide range of phenotypes?",
      "misconceptionClass": "range logic",
      "options": [
        {
          "key": "A",
          "text": "Phenotypes collapse to two options",
          "correct": false,
          "explanation": "Two-option traits are monogenic cases.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "Many allele combinations across several genes produce many outcomes",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The environment erases the classes",
          "correct": false,
          "explanation": "Environment is a separate cause.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "Each gene acts in isolation",
          "correct": false,
          "explanation": "The combinations are the point.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_zC7QWr77fGFWbhNS::L1::Q3",
      "moduleId": "rn_zC7QWr77fGFWbhNS::L1",
      "stem": "Which of these is a taught polygenic example?",
      "misconceptionClass": "example sorting",
      "options": [
        {
          "key": "A",
          "text": "Blood group",
          "correct": false,
          "explanation": "Governed by the three ABO alleles, not many genes.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Sex determination",
          "correct": false,
          "explanation": "Controlled by one chromosome pair.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "Human height",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Tongue rolling",
          "correct": false,
          "explanation": "That is a single-gene example.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_zC7QWr77fGFWbhNS::L1::Q4",
      "moduleId": "rn_zC7QWr77fGFWbhNS::L1",
      "stem": "Why do simple genetic diagrams handle polygenic traits poorly?",
      "misconceptionClass": "diagram limits",
      "options": [
        {
          "key": "A",
          "text": "Diagrams refuse polygenic letters",
          "correct": false,
          "explanation": "The letters are not the problem.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "Polygenic traits lack DNA",
          "correct": false,
          "explanation": "Every gene is DNA.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "The grid only draws plants",
          "correct": false,
          "explanation": "The grid draws any single-gene cross.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "The many allele combinations overwhelm the four-cell grid",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_zC7QWr77fGFWbhNS::L1::Q5",
      "moduleId": "rn_zC7QWr77fGFWbhNS::L1",
      "stem": "Are you expected to diagram a polygenic cross in the exam?",
      "misconceptionClass": "exam scope",
      "options": [
        {
          "key": "A",
          "text": "No, you only need to know that many characteristics are polygenic",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Yes, with a full grid",
          "correct": false,
          "explanation": "The examiner explicitly exempts you from this.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Yes, using several letters at once",
          "correct": false,
          "explanation": "No such working is required.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Only for plants",
          "correct": false,
          "explanation": "No polygenic diagram is expected at all.",
          "misconception": "invented role"
        }
      ]
    },
    {
