  "questions": [
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q1",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "What does random fertilisation mean?",
      "misconceptionClass": "definition",
      "options": [
        {
          "key": "A",
          "text": "Any sperm cell can meet any egg cell",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The strongest sperm is chosen",
          "correct": false,
          "explanation": "No selection among gametes is implied.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Parents select the alleles",
          "correct": false,
          "explanation": "Parents control nothing at this stage.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Zygotes are cloned",
          "correct": false,
          "explanation": "Cloning contradicts the uniqueness claim.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q2",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "Why do gametes differ from one another before fertilisation?",
      "misconceptionClass": "meiosis role",
      "options": [
        {
          "key": "A",
          "text": "Fertilisation edits them first",
          "correct": false,
          "explanation": "Fertilisation happens after the variety exists.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "Meiosis has already produced genetic variation between them",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Mitosis copies them identically",
          "correct": false,
          "explanation": "Mitosis is not the gamete-maker.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "They mutate on purpose",
          "correct": false,
          "explanation": "Mutation is random, never purposeful.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q3",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "What does each zygote receive?",
      "misconceptionClass": "zygote outcome",
      "options": [
        {
          "key": "A",
          "text": "Only maternal alleles",
          "correct": false,
          "explanation": "Paternal alleles arrive with the sperm.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Half a chromosome each, permanently",
          "correct": false,
          "explanation": "Fusion restores the full diploid set.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "A unique combination of alleles from two gametes",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Identical allele sets every time",
          "correct": false,
          "explanation": "Each pairing is fresh.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q4",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "Which example set illustrates human genetic variation here?",
      "misconceptionClass": "example recall",
      "options": [
        {
          "key": "A",
          "text": "Height alone",
          "correct": false,
          "explanation": "Height is taught as polygenic, not in this list.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "Fingerprints only",
          "correct": false,
          "explanation": "Fingerprints are not in the taught list.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "Language and accent",
          "correct": false,
          "explanation": "Those are environmental examples.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "Blood group, eye colour, tongue rolling and earlobes",
          "correct": true,
          "explanation": "Right — the other options each misplace a concept.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q5",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "Two siblings of the same parents differ in eye colour. Which process explains this best?",
      "misconceptionClass": "scenario",
      "options": [
        {
          "key": "A",
          "text": "Random fertilisation assembling different allele combinations in each zygote",
          "correct": true,
          "explanation": "Right — the other options each misplace a concept.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "The parents changed between pregnancies",
          "correct": false,
          "explanation": "Parental genotypes are fixed.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "The environment repainted eyes",
          "correct": false,
          "explanation": "Eye colour here is genetic.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "One child mutated deliberately",
          "correct": false,
          "explanation": "Mutation is random, never deliberate.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q6",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "State how random fertilisation produces genetic variation.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Gametes already differ because of meiosis, and their random fusion gives every zygote a unique allele combination.",
      "keywords": [
        "gametes",
        "meiosis",
        "fusion",
        "zygote"
      ],
      "options": []
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q7",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "Name two human characteristics listed as examples of genetic variation.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Blood group and eye colour, with tongue rolling and earlobe form also given.",
      "keywords": [
        "blood group",
        "eye colour",
        "tongue",
        "earlobe"
      ],
      "options": []
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q8",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "Explain why siblings from the same parents are not genetically identical.",
      "misconceptionClass": "mechanism reasoning",
      "kind": "explain-why",
      "modelAnswer": "Each conception fuses a different pair of gametes, so each child assembles a different allele combination despite sharing the same parents.",
      "keywords": [
        "gametes",
        "combination",
        "siblings",
        "parents"
      ],
      "options": []
    },
    {
      "id": "rn_zsnc6nvCQKHcFZrP::L1::Q9",
      "moduleId": "rn_zsnc6nvCQKHcFZrP::L1",
      "stem": "A family has five children with three different blood groups among them. Explain how one couple can produce that variety.",
      "misconceptionClass": "scenario application",
      "kind": "application",
      "modelAnswer": "Each conception paired different gametes drawn from the parents' allele pools, so random fertilisation assembled a different allele combination, and hence a different blood group, in each child.",
      "keywords": [
        "gametes",
        "fertilisation",
        "allele combination",
        "blood group"
      ],
      "options": []
    }
  ]
