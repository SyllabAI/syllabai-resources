    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q9",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "A technician photographs a body cell and counts 46 chromosomes arranged as matching partners. Describe what the photograph shows using the taught vocabulary.",
      "misconceptionClass": "scenario application",
      "kind": "application",
      "modelAnswer": "The photograph shows the diploid state: 23 homologous pairs, 46 chromosomes in total, with one chromosome of each pair inherited from each parent.",
      "keywords": [
