  "questions": [
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q1",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "What is the genome?",
      "misconceptionClass": "definition",
      "options": [
        {
          "key": "A",
          "text": "All of an organism's DNA, collected together",
          "correct": true,
          "explanation": "Right — the other options each misplace a concept.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "One chromosome",
          "correct": false,
          "explanation": "A chromosome is one volume, not the whole library.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "One gene",
          "correct": false,
          "explanation": "A gene is one section of the genome.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "One protein",
          "correct": false,
          "explanation": "Proteins are products, not the DNA store.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q2",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "A gene is one DNA section; what single product does it code for?",
      "misconceptionClass": "gene definition",
      "options": [
        {
          "key": "A",
          "text": "A whole cell",
          "correct": false,
          "explanation": "Cells are built from many gene products.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "A specific protein",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "A whole genome",
          "correct": false,
          "explanation": "The genome contains the gene, not vice versa.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "A chromosome",
          "correct": false,
          "explanation": "Genes sit on chromosomes.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q3",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "Collagen belongs to which protein class?",
      "misconceptionClass": "protein classes",
      "options": [
        {
          "key": "A",
          "text": "Hormones",
          "correct": false,
          "explanation": "Hormones are chemical messengers.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Antibodies",
          "correct": false,
          "explanation": "Antibodies defend against pathogens.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "Structural proteins",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Enzymes",
          "correct": false,
          "explanation": "Enzymes catalyse reactions; collagen builds structure.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q4",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "How do genes control characteristics?",
      "misconceptionClass": "mechanism",
      "options": [
        {
          "key": "A",
          "text": "By heating the cell",
          "correct": false,
          "explanation": "No heating mechanism is involved.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "By absorbing light",
          "correct": false,
          "explanation": "Light absorption plays no role.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "By direct colouring of tissue",
          "correct": false,
          "explanation": "Colour arises through protein function, not painting.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "Through the proteins they code for, which shape what cells do",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q5",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "What sits between gene and protein in the taught chain?",
      "misconceptionClass": "chain",
      "options": [
        {
          "key": "A",
          "text": "The amino acid sequence the gene specifies",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Lipids",
          "correct": false,
          "explanation": "Lipids are not in this chain.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Vitamins",
          "correct": false,
          "explanation": "Vitamins do not mediate gene expression here.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Salts",
          "correct": false,
          "explanation": "Salts are unrelated to the coding chain.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q6",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "Define genome and gene.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "The genome means all of an organism's DNA taken together, while a gene is one DNA section coding for a specific protein.",
      "keywords": [
        "genome",
        "gene",
        "dna",
        "protein"
      ],
      "options": []
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q7",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "Name the three protein types the note lists.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Structural proteins such as collagen, enzymes, and hormones.",
      "keywords": [
        "structural",
        "enzymes",
        "hormones",
        "collagen"
      ],
      "options": []
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q8",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "Explain why a change in a gene can change a characteristic.",
      "misconceptionClass": "mechanism reasoning",
      "kind": "explain-why",
      "modelAnswer": "A gene fixes the amino acid sequence of its protein, and a changed sequence can alter the protein's job, which shows up in the cell's characteristics.",
      "keywords": [
        "gene",
        "amino acid sequence",
        "protein",
        "characteristics"
      ],
      "options": []
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L1::Q9",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L1",
      "stem": "A hormone is described as a gene product. State the two steps that turned the gene into the circulating protein.",
      "misconceptionClass": "scenario application",
      "kind": "application",
      "modelAnswer": "The gene's DNA was transcribed into mRNA in the nucleus, and the mRNA was translated on ribosomes into the hormone protein.",
      "keywords": [
        "mrna",
        "nucleus",
        "ribosomes",
        "protein"
      ],
      "options": []
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q1",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "Where in a cell are chromosomes found?",
      "misconceptionClass": "location",
      "options": [
        {
          "key": "A",
          "text": "In ribosomes",
          "correct": false,
          "explanation": "Ribosomes build proteins, not store chromosomes.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "In the nucleus",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "In the cytoplasm",
          "correct": false,
          "explanation": "The cytoplasm hosts ribosomes, not chromosomes.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "In the cell membrane",
          "correct": false,
          "explanation": "Membranes hold no DNA.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q2",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "How many chromosomes does an ordinary human body cell hold?",
      "misconceptionClass": "count",
      "options": [
        {
          "key": "A",
          "text": "92",
          "correct": false,
          "explanation": "No human cell type carries four sets.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "12 pairs",
          "correct": false,
          "explanation": "That number belongs to rice plants.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "46, as 23 pairs",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "23 singles",
          "correct": false,
          "explanation": "That is the haploid gamete count.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q3",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "When are chromosomes visible?",
      "misconceptionClass": "visibility",
      "options": [
        {
          "key": "A",
          "text": "Never",
          "correct": false,
          "explanation": "They become visible when dividing.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "At night only",
          "correct": false,
          "explanation": "Light has no effect on visibility.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "During feeding",
          "correct": false,
          "explanation": "Feeding does not condense chromosomes.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "During cell division",
          "correct": true,
          "explanation": "Right — the other options each misplace a concept.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q4",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "What is a homologous pair?",
      "misconceptionClass": "pairing term",
      "options": [
        {
          "key": "A",
          "text": "Two matching chromosomes, one inherited from each parent",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Two X chromosomes only",
          "correct": false,
          "explanation": "That is one specific pair, not the definition.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Two identical twins",
          "correct": false,
          "explanation": "Twins are organisms, not chromosomes.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Two genes side by side",
          "correct": false,
          "explanation": "Genes sit on chromosomes, not in pairs like this.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q5",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "What did the human genome project locate?",
      "misconceptionClass": "project",
      "options": [
        {
          "key": "A",
          "text": "The age of DNA",
          "correct": false,
          "explanation": "Ageing of DNA is unrelated.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "The specific positions of genes on the chromosomes",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The cost of sequencing",
          "correct": false,
          "explanation": "Cost was not the scientific output.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "The number of species",
          "correct": false,
          "explanation": "Species counts were not the goal.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q6",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "State the diploid arrangement in human body cells.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "They contain 23 homologous pairs, giving 46 chromosomes in total, written as the diploid number 2n.",
      "keywords": [
        "23",
        "46",
        "diploid",
        "homologous"
      ],
      "options": []
    },
    {
      "id": "rn_qnHfMCqJR5qgzS3S::L2::Q7",
      "moduleId": "rn_qnHfMCqJR5qgzS3S::L2",
      "stem": "Describe how DNA becomes a chromosome.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
