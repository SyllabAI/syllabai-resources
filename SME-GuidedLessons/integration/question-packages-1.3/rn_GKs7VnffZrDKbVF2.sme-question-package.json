      ],
      "options": []
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q8",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "Explain why each anticodon corresponds to exactly one amino acid.",
      "misconceptionClass": "mechanism reasoning",
      "kind": "explain-why",
      "modelAnswer": "The matching rule between anticodon and codon is fixed, so each tRNA delivers the same amino acid every time, keeping the protein sequence faithful to the gene.",
