        "ribosomes",
        "amino acid chain"
      ],
      "options": []
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q7",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "State the roles of codon and anticodon.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
