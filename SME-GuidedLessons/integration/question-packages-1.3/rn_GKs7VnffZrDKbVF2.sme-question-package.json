  "questions": [
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q1",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "Where does transcription occur?",
      "misconceptionClass": "site",
      "options": [
        {
          "key": "A",
          "text": "In the nucleus",
          "correct": true,
          "explanation": "Right — the other options each misplace a concept.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "In the cytoplasm",
          "correct": false,
          "explanation": "The cytoplasm hosts translation, not transcription.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "On the ribosome",
          "correct": false,
          "explanation": "Ribosomes receive the mRNA after transcription.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "In the mitochondrion",
          "correct": false,
          "explanation": "Mitochondria are not part of this account.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q2",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "What molecule does transcription produce?",
      "misconceptionClass": "product",
      "options": [
        {
          "key": "A",
          "text": "A new DNA double helix",
          "correct": false,
          "explanation": "Transcription copies, it does not replicate DNA.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "Single-stranded mRNA",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "tRNA",
          "correct": false,
          "explanation": "tRNA is a separate working type.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "A protein",
          "correct": false,
          "explanation": "Protein is the end product of translation.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q3",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "What exposes the template strand?",
      "misconceptionClass": "mechanism",
      "options": [
        {
          "key": "A",
          "text": "The ribosome pulls it apart",
          "correct": false,
          "explanation": "Ribosomes are not present yet.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Bases are cut out",
          "correct": false,
          "explanation": "No bases are removed at this stage.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "Hydrogen bonds break and the DNA unwinds",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "The membrane opens",
          "correct": false,
          "explanation": "The nuclear membrane plays no such role.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q4",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "How does the mRNA strand relate to the template?",
      "misconceptionClass": "copy relation",
      "options": [
        {
          "key": "A",
          "text": "An identical clone of the template",
          "correct": false,
          "explanation": "Pairing makes it complementary, not identical.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "A scrambled version",
          "correct": false,
          "explanation": "The copy preserves the sequence faithfully.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "A reversed sequence",
          "correct": false,
          "explanation": "Nothing reverses during transcription.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "Its bases mirror the template strand, base for complementary base",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q5",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "How does the mRNA reach the cytoplasm?",
      "misconceptionClass": "transport",
      "options": [
        {
          "key": "A",
          "text": "Through a pore in the nuclear envelope",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "It dissolves and reforms outside",
          "correct": false,
          "explanation": "The molecule travels intact.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "The nucleus contracts around it",
          "correct": false,
          "explanation": "No such mechanism is taught.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "tRNA ferries it out",
          "correct": false,
          "explanation": "tRNA works later, in translation.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q6",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "List the five transcription steps in order.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "The DNA unwinds, the template strand is exposed, free mRNA nucleotides bind, the nucleotides join into a single strand, and the mRNA leaves through a pore.",
      "keywords": [
        "unwinds",
        "template",
        "nucleotides",
        "pore"
      ],
      "options": []
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q7",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "Define transcription in one sentence.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Transcription is the nuclear stage that copies a section of DNA into a strand of mRNA.",
      "keywords": [
        "transcription",
        "nucleus",
        "dna",
        "mrna"
      ],
      "options": []
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q8",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "Explain why the mRNA must leave the nucleus for the next stage.",
      "misconceptionClass": "mechanism reasoning",
      "kind": "explain-why",
      "modelAnswer": "Ribosomes sit in the cytoplasm, so the message has to travel out of the nucleus before translation can begin.",
      "keywords": [
        "ribosomes",
        "cytoplasm",
        "nucleus",
        "translation"
      ],
      "options": []
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L1::Q9",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L1",
      "stem": "A poison blocks the pores in the nuclear envelope of a cell. Describe the effect on protein synthesis.",
      "misconceptionClass": "scenario application",
      "kind": "application",
      "modelAnswer": "mRNA can no longer leave the nucleus, so it never reaches the ribosomes in the cytoplasm and translation cannot start.",
      "keywords": [
        "mrna",
        "nucleus",
        "ribosomes",
        "translation"
      ],
      "options": []
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q1",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "Where does translation happen?",
      "misconceptionClass": "site",
      "options": [
        {
          "key": "A",
          "text": "On the cell membrane",
          "correct": false,
          "explanation": "The membrane is not a translation site.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "In the cytoplasm, on ribosomes",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "In the nucleus",
          "correct": false,
          "explanation": "The nucleus hosts transcription only.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "Inside the nuclear pore",
          "correct": false,
          "explanation": "The pore is a doorway, not a workshop.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q2",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "What does each tRNA molecule carry?",
      "misconceptionClass": "trna structure",
      "options": [
        {
          "key": "A",
          "text": "A double helix",
          "correct": false,
          "explanation": "tRNA is a single-stranded molecule.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Nothing but water",
          "correct": false,
          "explanation": "The amino acid is the cargo.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "An anticodon triplet and its specific amino acid",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "A complete gene",
          "correct": false,
          "explanation": "tRNA carries one amino acid, not a gene.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q3",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "What pairs with a codon on the mRNA?",
      "misconceptionClass": "pairing",
      "options": [
        {
          "key": "A",
          "text": "Another codon",
          "correct": false,
          "explanation": "Codons pair with anticodons, not each other.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "A base from DNA",
          "correct": false,
          "explanation": "DNA stays in the nucleus.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "A peptide bond",
          "correct": false,
          "explanation": "Bonds join amino acids; they do not pair with codons.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "The complementary anticodon of a tRNA",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q4",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "What joins the amino acids together?",
      "misconceptionClass": "bonding",
      "options": [
        {
          "key": "A",
          "text": "Peptide bonds between neighbouring amino acids",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Hydrogen bonds",
          "correct": false,
          "explanation": "Those held the DNA strands, not the protein chain.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Phosphate bonds",
          "correct": false,
          "explanation": "Phosphates belong to the nucleic acid backbone.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Cell fibres",
          "correct": false,
          "explanation": "Fibres pull chromosomes, not amino acids.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q5",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "What signals the end of translation?",
      "misconceptionClass": "termination",
      "options": [
        {
          "key": "A",
          "text": "The nucleus calling the chain back",
          "correct": false,
          "explanation": "The nucleus is not involved here.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "A stop codon on the mRNA",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The tRNA running out",
          "correct": false,
          "explanation": "Depletion is not the taught signal.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "The ribosome wearing out",
          "correct": false,
          "explanation": "Ribosomes are not the signal source.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q6",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "Define translation and its location.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Translation is the cytoplasm stage where the mRNA is read on ribosomes and an amino acid chain is produced.",
      "keywords": [
        "translation",
