    {
      "id": "rn_GKs7VnffZrDKbVF2::L2::Q9",
      "moduleId": "rn_GKs7VnffZrDKbVF2::L2",
      "stem": "A mutation changes a codon on an mRNA into a stop codon. Predict the effect on the protein produced.",
      "misconceptionClass": "scenario application",
