  "questions": [
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q1",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "What is variation, as defined here?",
      "misconceptionClass": "definition",
      "options": [
        {
          "key": "A",
          "text": "Differences between individuals of the same species",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Differences between different species",
          "correct": false,
          "explanation": "Within one species is the taught scope.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Changes inside a single cell",
          "correct": false,
          "explanation": "Variation compares individuals.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Mutations only",
          "correct": false,
          "explanation": "Mutation is one genetic source, not the definition.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q2",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "Which cause list is complete?",
      "misconceptionClass": "cause taxonomy",
      "options": [
        {
          "key": "A",
          "text": "Neither genes nor surroundings",
          "correct": false,
          "explanation": "Both are named causes.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "Genetic, environmental, or a combination of both",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Genetic only",
          "correct": false,
          "explanation": "Environmental causes exist too.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "Environmental only",
          "correct": false,
          "explanation": "Genes contribute their own pile.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q3",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "Which example is environmental rather than genetic?",
      "misconceptionClass": "example sorting",
      "options": [
        {
          "key": "A",
          "text": "Eye colour",
          "correct": false,
          "explanation": "Eye colour follows the genes.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Tongue rolling",
          "correct": false,
          "explanation": "That is a genetic trait.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "A scar left by an accident",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Blood group",
          "correct": false,
          "explanation": "Blood group is inherited.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q4",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "How does a shaded plant growing taller to reach light illustrate environment?",
      "misconceptionClass": "plant case",
      "options": [
        {
          "key": "A",
          "text": "The plant mutated for height",
          "correct": false,
          "explanation": "No mutation is involved.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "Its genes changed in the shade",
          "correct": false,
          "explanation": "Genes stay fixed; the conditions changed.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "Height is never environmental",
          "correct": false,
          "explanation": "The taught example says otherwise.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "Light availability during growth altered the height the genes allowed",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q5",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "Why is spoken accent an environmental trait?",
      "misconceptionClass": "culture case",
      "options": [
        {
          "key": "A",
          "text": "It is learned from the surrounding culture, not inherited",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "Accents sit in DNA",
          "correct": false,
          "explanation": "No accent gene exists.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "Accents follow blood group",
          "correct": false,
          "explanation": "Blood group is unrelated to speech.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Accents cannot vary",
          "correct": false,
          "explanation": "They vary precisely because culture varies.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q6",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "State the definition of variation and its causes.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Variation is the differences between individuals of the same species, caused by genes, environmental factors, or both together.",
      "keywords": [
        "variation",
        "species",
        "genes",
        "environmental"
      ],
      "options": []
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q7",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "Give two environmental examples from the note.",
      "misconceptionClass": "recall of the taught account",
      "kind": "recall",
      "modelAnswer": "Scarring from an accident and weight gain from diet and inactivity.",
      "keywords": [
        "scarring",
        "weight gain",
        "diet",
        "accident"
      ],
      "options": []
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q8",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "Explain why language counts as environmental variation.",
      "misconceptionClass": "mechanism reasoning",
      "kind": "explain-why",
      "modelAnswer": "A person acquires the language and accent of their upbringing through exposure rather than inheritance, so the environment, not the genes, decides it.",
      "keywords": [
        "language",
        "accent",
        "environment",
        "inheritance"
      ],
      "options": []
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L1::Q9",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L1",
      "stem": "Two identical twins are raised in different countries and grow up speaking different languages. Classify this difference and justify your answer.",
      "misconceptionClass": "scenario application",
      "kind": "application",
      "modelAnswer": "The language difference is environmental, because the twins share their genes but acquired different speech through their different cultures.",
      "keywords": [
        "environmental",
        "genes",
        "culture",
        "language"
      ],
      "options": []
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L2::Q1",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L2",
      "stem": "What usually causes discontinuous variation?",
      "misconceptionClass": "discontinuous cause",
      "options": [
        {
          "key": "A",
          "text": "Accidents during life",
          "correct": false,
          "explanation": "Accidents are environmental, not discontinuous causes.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "Genetic variation alone, through a single gene",
          "correct": true,
          "explanation": "Correct — this matches the account taught above.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "Environment alone",
          "correct": false,
          "explanation": "The taught rule assigns it to genes.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "Polygenic genes plus diet",
          "correct": false,
          "explanation": "That describes continuous variation.",
          "misconception": "category slip"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L2::Q2",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L2",
      "stem": "Which trait is discontinuous?",
      "misconceptionClass": "trait sorting",
      "options": [
        {
          "key": "A",
          "text": "Weight",
          "correct": false,
          "explanation": "Weight varies continuously.",
          "misconception": "category slip"
        },
        {
          "key": "B",
          "text": "Skin colour",
          "correct": false,
          "explanation": "Skin colour spreads across a range.",
          "misconception": "invented role"
        },
        {
          "key": "C",
          "text": "Blood group",
          "correct": true,
          "explanation": "Yes — the mechanism works exactly this way.",
          "misconception": null
        },
        {
          "key": "D",
          "text": "Height",
          "correct": false,
          "explanation": "Height is the continuous example.",
          "misconception": "close but wrong"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L2::Q3",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L2",
      "stem": "Why does height show the combined case?",
      "misconceptionClass": "combined case",
      "options": [
        {
          "key": "A",
          "text": "Height is only genetic",
          "correct": false,
          "explanation": "The taught account includes environment.",
          "misconception": "close but wrong"
        },
        {
          "key": "B",
          "text": "Height is only diet",
          "correct": false,
          "explanation": "Genes supply the potential.",
          "misconception": "category slip"
        },
        {
          "key": "C",
          "text": "Height has no genes at all",
          "correct": false,
          "explanation": "Polygenic genes are central.",
          "misconception": "invented role"
        },
        {
          "key": "D",
          "text": "Height genes set potential, while diet and lifestyle adjust the outcome",
          "correct": true,
          "explanation": "Right — the other options each misplace a concept.",
          "misconception": null
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L2::Q4",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L2",
      "stem": "What does polygenic inheritance contribute to continuous variation?",
      "misconceptionClass": "polygenic role",
      "options": [
        {
          "key": "A",
          "text": "Several genes each add an effect, spreading the trait across a range",
          "correct": true,
          "explanation": "Right — this is the account the lesson teaches.",
          "misconception": null
        },
        {
          "key": "B",
          "text": "One gene flips it",
          "correct": false,
          "explanation": "One gene gives classes, not ranges.",
          "misconception": "close but wrong"
        },
        {
          "key": "C",
          "text": "The environment deletes genes",
          "correct": false,
          "explanation": "Nothing deletes genes here.",
          "misconception": "category slip"
        },
        {
          "key": "D",
          "text": "Genes play no part",
          "correct": false,
          "explanation": "They supply the spread's foundation.",
          "misconception": "invented role"
        }
      ]
    },
    {
      "id": "rn_q7VWTgBZpxbjJvm5::L2::Q5",
      "moduleId": "rn_q7VWTgBZpxbjJvm5::L2",
      "stem": "A child of tall parents grows up short through poor diet. What does this show?",
