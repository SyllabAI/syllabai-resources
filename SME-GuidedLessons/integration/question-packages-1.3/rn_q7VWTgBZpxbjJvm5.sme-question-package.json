      "options": [
        {
          "key": "A",
          "text": "Diet wrote new genes",
          "correct": false,
          "explanation": "Diet never rewrites DNA.",
          "misconception": "invented role"
        },
        {
          "key": "B",
          "text": "The environment limited the genetic potential for height",
          "correct": true,
          "explanation": "Correct — this follows directly from the definition.",
          "misconception": null
        },
        {
          "key": "C",
          "text": "The parents were not really tall",
          "correct": false,
          "explanation": "Their phenotype is given.",
          "misconception": "close but wrong"
        },
        {
          "key": "D",
          "text": "Genes changed during childhood",
          "correct": false,
          "explanation": "Genes stay fixed through life.",
          "misconception": "category slip"
        }
      ]
    },
    {
