{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hub/lesson-import/1.5",
  "title": "Hub lesson-import v1.4 (R3 mixed check types; generation-union over 1.3)",
  "description": "One file per note, R3 generation: shape-identical to 1.3 except checkRefs may list up to 9 questions (the 5 MCQs plus 4 written items) and the generation consts become unions so the 110 untouched 1.3 artifacts and the 2 re-issued 1.4 pilot artifacts validate under this one schema. draft-07, additionalProperties false throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "adapter",
    "source",
    "lesson"
  ],
  "properties": {
    "format": {
      "enum": [
        "hub/lesson-import/1.3",
        "hub/lesson-import/1.4",
        "hub/lesson-import/1.5"
      ]
    },
    "adapter": {
      "enum": [
        "guided-lesson-0.4--hub-lesson-import-1.3",
        "guided-lesson-0.5--hub-lesson-import-1.4",
        "guided-lesson-0.6--hub-lesson-import-1.5"
      ]
    },
    "source": {
      "$ref": "#/definitions/sourceBlock"
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicTitle",
        "subtopicTitle",
        "sourceUrl",
        "specAnchors",
        "primer",
        "modules",
        "assets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(igcse-chemistry|igcse-physics)::rn_[A-Za-z0-9]+$"
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1
        },
        "subtopicTitle": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "specAnchors": {
          "type": "array",
          "minItems": 1,
          "description": "Verbatim from source specPoints (code+official text); module specRefs across the file must equal this set (conservation gate).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "text"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^((4CH1|4PH1)-[0-9]+\\.[0-9]+[CP]?)$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "primer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "prerequisiteSubtopic"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "prerequisiteSubtopic": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions/module"
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "glossary",
            "workedExample"
          ],
          "properties": {
            "glossary": {
              "type": "array",
              "minItems": 3,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "term",
                  "definition",
                  "firstLesson"
                ],
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "firstLesson": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "workedExample": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "prompt",
                "steps",
                "finalAnswer"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "finalAnswer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "description": "Optional figures layer, verbatim passthrough from the guided-lesson/0.2 source (figures-0.2-pipeline). moduleIds empty = note-level figure (page-fallback only, never inside the lesson flow).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "alt",
              "sourceHeading",
              "moduleIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^fig-[0-9]{2}$"
              },
              "url": {
                "type": "string",
                "pattern": "^https://raw\\.githubusercontent\\.com/SyllabAI/syllabai-resources/main/SME-RevisionNotes/(igcse-chemistry-19|igcse-physics-19)/assets/[0-9a-f]{12}-[A-Za-z0-9._-]+\\.(png|jpg|jpeg|webp|avif)$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "sourceHeading": {
                "type": "string",
                "minLength": 1
              },
              "moduleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^L[1-5]$"
                }
              },
              "caption": {
                "type": "string",
                "minLength": 1,
                "description": "Verbatim passthrough of the source figure caption (figures-2.1 captions layer)."
              },
              "binding": {
                "type": "string",
                "enum": [
                  "heading-unique",
                  "sole-lesson",
                  "content-overlap",
                  "note-level",
                  "unresolved"
                ],
                "description": "Verbatim passthrough of the source figure binding provenance (figures-2.2 binding layer)."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "sourceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFormat",
        "noteId",
        "corpusVersion",
        "sourceLayerSha256",
        "pinnedRef"
      ],
      "properties": {
        "sourceFormat": {
          "enum": [
            "guided-lesson/0.4",
            "guided-lesson/0.5",
            "guided-lesson/0.6"
          ]
        },
        "noteId": {
          "type": "string",
          "pattern": "^rn_[A-Za-z0-9]+$"
        },
        "corpusVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceLayerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pinnedRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sourceHeadings",
        "specRefs",
        "opening",
        "keyPoints",
        "depthLayers",
        "gatePolicy",
        "checkRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rn_[A-Za-z0-9]+::L[1-5]$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceHeadings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "specRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((4CH1|4PH1)-[0-9]+\\.[0-9]+[CP]?)$"
          }
        },
        "opening": {
          "type": "string",
          "minLength": 1
        },
        "keyPoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depthLayers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "medium"
          ],
          "properties": {
            "low": {
              "$ref": "#/definitions/depthLayer"
            },
            "medium": {
              "$ref": "#/definitions/depthLayer"
            }
          }
        },
        "gatePolicy": {
          "type": "object",
          "additionalProperties": false,
          "description": "Confidence-gate contract, decided per adapter spec section 6: the authoring gate becomes binding hub runtime policy; the two const-true invariants are import-blocking.",
          "required": [
            "ratingsScale",
            "continueDisabledUntilChoice",
            "resumeWithoutReRate",
            "postCheckRecalibration"
          ],
          "properties": {
            "ratingsScale": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "continueDisabledUntilChoice": {
              "const": true
            },
            "resumeWithoutReRate": {
              "const": true
            },
            "postCheckRecalibration": {
              "type": "boolean"
            }
          }
        },
        "checkRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "description": "Ordered ids of this module's questions in the paired sme-question-package file; 1:1 with source lesson.check items (5 MCQ + up to 4 written items per lesson).",
          "items": {
            "type": "string",
            "pattern": "^rn_[A-Za-z0-9]+::L[1-5]::Q[1-9]$"
          }
        },
        "figureIds": {
          "type": "array",
          "minItems": 0,
          "description": "Optional: ordered ids of this module's claimed figures (verbatim from source lesson figureIds; every id must resolve in lesson.figures — closure lint-enforced).",
          "items": {
            "type": "string",
            "pattern": "^fig-[0-9]{2}$"
          }
        }
      }
    },
    "depthLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restatement",
        "analogy",
        "examPointer"
      ],
      "properties": {
        "restatement": {
          "type": "string",
          "minLength": 1
        },
        "analogy": {
          "type": "string",
          "minLength": 1
        },
        "examPointer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}