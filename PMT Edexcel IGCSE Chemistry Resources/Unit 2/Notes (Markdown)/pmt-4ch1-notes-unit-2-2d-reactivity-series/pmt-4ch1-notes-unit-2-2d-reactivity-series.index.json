  "specMarkers": [
    {
      "line": 10,
      "officialCode": "2.15",
      "code": "4CH1-2.15",
      "wording": "understand how metals can be arranged in a reactivity series based on their reactions with: •water •dilute hydrochloric or sulfuric acid.",
      "subsection": "4CH1-S2-d"
    },
    {
      "line": 30,
      "officialCode": "2.16",
      "code": "4CH1-2.16",
      "wording": "understand how metals can be arranged in a reactivity series based on their displacement reactions between: •metals and metal oxides •metals and aqueous solutions of metal salts.",
      "subsection": "4CH1-S2-d"
    },
    {
      "line": 40,
      "officialCode": "2.17",
      "code": "4CH1-2.17",
      "wording": "know the order of reactivity of these metals: potassium, sodium, lithium, calcium, magnesium, aluminium, zinc, iron, copper, silver, gold",
      "subsection": "4CH1-S2-d"
    },
    {
      "line": 59,
      "officialCode": "2.18",
      "code": "4CH1-2.18",
      "wording": "know the conditions under which iron rusts",
      "subsection": "4CH1-S2-d"
    },
    {
      "line": 62,
      "officialCode": "2.19",
      "code": "4CH1-2.19",
      "wording": "understand how the rusting of iron may be prevented by: •barrier methods •galvanising •sacrificial protection.",
      "subsection": "4CH1-S2-d"
    },
    {
      "line": 84,
      "officialCode": "2.20",
      "code": "4CH1-2.20",
      "wording": "understand the terms: •oxidation •reduction •redox •oxidising agent •reducing agent in terms of gain or loss of oxygen and loss or gain of electrons.",
      "subsection": "4CH1-S2-d"
    },
    {
      "line": 95,
      "officialCode": "2.21",
      "code": "4CH1-2.21",
      "wording": "practical: investigate reactions between dilute hydrochloric and sulfuric acids and metals(e.g. magnesium, zinc and iron)",
      "subsection": "4CH1-S2-d"
    }
  ],
