  "specMarkers": [
    {
      "line": 10,
      "officialCode": "2.44",
      "code": "4CH1-2.44",
      "wording": "describe tests for these gases: · hydrogen · oxygen · carbon dioxide · ammonia · chlorine.",
      "subsection": "4CH1-S2-h"
    },
    {
      "line": 37,
      "officialCode": "2.45",
      "code": "4CH1-2.45",
      "wording": "describe how to carry out a flame test",
      "subsection": "4CH1-S2-h"
    },
    {
      "line": 40,
      "officialCode": "2.46",
      "code": "4CH1-2.46",
      "wording": "know the colours formed in flame tests for these cations: · Li$^{+}$ is red · Na$^{+}$ is yellow · K$^{+}$ is lilac · Ca$^{2+}$ is orange-red · Cu$^{2+}$ is blue-green.",
      "subsection": "4CH1-S2-h"
    },
    {
      "line": 48,
      "officialCode": "2.47",
      "code": "4CH1-2.47",
      "wording": "describe tests for these cations: · NH$_{4}^{+}$ using sodium hydroxide solution and identifying the gas evolved · Cu$^{2+}$, Fe$^{2+}$ and Fe$^{3+}$ using sodium hydroxide solution.",
      "subsection": "4CH1-S2-h"
    },
    {
      "line": 59,
      "officialCode": "2.48",
      "code": "4CH1-2.48",
      "wording": "describe tests for these anions: · Cl$^{-}$, Br$^{-}$ and I$^{-}$ using acidified silver nitrate solution · SO$_{4}^{2-}$ using acidified barium chloride solution · CO$_{3}^{2-}$ using hydrochloric acid and identifying the gas evolved.",
      "subsection": "4CH1-S2-h"
    },
    {
      "line": 83,
      "officialCode": "2.49",
      "code": "4CH1-2.49",
      "wording": "describe a test for the presence of water using anhydrous copper(II) sulfate",
      "subsection": "4CH1-S2-h"
    },
    {
      "line": 87,
      "officialCode": "2.50",
      "code": "4CH1-2.50",
      "wording": "describe a physical test to show whether a sample of water is pure",
      "subsection": "4CH1-S2-h"
    }
  ],
