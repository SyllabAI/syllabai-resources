  "specMarkers": [
    {
      "line": 10,
      "officialCode": "2.22C",
      "code": "4CH1-2.22C",
      "wording": "know that most metals are extracted from ores found in the Earth's crust and that unreactive metals are often found as the uncombined element",
      "subsection": "4CH1-S2-e"
    },
    {
      "line": 16,
      "officialCode": "2.23C",
      "code": "4CH1-2.23C",
      "wording": "explain how the method of extraction of a metal is related to its position in the reactivity series, illustrated by carbon extraction for iron and electrolysis for aluminium",
      "subsection": "4CH1-S2-e"
    },
    {
      "line": 44,
      "officialCode": "2.24C",
      "code": "4CH1-2.24C",
      "wording": "be able to comment on a metal extraction process, given appropriate information detailed knowledge of the processes used in the extraction of a specific metal is not required",
      "subsection": "4CH1-S2-e"
    },
    {
      "line": 62,
      "officialCode": "2.25C",
      "code": "4CH1-2.25C",
      "wording": "explain the uses of aluminium, copper, iron and steel in terms of their properties the types of steel will be limited to low-carbon (mild), high-carbon and stainless",
      "subsection": "4CH1-S2-e"
    },
    {
      "line": 75,
      "officialCode": "2.26C",
      "code": "4CH1-2.26C",
      "wording": "know that an alloy is a mixture of a metal and one or more elements, usually other metals or carbon",
      "subsection": "4CH1-S2-e"
    },
    {
      "line": 90,
      "officialCode": "2.27C",
      "code": "4CH1-2.27C",
      "wording": "explain why alloys are harder than pure metals",
      "subsection": "4CH1-S2-e"
    }
  ],
