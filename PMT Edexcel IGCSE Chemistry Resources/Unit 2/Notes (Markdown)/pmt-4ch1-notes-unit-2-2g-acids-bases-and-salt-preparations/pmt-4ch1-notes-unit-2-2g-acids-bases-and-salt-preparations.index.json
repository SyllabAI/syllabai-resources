    {
      "line": 10,
      "officialCode": "2.34",
      "code": "4CH1-2.34",
      "wording": "know the general rules for predicting the solubility of ionic compounds in water: • common sodium, potassium and ammonium compounds are soluble • all nitrates are soluble • common chlorides are soluble, except those of silver and lead(II) • common sulfates are soluble, except for those of barium, calcium and lead(II) • common carbonates are insoluble, except for those of sodium, potassium and ammonium • common hydroxides are insoluble except for those of sodium, potassium and calcium(calcium hydroxide is slightly soluble).",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 22,
      "officialCode": "2.35",
      "code": "4CH1-2.35",
      "wording": "understand acids and bases in terms of proton transfer",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 27,
      "officialCode": "2.36",
      "code": "4CH1-2.36",
      "wording": "understand that an acid is a proton donor and a base is a proton acceptor",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 32,
      "officialCode": "2.37",
      "code": "4CH1-2.37",
      "wording": "describe the reactions of hydrochloric acid, sulfuric acid and nitric acid with metals, bases and metal carbonates(excluding the reactions between nitric acid and metals) to form salts",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 58,
      "officialCode": "2.38",
      "code": "4CH1-2.38",
      "wording": "know that metal oxides, metal hydroxides and ammonia can act as bases,and that alkalis are bases that are soluble in water",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 64,
      "officialCode": "2.39",
      "code": "4CH1-2.39",
      "wording": "describe an experiment to prepare a pure,dry sample of a soluble salt,starting from an insoluble reactant",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 72,
      "officialCode": "2.40C",
      "code": "4CH1-2.40C",
      "wording": "describe an experiment to prepare a pure,dry sample of a soluble salt,starting from an acid and alkali",
      "subsection": "4CH1-S2-g"
    },
    {
      "line": 80,
      "officialCode": "2.41C",
      "code": "4CH1-2.41C",
      "wording": "describe an experiment to prepare a pure,dry sample of an insoluble salt,starting from two soluble reactants",
      "subsection": "4CH1-S2-g"
