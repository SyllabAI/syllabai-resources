    {
      "line": 26,
      "officialCode": "1.58C",
      "code": "4CH1-1.58C",
      "wording": "describe experiments to investigate electrolysis, using inert electrodes, of molten compounds (including lead(II) bromide) and aqueous solutions (including sodium chloride, dilute sulfuric acid and copper(II) sulfate) and to predict the products",
