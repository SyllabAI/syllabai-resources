  "specMarkers": [
    {
      "line": 12,
      "officialCode": "1.25",
      "code": "4CH1-1.25",
      "wording": "write word equations and balanced chemical equations(including state symbols):for reactions studied in this specificationfor unfamiliar reactions where suitable information is provided.",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 22,
      "officialCode": "1.26",
      "code": "4CH1-1.26",
      "wording": "calculate relative formula masses(including relative molecular masses) $ (M_{r}) $ from relative atomic masses $ (A_{r}) $",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 31,
      "officialCode": "1.27",
      "code": "4CH1-1.27",
      "wording": "know that the mole(mol) is the unit for the amount of a substance",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 43,
      "officialCode": "1.28",
      "code": "4CH1-1.28",
      "wording": "understand how to carry out calculations involving amount of substance, relative atomic mass $ (A_{r}) $ and relative formula mass $ (M_{r}) $",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 58,
      "officialCode": "1.29",
      "code": "4CH1-1.29",
      "wording": "calculate reacting masses using experimental data and chemical equations",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 71,
      "officialCode": "1.30",
      "code": "4CH1-1.30",
      "wording": "calculate percentage yield",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 89,
      "officialCode": "1.31",
      "code": "4CH1-1.31",
      "wording": "understand how the formulae of simple compounds can be obtained experimentally, including metal oxides, water and salts containing water of crystallisation",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 112,
      "officialCode": "1.32",
      "code": "4CH1-1.32",
      "wording": "know what is meant by the terms empirical formula and molecular formula",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 117,
      "officialCode": "1.33",
      "code": "4CH1-1.33",
      "wording": "calculate empirical and molecular formulae from experimental data",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 134,
      "officialCode": "1.34C",
      "code": "4CH1-1.34C",
      "wording": "understand how to carry out calculations involving amount of substance, volume and concentration(in mol/dm3)of solution",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 145,
      "officialCode": "1.35C",
      "code": "4CH1-1.35C",
      "wording": "understand how to carry out calculations involving gas volumes and the molar volume of a gas(24dm3and24000cm3at room temperature and pressure(rtp))",
      "subsection": "4CH1-S1-e"
    },
    {
      "line": 159,
      "officialCode": "1.36",
      "code": "4CH1-1.36",
      "wording": "practical:know how to determine the formula of a metal oxide by combustion(e.g.magnesium oxide)or by reduction(e.g.copper(II)oxide)",
      "subsection": "4CH1-S1-e"
    }
