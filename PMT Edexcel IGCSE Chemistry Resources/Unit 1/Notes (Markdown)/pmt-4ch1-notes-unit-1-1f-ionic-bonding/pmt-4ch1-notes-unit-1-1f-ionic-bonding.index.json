  "specMarkers": [
    {
      "line": 10,
      "officialCode": "1.37",
      "code": "4CH1-1.37",
      "wording": "understand how ions are formed by electron loss or gain",
      "subsection": "4CH1-S1-f"
    },
    {
      "line": 23,
      "officialCode": "1.38",
      "code": "4CH1-1.38",
      "wording": "know the charges of these ions: •metals in Groups 1,2 and 3 •non-metals in Groups 5,6 and 7 •Ag+，Cu2+，Fe2+，Fe3+，Pb2+，Zn2+ •hydrogen（H+），hydroxide（OH-），ammonium（NH4+），carbonate（CO32-），nitrate（NO3-），sulfate（SO42-）",
      "subsection": "4CH1-S1-f"
    },
    {
      "line": 39,
      "officialCode": "1.39",
      "code": "4CH1-1.39",
      "wording": "write formulae for compounds formed between the ions listed above",
      "subsection": "4CH1-S1-f"
    },
    {
      "line": 43,
      "officialCode": "1.40",
      "code": "4CH1-1.40",
      "wording": "draw dot-and-cross diagrams to show the formation of ionic compounds by electron transfer，limited to combinations of elements from Groups1，2，3和5，6，7only outer electrons need be shown",
      "subsection": "4CH1-S1-f"
    },
    {
      "line": 59,
      "officialCode": "1.41",
      "code": "4CH1-1.41",
      "wording": "understand ionic bonding in terms of electrostatic attractions",
      "subsection": "4CH1-S1-f"
    },
    {
      "line": 72,
      "officialCode": "1.42",
      "code": "4CH1-1.42",
      "wording": "understand why compounds with giant ionic lattices have high melting and boiling points",
      "subsection": "4CH1-S1-f"
    },
    {
      "line": 79,
      "officialCode": "1.43",
      "code": "4CH1-1.43",
      "wording": "know that ionic compounds do not conduct electricity when solid，but do conduct electricity when molten and in aqueous solution",
      "subsection": "4CH1-S1-f"
    }
  ],
