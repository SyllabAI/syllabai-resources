  "specMarkers": [
    {
      "line": 10,
      "officialCode": "4.7",
      "code": "4CH1-4.7",
      "wording": "know that crude oil is a mixture of hydrocarbons",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 19,
      "officialCode": "4.8",
      "code": "4CH1-4.8",
      "wording": "describe how the industrial process of fractional distillation separates crude oil into fractions",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 28,
      "officialCode": "4.9",
      "code": "4CH1-4.9",
      "wording": "know the names and uses of the main fractions obtained from crude oil: refinery gases, gasoline, kerosene, diesel, fuel oil and bitumen",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 51,
      "officialCode": "4.10",
      "code": "4CH1-4.10",
      "wording": "know the trend in colour, boiling point and viscosity of the main fractions",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 60,
      "officialCode": "4.11",
      "code": "4CH1-4.11",
      "wording": "know that a fuel is a substance that, when burned, releases heat energy",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 63,
      "officialCode": "4.12",
      "code": "4CH1-4.12",
      "wording": "know the possible products of complete and incomplete combustion of hydrocarbons with oxygen in the air",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 73,
      "officialCode": "4.13",
      "code": "4CH1-4.13",
      "wording": "understand why carbon monoxide is poisonous, in terms of its effect on the capacity of blood to transport oxygen references to haemoglobin are not required",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 77,
      "officialCode": "4.14",
      "code": "4CH1-4.14",
      "wording": "know that, in car engines, the temperature reached is high enough to allow nitrogen and oxygen from air to react, forming oxides of nitrogen",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 82,
      "officialCode": "4.15",
      "code": "4CH1-4.15",
      "wording": "explain how the combustion of some impurities in hydrocarbon fuels results in the formation of sulfur dioxide",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 85,
      "officialCode": "4.16",
      "code": "4CH1-4.16",
      "wording": "understand how sulfur dioxide and oxides of nitrogen contribute to acid rain",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 94,
      "officialCode": "4.17",
      "code": "4CH1-4.17",
      "wording": "describe how long-chain alkanes are converted to alkenes and shorter-chain alkanes by catalytic cracking(using silica or alumina as the catalyst and a temperature in the range of 600-700℃)",
      "subsection": "4CH1-S4-b"
    },
    {
      "line": 105,
      "officialCode": "4.18",
      "code": "4CH1-4.18",
      "wording": "explain why cracking is necessary, in terms of the balance between supply and demand for different fractions",
      "subsection": "4CH1-S4-b"
    }
  ],
