  "specMarkers": [
    {
      "line": 10,
      "officialCode": "3.1",
      "code": "4CH1-3.1",
      "wording": "know that chemical reactions in which heat energy is given out are described as exothermic, and those in which heat energy is taken in are described as endothermic",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 27,
      "officialCode": "3.2",
      "code": "4CH1-3.2",
      "wording": "describe simple calorimetry experiments for reactions such as combustion, displacement, dissolving and neutralisation",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 36,
      "officialCode": "3.3",
      "code": "4CH1-3.3",
      "wording": "calculate the heat energy change from a measured temperature change using the expression $ Q=mc\\Delta T $",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 81,
      "officialCode": "3.4",
      "code": "4CH1-3.4",
      "wording": "calculate the molar enthalpy change ($\\Delta H$) from the heat energy change, $ Q $",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 89,
      "officialCode": "3.5C",
      "code": "4CH1-3.5C",
      "wording": "draw and explain energy level diagrams to represent exothermic and endothermic reactions",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 99,
      "officialCode": "3.6C",
      "code": "4CH1-3.6C",
      "wording": "know that bond-breaking is an endothermic process and that bond-making is an exothermic process",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 111,
      "officialCode": "3.7C",
      "code": "4CH1-3.7C",
      "wording": "use bond energies to calculate the enthalpy change during a chemical reaction",
      "subsection": "4CH1-S3-a"
    },
    {
      "line": 119,
      "officialCode": "3.8",
      "code": "4CH1-3.8",
      "wording": "practical: investigate temperature changes accompanying some of the following types of change: • salts dissolving in water • neutralisation reactions • displacement reactions • combustion reactions.",
      "subsection": "4CH1-S3-a"
    }
  ],
