  "specMarkers": [
    {
      "line": 10,
      "officialCode": "3.17",
      "code": "4CH1-3.17",
      "wording": "know that some reactions are reversible and this is indicated by the symbol $\\rightleftharpoons$ in equations",
      "subsection": "4CH1-S3-c"
    },
    {
      "line": 22,
      "officialCode": "3.18",
      "code": "4CH1-3.18",
      "wording": "describe reversible reactions such as the dehydration of hydrated copper(II) sulfate and the effect of heat on ammonium chloride",
      "subsection": "4CH1-S3-c"
    },
    {
      "line": 42,
      "officialCode": "3.19C",
      "code": "4CH1-3.19C",
      "wording": "know that a reversible reaction can reach dynamic equilibrium in a sealed container",
      "subsection": "4CH1-S3-c"
    },
    {
      "line": 46,
      "officialCode": "3.20C",
      "code": "4CH1-3.20C",
      "wording": "know that the characteristics of a reaction at dynamic equilibrium are: • the forward and reverse reactions occur at the same rate • the concentrations of reactants and products remain constant.",
      "subsection": "4CH1-S3-c"
    },
    {
      "line": 52,
      "officialCode": "3.21C",
      "code": "4CH1-3.21C",
      "wording": "understand why a catalyst does not affect the position of equilibrium in a reversible reaction",
      "subsection": "4CH1-S3-c"
    },
    {
      "line": 55,
      "officialCode": "3.22C",
      "code": "4CH1-3.22C",
      "wording": "know the effect of changing either temperature or pressure on the position of equilibrium in a reversible reaction: • an increase (or decrease) in temperature shifts the position of equilibrium in the direction of the endothermic (or exothermic) reaction • an increase (or decrease) in pressure shifts the position of equilibrium in the direction that produces fewer (or more) moles of gas References to Le Chatelier's principle are not required",
      "subsection": "4CH1-S3-c"
    }
  ],
