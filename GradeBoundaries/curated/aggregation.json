{
  "schema": "syllabai.grade-boundaries.aggregation/1",
  "purpose": "Cash-in STRUCTURE metadata (which units make a cash-in, and the board's A* aggregate rule). Structure is official Pearson documentation; every boundary VALUE still comes exclusively from the sha256-recorded grade-boundary documents in raw/.",
  "sources": [
    {
      "id": "pearson-ial-info-manual",
      "title": "Pearson Qualifications Information Manual 2025/26 \u2014 International Advanced A Level section (unit requirements per cash-in code)",
      "url": "https://qualifications.pearson.com/content/dam/pdf/Support/Information-manual/4-ial-2025-2026.pdf",
      "usedFor": "XMA01/YMA01/YFM01 unit compositions incl. the five allowed YMA01 applied pairs"
    },
    {
      "id": "pearson-ial-results-explained",
      "title": "Pearson \u2014 International Advanced Level results explained for students",
      "url": "https://qualifications.pearson.com/en/support/support-topics/results-certification/understanding-marks-and-grades/understanding-your-results-information-for-students/edexcel-international-advanced-level-results-explained.html",
      "usedFor": "A* rule: grade A overall AND at least 90% of the A2 UMS; Mathematics: 480 overall + at least 180/200 from P3+P4; six-unit IALs: 480 overall + at least 270/300 at A2; four-unit IALs: 320 + 180/200"
    },
    {
      "id": "pearson-ial-maths-aggregation-guidance",
      "title": "IAL 2018 Mathematics Aggregation Rules \u2014 Guidance for Centres (Rules 1-7: two-step grade/UMS maximisation, qualification-group unit locking, worked Examples; official AS/A2 designation: P1 P2 FP1 M1 S1 D1 are AS units, P3 P4 FP2 FP3 M2 M3 S2 S3 are A2 units)",
      "url": "https://qualifications.pearson.com/content/dam/pdf/International%20Advanced%20Level/Mathematics/2018/Teaching-and-Learning-Materials/aggregation-rules-and-guidance.pdf",
      "sha256_16": "61b32c5016644e74",
      "usedFor": "YFM01 multi-route eligibility + Rule 1 maximisation + unit locking + the AS/A2 designation behind a2[]"
    },
    {
      "id": "pearson-igcse-science-da-modular-spec",
      "title": "Pearson Edexcel International GCSE in Science (Double Award) (Modular) specification (2024), 'Qualification at a glance'",
      "url": "https://qualifications.pearson.com/content/dam/pdf/International%20GCSE/Science%20(Double%20Award)/2024/specification-and-sample-assessments/international-gcse-science-da-modular-specification.pdf",
      "usedFor": "4XSD1 = Biology Units 1-2 (4WSD1, 4WSD2) + Chemistry Units 3-4 (4WSD3, 4WSD4) + Physics Units 5-6 (4WSD5, 4WSD6); modular cash-ins are graded on aggregated UMS"
    },
    {
      "id": "pearson-igcse-modular-boundary-doc",
      "title": "Pearson International GCSE Modular grade-boundary documents (raw/pearson-int-gcse-modular) \u2014 'Maximum marks and grade boundaries for the overall qualification (the cash-in) are only shown in UMS marks'",
      "url": "https://qualifications.pearson.com/",
      "usedFor": "Modular cash-in grades are UMS-aggregated; unit raw marks convert to UMS through the unit's own published raw+UMS boundary pairs"
    }
  ],
