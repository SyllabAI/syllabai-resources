 "generalization_findings": [
  {
   "id": "F1",
   "series": "2019-06",
   "finding": "question start lines are indented (QSTART required leading-space tolerance)",
   "fix": "QSTART_RE allows leading whitespace"
  },
  {
   "id": "F2",
   "series": "2019-06",
   "finding": "8 rasterized (image-only) pages in archive PDF; 6 content pages lost: Q7 gone entirely (its footer too), Q1/Q11/Q12/Q15 partial",
   "fix": "image-only page census + defect attribution to questions + G1 REVIEW path (never silent, never invented)"
  },
  {
   "id": "F3",
   "series": "2019-06",
   "finding": "Q7 footer absent from PDF text layer",
   "fix": "footer census detects the gap; review item names the lost pages"
  },
  {
   "id": "F4",
   "series": "2019-06",
   "finding": "paper has 15 questions (early 4CH1 format), not 10",
   "fix": "per-series question-count registry; paper-level invariant kept at 110 marks"
  },
  {
   "id": "F5",
   "series": "2020-11 vs 2020-01",
   "finding": "MS note phrasing differs: 'is not correct' vs 'is incorrect'",
   "fix": "unified note filter covering both phrasings"
  },
  {
   "id": "F6",
   "series": "2020-01",
   "finding": "MS marker column drifts one row early in Q7(a): note rows leak into adjacent entries; naive keying would emit C for 7(a)(iii) where the printed notes prove A (astatine)",
   "fix": "answer-row analysis keyed only when exactly ONE distinct candidate; ambiguous entries -> human review"
  },
  {
   "id": "F7",
   "series": "2019-06",
   "finding": "MS sub-letters printed bare without parentheses ('b      they have...')",
   "fix": "MS_BARE_LETTER_RE with branch precedence over the catch-all row regex"
  },
  {
   "id": "F8",
   "series": "2019-06/2020-01",
   "finding": "three 'DO NOT WRITE IN THIS AREA' phrases share one extracted line",
   "fix": "phrase-level substitution instead of whole-line filter"
  },
  {
   "id": "F9",
   "series": "2019-06",
   "finding": "damaged Q1 region begins with a part marker '(c) ...' as line 0",
   "fix": "segment_question lets the loop classify line 0 instead of forcing it into the stem"
  },
  {
   "id": "F10",
   "series": "2020-01",
   "finding": "marker-only MS row carries a trailing marks digit ('(iii)   1') which glued to the answer",
   "fix": "strip leading marks digit only when followed by a choice letter"
  },
  {
   "id": "F11",
   "series": "2023-06",
   "finding": "MS continuation rows indented 11+ spaces; marker-row regex allowed only 10 — all roman parts after the first went unlinkable (G5 76%)",
   "fix": "MS_ROW_RE / MS_BARE_LETTER_RE indent allowance widened to 20"
  },
  {
   "id": "F12",
   "series": "2021-01 (and 2021+ MS style)",
   "finding": "MCQ keys phrased '<L> is the correct answer because...' plus '<L> is not THE correct answer because...' rebuttals — the inserted 'the' defeated the note filter, all four letters became candidates, guard refused every key",
   "fix": "positive-statement keying ('<L> is (the) correct' is authoritative) + note filter extended to 'is not the correct'"
  },
  {
   "id": "F13",
   "series": "2026-06",
   "finding": "manifest schema drift: series.printed / series.source / variant.official_code absent in gap-fill-wave manifests — converter crashed in G0 instead of flagging",
   "fix": "manifest reads use .get() with explicit 'absent in schema v2' annotation in G0 summary"
  },
  {
   "id": "F14",
   "series": "2023-06/2025-06/2025-11/2026-06",
   "finding": "rebuttal-style MCQ MS: explicit rebuttal for every wrong option ('A is incorrect...', 'B the charges are incorrect', 'B is X incorrect', '<L> (answer)' cells, glued 'B4' answer+digit cells) — single-candidate logic insufficient",
   "fix": "elimination keying: sole un-rebutted option keyed only when corroborated by exactly one answer row; anything ambiguous stays unkeyed (2020-01 canary still refuses)"
  }
 ],
